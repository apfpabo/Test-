func _on_dock() -> void:
    if dock.get_meta("port", -1) >= 0: open_port(Campaign.G.ports[dock.get_meta("port")])
    elif dock.get_meta("poi", -1) >= 0: open_survey(Campaign.G.pois[dock.get_meta("poi")])
    elif dock.get_meta("base", -1) >= 0: open_struct(Structures.all()[dock.get_meta("base")])

# ------------------------------------------------------------------ input
func _unhandled_input(e: InputEvent) -> void:
    if panel_open:
        if e is InputEventKey and e.pressed and e.keycode == KEY_ESCAPE and not _blocking:
            if not cur_port.is_empty(): cur_port = {}; Campaign.G.player.cool = maxf(Campaign.G.player.cool, 2.5); Campaign.save()   # Esc in port is "Put to sea"
            close_panel()
        return
    if e is InputEventKey and e.pressed and e.keycode == KEY_ESCAPE:
        if drawer_open(): close_drawer()
        else: _pause_menu()
        return
    if e is InputEventMouseButton:
        var mb = e as InputEventMouseButton
        if mb.button_index == MOUSE_BUTTON_WHEEL_UP and mb.pressed: _zoom_at(1.12, mb.position)
        elif mb.button_index == MOUSE_BUTTON_WHEEL_DOWN and mb.pressed: _zoom_at(1 / 1.12, mb.position)
        elif mb.button_index == MOUSE_BUTTON_RIGHT and mb.pressed: _context(mb.position)
        elif mb.button_index == MOUSE_BUTTON_LEFT:
            if mb.pressed: drag = {"at": mb.position, "cam": cam, "moved": false}
            else:
                if not drag.is_empty() and not drag.moved: _click(mb.position)
                drag = {}
    elif e is InputEventMouseMotion and not drag.is_empty():
        var d: Vector2 = e.position - drag.at
        if not drag.moved and d.length() < 6: return
        drag.moved = true; free_cam = true; cam = drag.cam - d / zoom
    elif e is InputEventKey and e.pressed and not e.echo:
        match e.keycode:
            KEY_SPACE: Campaign.paused = not Campaign.paused; _user_pause = Campaign.paused
            KEY_H:   # nothing on the screen but the chart, for recording (H again brings it back)
                ui.visible = not ui.visible
            KEY_R: Settings.sensors = not Settings.sensors; Settings.save(); _toast("Sensor ranges " + ("shown: how far you see, and how far off you are found." if Settings.sensors else "hidden.") + " (R)")
            KEY_Q, KEY_E:   # the telegraph: Q slower, E faster
                var i: int = Campaign.SPEED_ORDER.find(Campaign.speed_order()) + (1 if e.keycode == KEY_E else -1)
                _set_speed(Campaign.SPEED_ORDER[clampi(i, 0, Campaign.SPEED_ORDER.size() - 1)])
            KEY_1: _speed(1)
            KEY_2: _speed(2)
            KEY_3: _speed(4)
            KEY_4: _speed(8)
            KEY_C, KEY_HOME: free_cam = false
            KEY_EQUAL, KEY_KP_ADD: zoom = clampf(zoom * 1.25, 0.14, 14)
            KEY_MINUS, KEY_KP_SUBTRACT:
                if zoom <= 0.1401: globe.open()   # out past the widest view: the world whole
                zoom = clampf(zoom / 1.25, 0.14, 14)

func _zoom_at(f: float, sp: Vector2) -> void:
    if f < 1.0 and zoom <= 0.1401: globe.open(); return   # out past the widest view: the world whole
    var before = to_world(sp); zoom = clampf(zoom * f, 0.14, 14)
    if free_cam: cam += before - to_world(sp)

func _click(sp: Vector2) -> void:
    var G: Dictionary = Campaign.G; var P: Dictionary = G.player; var w = to_world(sp); w.x = Campaign.wrap_x(w.x)
    var near = func(x: float, y: float, r: float) -> bool: return Campaign.mdist(x, y, w.x, w.y) < r / zoom   # r in screen pixels
    if P.get("towed") != null: _toast("You are under tow. Right-click to cast off the tow."); return
    if Campaign.dead_in_water(): _toast("Your squadron is dead in the water: no fuel, no reserve. Send a distress call (the red button), or right-click the sea to call a merchant convoy for fuel.")
    if Input.is_key_pressed(KEY_CTRL) and P.get("route") != null and P.get("follow") == null and P.get("escort") == null:   # another waypoint
        var tp = null
        for p in G.ports: if near.call(p.x, p.y, 14) or near.call(p.sx, p.sy, 10): tp = p
        var at: Vector2 = Vector2(tp.sx, tp.sy) if tp != null else Vector2(w.x, clampf(w.y, 4, Campaign.MH - 4))
        if tp == null and Campaign.on_land(at.x, at.y): _toast("That is land. Pick a point on the water."); return
        if Campaign.add_waypoint(P, at.x, at.y): P.destPort = tp.id if tp != null else null; Campaign.paused = false
        else: _toast("No sea route to that point.")
        return
    P.destPort = null; P.follow = null; P.escort = null; Campaign.paused = false
    var hit = fleet_at(w)
    for f in ([hit] if hit != null else []):
        if f.fac == "player": _toast("Your own ships: the %s." % f.name.trim_prefix("Your ")); return
        P.follow = f.id; P.repathT = 0.0; f.cool = 0.0; _toast("Intercept course locked on the " + Campaign.fname(f) + ". You will close and make contact."); return
    for p in G.ports:
        if near.call(p.x, p.y, 14) or near.call(p.sx, p.sy, 10):
            if Campaign.mdist(p.sx, p.sy, P.x, P.y) < 28: open_port(p); return
            P.destPort = p.id
            if not Campaign.set_course(P, p.sx, p.sy): P.tx = null; _toast("No sea route to " + p.name + ".")
            return
    for q in G.pois:
        if near.call(q.x, q.y, 12):
            if Campaign.mdist(q.x, q.y, P.x, P.y) < 22: open_survey(q); return
            Campaign.set_course(P, q.x, q.y); return
    if zoom >= 0.3:
        var st = Structures.at_point(w.x, w.y, maxf(10.0 / zoom, struct_r(Structures.at_point(w.x, w.y, 40.0)) if zoom >= 3.0 else 0.0))
        if st != null and (st.fac == "player" or zoom >= (0.3 if Structures.kind(st).military else 0.45)): open_struct(st); return
    if Campaign.on_land(w.x, w.y): _toast("That is land. Pick a point on the water."); return
    if not Campaign.set_course(P, w.x, clampf(w.y, 4, Campaign.MH - 4)): P.tx = null; _toast("No sea route to that point.")

## Right-click on a fleet: orders for it. Friendly fleets: escort, close and hail, cancel; hostile ones: intercept.
var _menu: PopupMenu
func _context(sp: Vector2) -> void:
    var G: Dictionary = Campaign.G; var P: Dictionary = G.player; var w = to_world(sp); var hit = null
    hit = fleet_at(Vector2(Campaign.wrap_x(w.x), w.y))
    if _menu == null:
        _menu = PopupMenu.new(); _menu.add_theme_font_size_override("font_size", 14); ui.add_child(_menu)
        _menu.id_pressed.connect(_context_pick)
    _menu.clear()
    var busy: bool = P.get("towed") != null or P.get("escort") != null or P.get("follow") != null or P.get("route") != null
    if hit != null:
        _menu.set_meta("fleet", int(hit.id))
        _menu.add_separator(hit.name + " (%d)" % hit.ships.size())
        if hit.fac == "player":   # your own: the main body can be called in, the rest only looked at
            if hit.get("body", false): _menu.add_item("Signal her to rejoin" if not hit.get("join", false) else "Rejoining when in company ✓", 9)
        elif Campaign.hostile_fleet(hit): _menu.add_item("Intercept", 2)
        else:
            _menu.add_item("Escort her" if P.get("escort") != int(hit.id) else "Escorting her (keep station)", 1)
            _menu.set_item_disabled(_menu.get_item_index(1), P.get("escort") == int(hit.id))
            _menu.add_item("Close and hail", 2)
            var dP: float = Campaign.mdist(hit.x, hit.y, P.x, P.y)
            if dP < Campaign.CONTACT * 1.5: _menu.add_item("Hail her now (signals)", 5)
            else: _menu.add_item("Call her by wireless (%d km)" % int(dP * Campaign.KM_PER_UNIT), 4); _menu.set_item_disabled(_menu.get_item_index(4), dP > Campaign.WIRELESS)
    else:   # open sea: a call on the wireless to whoever is nearest, seen or not
        _menu.add_separator("Wireless")
        var ws = Campaign.nearest_caller(false); var ms = Campaign.nearest_caller(true)
        _menu.add_item("Call the nearest friendly warship" + ((" (%d km)" % int(Campaign.mdist(ws.x, ws.y, P.x, P.y) * Campaign.KM_PER_UNIT)) if ws != null else " (none in range)"), 7); _menu.set_item_disabled(_menu.get_item_index(7), ws == null or Campaign.dark())
        _menu.add_item("Call the nearest merchant convoy" + ((" (%d km)" % int(Campaign.mdist(ms.x, ms.y, P.x, P.y) * Campaign.KM_PER_UNIT)) if ms != null else " (none in range)"), 8); _menu.set_item_disabled(_menu.get_item_index(8), ms == null or Campaign.dark())
    if P.get("towed") != null: _menu.add_item("Cast off the tow", 6)
    _menu.add_item("Cancel orders (heave to)", 3)
    _menu.set_item_disabled(_menu.get_item_index(3), not busy)
    _menu.position = Vector2i(sp)
    _menu.reset_size(); _menu.popup()

func _context_pick(id: int) -> void:
    var G: Dictionary = Campaign.G; var P: Dictionary = G.player; var f = Campaign._fleet(_menu.get_meta("fleet", -1))
    match id:
        1:
            if f == null: return
            P.follow = null; P.destPort = null; P.escort = int(f.id); P.repathT = 0.0; free_cam = false; Campaign.paused = false
            _toast("You take station astern of the %s and keep with her." % Campaign.fname(f))
        2:
            if f == null: return
            P.escort = null; P.destPort = null; P.follow = int(f.id); P.repathT = 0.0; f.cool = 0.0; Campaign.paused = false
            _toast(("Intercept course locked on the %s." if Campaign.hostile_fleet(f) else "Closing the %s to signalling distance.") % Campaign.fname(f))
        3:
            if P.get("towed") != null: _context_pick(6)
            P.escort = null; P.follow = null; P.destPort = null; P.route = null; P.tx = null
            _toast("Orders cancelled. The squadron heaves to.")
        4: if f != null: _toast(Campaign.call_fleet(f))
        5:
            if f != null and f.get("vis", true) and Campaign.mdist(f.x, f.y, P.x, P.y) < Campaign.CONTACT * 1.5: _hail(f)
            elif f != null: _toast("She has passed out of signalling distance.")
        9: if f != null and f.get("body", false): f.join = true; _toast("The main body is signalled to rejoin when in company.")
        7, 8:
            var c = Campaign.nearest_caller(id == 8)
            if c != null: _toast(Campaign.call_fleet(c))
        6:
            var tf = Campaign._fleet(P.towed); P.towed = null; P.route = null; P.tx = null; P.destPort = null
            if tf != null: tf.cool = 20.0
            _toast("You cast off the tow. The fee is not returned.")

## The fleet under a chart point: within 16 pixels or about its drawn size, whichever is larger; the nearest wins.
func fleet_at(w: Vector2):
    var best = null; var bd := INF
    for f in Campaign.G.fleets:
        if not f.get("vis", true): continue   # you cannot point at what you cannot see
        var d := Campaign.mdist(f.x, f.y, Campaign.wrap_x(w.x), w.y)
        var r: float = maxf(16.0 / zoom, marks._layout(f.ships)[0][3] * 0.55 if zoom >= 0.32 else 0.0)
        if d < r and d < bd: bd = d; best = f
    return best

# ------------------------------------------------------------------ panels
var _blocking = false   # a panel that must be answered (an encounter or an aftermath)
var cur_panel: Control

## `key` names what the panel shows (a port and tab, a Command tab): redrawn with the same key, it keeps its scroll
## position, so pressing a button far down a long list doesn't throw you back to the top.
var _panel_key := ""
var _panel_scroll: ScrollContainer
func open_panel(build: Callable, blocking := false, width := 760.0, key := "") -> VBoxContainer:
    var keep := 0
    if key != "" and key == _panel_key and is_instance_valid(_panel_scroll): keep = _panel_scroll.scroll_vertical
    # a fresh panel fades and settles in; a new page in an open panel fades in; a redraw of the same page doesn't
    var fresh: bool = not panel_open
    var new_page: bool = key == "" or key != _panel_key
    _panel_key = key
    if fresh or new_page: Sfx.cue("paper", 0.5)   # a page turned
    _clear_panel(); panel_open = true; _blocking = blocking; Campaign.paused = true
    var shade = ColorRect.new(); shade.color = Color(0.016, 0.047, 0.063, 0.6); shade.set_anchors_preset(Control.PRESET_FULL_RECT); panel_layer.add_child(shade); shade.mouse_filter = Control.MOUSE_FILTER_STOP
    var center = CenterContainer.new(); center.set_anchors_preset(Control.PRESET_FULL_RECT); shade.add_child(center)
    var pc = PanelContainer.new(); pc.custom_minimum_size = Vector2(width, 0); center.add_child(pc)
    var scroll = ScrollContainer.new(); scroll.custom_minimum_size = Vector2(width - 44, 0); scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED; pc.add_child(scroll)
    var box = VBoxContainer.new(); box.size_flags_horizontal = Control.SIZE_EXPAND_FILL; box.add_theme_constant_override("separation", 8); scroll.add_child(box)
    cur_panel = shade; _panel_scroll = scroll
    build.call(box)
    if fresh:
        shade.modulate.a = 0.0; pc.modulate.a = 0.0; pc.scale = Vector2(0.97, 0.97)
        pc.resized.connect(func(): pc.pivot_offset = pc.size / 2, CONNECT_ONE_SHOT)
        var tw := create_tween().set_parallel(true)
        tw.tween_property(shade, "modulate:a", 1.0, 0.16)
        tw.tween_property(pc, "modulate:a", 1.0, 0.2).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
        tw.tween_property(pc, "scale", Vector2.ONE, 0.2).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
    elif new_page:
        box.modulate.a = 0.0
        create_tween().tween_property(box, "modulate:a", 1.0, 0.18).set_ease(Tween.EASE_OUT)
    _fit_panel.call_deferred(scroll, box, keep)
    return box

## Panels grow with their contents up to the screen height, then scroll.
func _fit_panel(scroll: ScrollContainer, box: Control, keep := 0) -> void:
    if not is_instance_valid(scroll): return
    scroll.custom_minimum_size.y = minf(box.get_combined_minimum_size().y + 4, get_viewport_rect().size.y - 140)
    if keep > 0:
        await get_tree().process_frame
        if is_instance_valid(scroll): scroll.scroll_vertical = keep

## Esc on the chart: the game stops while this is open. Like the battle's pause menu.
func _pause_menu() -> void:
    open_panel(func(box):
        box.add_child(UI.title("Paused"))
        _p(box, Campaign.date_str(Campaign.G.day) + " · Esc to resume", UI.DIM, 14)
        box.add_child(UI.button("Resume", close_panel, true))
        box.add_child(UI.button("Command", func(): show_command()))
        box.add_child(UI.button("Codex", func(): cmd_tab = "codex"; show_command()))
        box.add_child(UI.button("Settings", func(): _pause_settings()))
        var snd := UI.button("Sound: off (click to turn on)" if Sfx.muted else "Sound: on (click to mute)", func(): pass)
        snd.pressed.connect(func(): Sfx.muted = not Sfx.muted; snd.text = "Sound: off (click to turn on)" if Sfx.muted else "Sound: on (click to mute)")
        box.add_child(snd)
        box.add_child(UI.button("Save & exit to title", func(): Campaign.save(); get_tree().change_scene_to_file("res://scenes/main_menu.tscn")))
        box.add_child(UI.button("Save & quit to desktop", func(): Campaign.save(); get_tree().quit()))
    , false, 420)

func _pause_settings() -> void:
    open_panel(func(box):
        box.add_child(Settings.panel())
        box.add_child(UI.button("Back", _pause_menu, true))
    , false, 640)

var _user_pause := false   # you paused the clock yourself (Space or the pause button): closing a panel does not start it
func close_panel() -> void:
    # the panel fades away; it takes no more clicks while it does
    for c in panel_layer.get_children():
        if c.has_meta("closing"): continue
        c.set_meta("closing", true); c.propagate_call("set_mouse_filter", [Control.MOUSE_FILTER_IGNORE])
        var tw := create_tween(); tw.tween_property(c, "modulate:a", 0.0, 0.14).set_ease(Tween.EASE_IN); tw.tween_callback(c.queue_free)
    panel_open = false; _blocking = false; Campaign.paused = _user_pause   # a clock you stopped yourself stays stopped

## Clears the panel at once (when another replaces it).
func _clear_panel() -> void:
    for c in panel_layer.get_children(): c.queue_free()
    panel_open = false; _blocking = false; Campaign.paused = false

func _p(box: Control, text: String, col := UI.INK, size := 15) -> void:
    var l = UI.label(text, col, size, true); l.size_flags_horizontal = Control.SIZE_EXPAND_FILL; box.add_child(l)

func _counts(ships: Array) -> String:
    var counts = {}; var order = []
    for s in ships:
        var h: Dictionary = GameData.hulls[s.type]; var k: String = h.dn + "-class " + h.name.to_lower()
        if not counts.has(k): counts[k] = 0; order.append(k)
        counts[k] += 1
    return ", ".join(order.map(func(k): return "%d× %s" % [counts[k], k]))

func _on_encounter(f: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var P: Dictionary = G.player; P.tx = null; P.route = null; P.follow = null
    var ratio = Campaign.strength(f.ships) / maxf(1.0, Campaign.strength(G.fleet))
    var odds = "They badly outgun you." if ratio > 1.6 else ("They have the heavier squadron." if ratio > 1.1 else ("It would be an even fight." if ratio > 0.75 else "You outgun them."))
    var evade = int(round(clampf(0.4 + (Campaign.fleet_map_speed(G.fleet) - Campaign.fleet_map_speed(f.ships)) / 40.0 + float(Campaign.perk("evade", 0)) / 100.0, 0.1, 0.92) * 100))
    open_panel(func(box):
        if not Campaign.hostile_fleet(f):
            _hail_body(box, f)
        else:
            var who: String = ("Your mission target, " + f.name + ",") if f.get("mission", false) else ("The flotilla you were hired to hunt" if int(f.get("contract", 0)) > 0 else (("%s's squadron, worth %s," % [f.captain, Campaign.fmt(f.reward)]) if f.kind == "bounty" else "A " + GameData.fac[f.fac].name + " force"))
            box.add_child(UI.title("Contact")); box.add_child(_lead_pic(f)); _p(box, "%s is closing on you: %s." % [who, _counts(f.ships)]); _p(box, _contact_line(f), UI.DIM); _p(box, odds, UI.DIM)
            _commit_rows(box, f)
            box.add_child(UI.row([UI.button("Battle stations", func(): _battle(f), true),
                UI.button("Break off (%d%%)" % evade, func():
                    if randf() * 100 < evade: f.cool = 7.0; P.cool = 4.0; close_panel(); _toast("You turn away under a smoke screen and open the range.")
                    else: open_panel(func(b2): b2.add_child(UI.title("No escape")); _p(b2, "Their lookouts have you, and they hold the faster ships. You will have to fight."); b2.add_child(UI.button("Battle stations", func(): _battle(f), true)), true))]))
    , true)

func _toggle_commit(s: Dictionary, f: Dictionary) -> void:
    s.reserve = not s.get("reserve", false)
    if Campaign.G.fleet.all(func(x): return x.get("reserve", false)): s.reserve = false   # somebody has to fight
    _on_encounter(f)

## On the contact panel: which of your ships will fight and which stand off in reserve, changed with a click.
func _commit_rows(box: Control, f: Dictionary) -> void:
    var G: Dictionary = Campaign.G
    if G.fleet.size() < 2: return
    box.add_child(UI.label("YOUR SHIPS · CLICK TO COMMIT OR HOLD IN RESERVE", UI.DIM, 12))
    var row := HFlowContainer.new(); row.add_theme_constant_override("h_separation", 6); row.add_theme_constant_override("v_separation", 6); box.add_child(row)
    for s in G.fleet:
        var res: bool = s.get("reserve", false)
        var b := UI.button("%s%s" % [s.name, " · reserve" if res else ""], func(): _toggle_commit(s, f), not res)
        b.tooltip_text = "%s, hull %d%%, readiness %d%%, magazines %d%%" % [Campaign.hull(s).name, int(float(s.hullFrac) * 100), int(Campaign.readiness(s) * 100), int(float(s.get("ammo", 1.0)) * 100)]
        row.add_child(b)
    _p(box, "Ships in reserve stand off: they take no part and no damage.", UI.DIM, 12)

## Where the contact was made and whose reach made it: lookouts and radar, missiles, or a carrier's search planes.
## Hailing a fleet that does not fire on you (alongside, or come to your wireless call): pass on, trade with a
## merchant convoy, ask a warship for a tow when your bunkers are dry, or open fire.
func _hail(f: Dictionary) -> void:
    open_panel(func(box): _hail_body(box, f), true)

func _hail_body(box: Control, f: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var P: Dictionary = G.player; f.answering = false
    var en = Campaign.enemies_of(f.fac)
    var ratio = Campaign.strength(f.ships) / maxf(1.0, Campaign.strength(G.fleet))
    var odds = "They badly outgun you." if ratio > 1.6 else ("They have the heavier squadron." if ratio > 1.1 else ("It would be an even fight." if ratio > 0.75 else "You outgun them."))
    box.add_child(UI.title(f.name)); box.add_child(_lead_pic(f)); _p(box, "%s ships close to signalling distance: %s." % [GameData.fac[f.fac].name, _counts(f.ships)])
    var merchant: bool = f.kind == "convoy" or f.ships.all(func(s): return Campaign.hull(s).kind == "merchant")
    var dry: bool = G.cargo.fuel <= 0 or int(G.crew) <= 0
    var acts := [UI.button("Exchange signals and pass", func(): f.cool = 8.0; P.cool = 3.0; close_panel(), true)]
    if merchant: acts.append(UI.button("Trade", func(): _trade(f)))
    if not merchant and dry:
        var fee := Campaign.tow_fee(f.fac); var np = Campaign.nearest_open_port()
        var tow_l: String = "Request a tow to %s · %s" % [np.name if np != null else "port", Campaign.fmt(fee)] if G.credits >= fee else "Ask for a tow to %s (you cannot pay)" % (np.name if np != null else "port")
        acts.append(UI.button(tow_l, func(): f.cool = 8.0; _toast(Campaign.take_tow(f)); close_panel(), false, np == null))
    if merchant: _p(box, "Merchant ships carry spare bunker fuel and a little of everything, and will deal at sea, at worse prices than a port.", UI.DIM, 14)
    elif dry: _p(box, ("You have no crew to raise steam." if int(G.crew) <= 0 else "Your bunkers are dry.") + " A warship can take you in tow to the nearest harbour open to you, for a fee; if you cannot pay, she will still tow you, but her flag will remember it.", UI.GOLD, 14)
    _p(box, odds + " Opening fire breaks the armistice: it costs 30 %s standing%s, and %s warships will engage you on sight for three months." % [GameData.fac[f.fac].short, (" and earns thanks from " + " and ".join(en.map(func(e): return GameData.fac[e].short))) if en.size() else "", GameData.fac[f.fac].short], UI.DIM, 13)
    acts.append(UI.button("Open fire", func():
        G.rep[f.fac] -= 30; Campaign.incident(f.fac); Diplomacy.on_open_fire(f.fac)
        for e in en: G.rep[e] = mini(100, G.rep[e] + 5)
        Campaign.rep_note("Opened fire under the armistice")
        _toast("%s standing is now %d." % [GameData.fac[f.fac].name, G.rep[f.fac]]); _battle(f)))
    box.add_child(UI.row(acts))

## Trading with a merchant convoy at sea: a small floating market. What they carry, their own cash, and prices a
## third worse than a port's either way.
func _trade(f: Dictionary) -> void:
    var G: Dictionary = Campaign.G
    if not f.has("cash"): f.cash = 12000
    open_panel(func(box):
        box.add_child(UI.title("Trade with the " + f.name))
        _p(box, "Funds %s · Hold %d / %d · Bunkers %d / %d · Their cash %s" % [Campaign.fmt(G.credits), Campaign.cargo_used(), Campaign.cargo_cap(), int(G.cargo.fuel), Campaign.bunker_cap(), Campaign.fmt(int(f.cash))], UI.DIM, 14)
        for g in Campaign.C.GOODS:
            var gid: String = g.id; var have := int(f.cargo.get(gid, 0)); var held := int(floor(G.cargo[gid]))
            var bp := int(ceil(float(g.base) * 1.35)); var sp := int(floor(float(g.base) * 0.7))
            var room: int = Campaign.fuel_room() if gid == "fuel" else Campaign.cargo_cap() - Campaign.cargo_used()
            var can_buy := mini(mini(have, room), int(G.credits / bp)); var can_sell := mini(held, int(int(f.cash) / maxi(1, sp)))
            var nm := UI.label(g.name, UI.INK); nm.custom_minimum_size.x = 160
            box.add_child(UI.row([nm, UI.label("they have %d · buy %d · sell %d · you hold %d" % [have, bp, sp, held], UI.DIM, 13),
                UI.button("Buy %d" % mini(10, can_buy), func(): _deal(f, gid, mini(10, can_buy), bp, true), false, can_buy <= 0),
                UI.button("Buy max", func(): _deal(f, gid, can_buy, bp, true), false, can_buy <= 0),
                UI.button("Sell %d" % mini(10, can_sell), func(): _deal(f, gid, mini(10, can_sell), sp, false), false, can_sell <= 0)]))
        box.add_child(UI.row([UI.button("Done", func(): f.cool = 8.0; Campaign.G.player.cool = 3.0; close_panel(), true), UI.button("Back", func(): _hail(f))]))
    , true, 860)

func _deal(f: Dictionary, gid: String, n: int, price: int, buying: bool) -> void:
    var G: Dictionary = Campaign.G
    if n <= 0: return
    if buying: G.credits -= n * price; G.cargo[gid] += n; f.cargo[gid] = int(f.cargo.get(gid, 0)) - n; f.cash = int(f.cash) + n * price
    else: G.credits += n * price; G.cargo[gid] -= n; f.cargo[gid] = int(f.cargo.get(gid, 0)) + n; f.cash = int(f.cash) - n * price
    if gid == "fuel" and buying: G.deadWarned = false
    _trade(f)

func _contact_line(f: Dictionary) -> String: return _contact_range(f) + (" " + Campaign.refit_text(f.ships) if Campaign.refit_text(f.ships) != "" else "") + " They sail under a %s: their lookouts see %d%% as far as an average captain's; yours %d%%." % [Campaign.capt_text(f), int(round(Campaign.fleet_watch(f) / Campaign.watch(3) * 100)), int(round(Campaign.your_watch() / Campaign.watch(3) * 100))]
func _contact_range(f: Dictionary) -> String:
    var km := int(f.get("contactKm", 0)); var er := Campaign.strike_reach(f.ships); var pr := Campaign.strike_reach(Campaign.G.fleet)
    var by := func(r: float) -> String: return "search planes" if r * Campaign.KM_PER_UNIT >= 240.0 else "missile ships"
    if km <= int(Campaign.CONTACT * Campaign.KM_PER_UNIT) + 5: return "Contact at about %d km, on lookouts and radar." % km
    if er >= pr: return "Contact at about %d km: their %s found you first." % [km, by.call(er)]
    return "Contact at about %d km: your %s found them first." % [km, by.call(pr)]

func _battle(f: Dictionary) -> void:
    GameData.pending = Campaign.battle_setup(f)
    Campaign.paused = true
    get_tree().change_scene_to_file("res://scenes/battle.tscn")

## The opening of a campaign: who you were, what you have, and who wants what from you.
func _show_origin() -> void:
    var G: Dictionary = Campaign.G; var key: String = G.origin; var L: Dictionary = Origins.lore(key); var info: Dictionary = Origins.INFO[key]
    open_panel(func(box):
        box.add_child(UI.title(L.get("title", info.label)))
        if G.get("navy", "") != "" and info.navy: _p(box, "Formerly of the " + GameData.fac[G.navy].name + ".", UI.DIM, 14)
        _p(box, L.get("story", ""), UI.INK, 15)
        _p(box, L.get("world", ""), UI.DIM, 14)
        if Codex.backstory(key) != "": box.add_child(Codex.rich(Codex.backstory(key), UI.GOLD, 14))
        box.add_child(_thumb(G.fleet[0].type, "player", 520, G.fleet[0].fit))
        _p(box, info.start, UI.INK, 14)
        var st = []
        for f in G.rep:
            if f == "raiders" or G.rep[f] == 0: continue
            st.append("%s %s%d" % [GameData.fac[f].short, "+" if G.rep[f] > 0 else "", G.rep[f]])
        if st.size(): _p(box, "Standing: " + " · ".join(st), UI.DIM, 13)
        for h in Campaign.perk("hunted", []): _p(box, "Hunted: %s, for some %d days." % [h.name, int(h.days)], UI.RED, 13)
        box.add_child(UI.button("Put to sea", func(): close_panel(); Campaign.paused = false, true)), true)

func _show_aftermath(r: Dictionary) -> void:
    if Campaign.G.fleet.is_empty():
        open_panel(func(box):
            box.add_child(UI.title("Struck from the list")); _p(box, "Your last ship went down with her colours flying.")
            _p(box, "You lasted %d days, until %d, and sank or captured %d ships." % [Campaign.G.day, Campaign.year(), Campaign.G.kills], UI.DIM)
            DirAccess.remove_absolute(Campaign.SAVE_PATH)
            box.add_child(UI.button("New campaign", func(): get_tree().change_scene_to_file("res://scenes/main_menu.tscn"), true)), true)
        return
    open_panel(func(box):
        _banner(box, "victory" if r.victory else ("disengaged" if r.retreated else "defeat"))
        box.add_child(UI.title("Victory" if r.victory else ("Disengaged" if r.retreated else "Defeat")))
        var nm = func(list): return ", ".join(list.map(func(s): return "%s (%s)" % [s.name, GameData.hulls[s.type].name]))
        if r.sunk.size(): _p(box, "Sunk: " + nm.call(r.sunk))
        if r.lost.size(): _p(box, "Lost: " + nm.call(r.lost), Color(0.95, 0.75, 0.71))
        if r.casualties: _p(box, "%s sailors killed or wounded." % Campaign.fmt(r.casualties), UI.DIM)
        if r.coin: _p(box, "Prize money: %s%s." % [Campaign.fmt(r.coin), (", plus " + r.goods) if r.goods != "" else ""])
        if r.rp: _p(box, "Research: +%d RP from salvaged equipment and documents." % r.rp)
        var sv: Dictionary = r.get("salvage", {})
        if not sv.is_empty() and r.sunk.size():
            var got := []
            if int(sv.steel) > 0: got.append("%d tons of steel" % int(sv.steel))
            if int(sv.munitions) > 0: got.append("%d tons of munitions" % int(sv.munitions))
            if int(sv.fuel) > 0: got.append("%d tons of fuel oil" % int(sv.fuel))
            if int(sv.coin) > 0: got.append("fittings worth %s" % Campaign.fmt(int(sv.coin)))
            if int(sv.rp) > 0: got.append("%d RP from equipment ahead of yours" % int(sv.rp))
            box.add_child(UI.label("SALVAGE", UI.DIM, 12))
            _p(box, ("Your boats work the wrecks%s%s: %s." % [" in shoal water, where divers reach the hulls" if sv.shoal else "", (", with the %s's gear" % sv.ship) if sv.ship != "" else "", ", ".join(got)]) if not got.is_empty() else "Your boats find nothing worth taking from the wrecks.")
            if sv.left: _p(box, "The holds are full: some of it was left in the water.", UI.GOLD, 13)
            if sv.ship == "": _p(box, "A salvage ship in company doubles what is raised; shoal water adds half as much again.", UI.DIM, 12)
        if r.bounty: _p(box, "Bounty paid: %s." % Campaign.fmt(r.bounty))
        for n in r.notes: _p(box, n, UI.GOLD)
        if r.prizes.size():
            box.add_child(UI.label("PRIZES", UI.DIM, 12)); _p(box, "These ships struck their colours. Each prize takes a place in your fleet and needs crew. She joins in her present condition, with her weapons intact.", UI.DIM)
            for s in r.prizes:
                var h: Dictionary = GameData.hulls[s.type]
                if s.get("taken", "") != "": _p(box, "%s · %s · %s" % [s.name, h.name, s.taken], UI.GREEN); continue
                box.add_child(UI.row([UI.label("%s · %s · %d%% · needs %d crew" % [s.name, h.name, int(s.hullFrac * 100), h.crew]),
                    UI.button("Take as prize", func(): _take_prize(s), true, Campaign.can_add_ship(s.type) != ""),
                    UI.button("Scuttle for " + Campaign.fmt(Campaign.ship_value(s) * 0.1), func(): s.taken = "Scuttled"; Campaign.G.credits += round(Campaign.ship_value(s) * 0.1); _show_aftermath(r))]))
        box.add_child(UI.button("Return to the chart", func(): _aftermath_done(r), true))
    , true)

func _take_prize(s: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var r: Dictionary = Campaign.last_result
    s.taken = "Taken"; var ns = s.duplicate(true); ns.erase("taken"); ns.pal = "player"; ns.id = str(randi()); ns.xp = 0.0; G.fleet.append(ns); G.kills += 1   # a prize crew is a scratch crew: green
    _toast("%s sails under your flag. She needs %d crew." % [s.name, GameData.hulls[s.type].crew])
    var study := Campaign.study_prize(ns)
    if study != "": _toast(study)
    if G.mission != null:
        var m: Dictionary = Campaign.mission_def()
        if m.goal == "capture" and s.name == m.target: Campaign._complete_mission(r)
    _show_aftermath(r)

func _aftermath_done(r: Dictionary) -> void:
    var G: Dictionary = Campaign.G
    if G.mission != null:
        var m: Dictionary = Campaign.mission_def()
        if m.goal == "capture" and r.prizes.any(func(s): return s.name == m.target and s.get("taken", "") != "Taken"):
            _toast("Without the %s, what she carried is lost. Return to the %s for new orders." % [m.target, Campaign.story_office(G.mission.get("by", "concord"))]); G.mission = null; Campaign.log_ev("Mission failed: " + m.title)
    G.player.cool = 4.0; Campaign.save(); close_panel()

func open_survey(q: Dictionary) -> void:
    open_panel(func(box):
        box.add_child(UI.title("Survey: " + q.name)); _p(box, q.get("text", Campaign.C.POI_TEXT[q.type]))
        box.add_child(UI.row([UI.button("Send the divers down", func(): _do_survey(q), true, Campaign.G.day < q.next), UI.button("Leave", close_panel)])))

func _do_survey(q: Dictionary) -> void:
    var out = Campaign.do_survey(q)
    open_panel(func(box):
        box.add_child(UI.title("Survey: " + q.name))
        for l in out.lines: _p(box, l)
        if out.ambush != null: box.add_child(UI.button("Battle stations", func(): _battle(out.ambush), true))
        else: box.add_child(UI.button("Return to the chart", close_panel, true))
    , out.ambush != null)

## A ship's hull condition as a thin bar centred in its row, with a tooltip saying what it measures.
func _hull_bar(f: float) -> Control:
    var b := UI.bar(f); b.size_flags_vertical = Control.SIZE_SHRINK_CENTER; b.tooltip_text = "Hull condition: %d%% of full strength. Repair in port." % int(f * 100)
    b.mouse_filter = Control.MOUSE_FILTER_PASS
    return b

func _fleet_table(box: Control, at_port: bool) -> void:
    var G: Dictionary = Campaign.G; var need = Campaign.crew_need(); var short = maxi(0, need - int(G.crew))
    _p(box, "The first ship listed is your flagship. Crew %s of %s needed%s. Wages %s a day%s." % [Campaign.fmt(G.crew), Campaign.fmt(need), ", so undermanned ships reload and steam slower" if short else "", Campaign.fmt(Campaign.wages()), " (your officers on half pay while you serve no one: no commission, contract or flag)" if Campaign.half_pay() and not G.officers.is_empty() else ""], UI.DIM, 14)
    _p(box, Campaign.supply_text() + (" Only the first %d ships not in reserve fight in one action." % Campaign.BATTLE_MAX if Campaign.G.fleet.size() > Campaign.BATTLE_MAX else ""), UI.RED if Campaign.supply_over() > 0 else UI.DIM, 13)
    if at_port: _p(box, "Sell a ship here for what the yard will give, or scuttle her anywhere: her crew stays with you. You cannot part with your last ship.", UI.DIM, 13)
    else: _p(box, "A ship can be sold in any port (Repairs & crew), or scuttled here and now: her crew stays with you. You cannot part with your last ship.", UI.DIM, 13)
    for i in G.fleet.size():
        var s: Dictionary = G.fleet[i]; var h: Dictionary = GameData.hulls[s.type]; var o = Campaign.officer_of(s)
        # two lines to a ship, so the buttons are never pushed off the panel by a long name
        var nm := UI.label(("★ " if i == 0 else "") + s.name, UI.GOLD if i == 0 else UI.INK); nm.custom_minimum_size.x = 190
        var rd: float = Campaign.readiness(s)
        box.add_child(UI.row([nm, UI.label("%s · %s class (%s) · %s kn · %s crew" % [h.name, h.dn, GameData.makers[h.yard].short, str(h.kn), Campaign.crew_name(s)], UI.DIM, 13), UI.label("Hull", UI.DIM, 13), _hull_bar(s.hullFrac), UI.label("%d%%" % int(s.hullFrac * 100), UI.DIM, 13),
            UI.label("Readiness %d%%" % int(rd * 100), UI.GREEN if rd > 0.8 else (UI.GOLD if rd > 0.55 else UI.RED), 13)]))
        var items = [_captain_pick(s)]
        var rb := UI.button("In reserve ✓" if s.get("reserve", false) else "Hold in reserve", func(): s.reserve = not s.get("reserve", false); _rerender()); rb.tooltip_text = "A ship in reserve stands off when the squadron fights: she takes no part and no damage. Useful for transports, oilers and cripples."
        items.append(rb)
        if Campaign.body() == null and G.fleet.size() > 1:
            var fb := UI.button("Fast division ✓" if s.get("fast", false) else "Mark for the fast division", func(): s.fast = not s.get("fast", false); _rerender()); fb.tooltip_text = "Mark your fastest ships, then detach them below to run down an enemy your slowest ship cannot catch."
            items.append(fb)
        if at_port:
            var rc = repair_cost(s)
            items.append(UI.button("Repair · " + Campaign.fmt(rc), func(): G.credits -= rc; s.hullFrac = 1.0; _rerender(), false, rc == 0 or G.credits < rc))
            items.append(UI.button("Sell · " + Campaign.fmt(sell_value(s)), func(): _sell_ship(s), false, G.fleet.size() < 2))
        if _scuttle_id == str(s.id):
            items.append(UI.button("Confirm: scuttle the " + s.name, func(): _scuttle_id = ""; _scuttle(s), true))
            items.append(UI.button("Keep her", func(): _scuttle_id = ""; _rerender()))
        else: items.append(UI.button("Scuttle", func(): _scuttle_id = str(s.id); _rerender(), false, G.fleet.size() < 2))
        if i: items.append(UI.button("Make flagship", func(): G.fleet.erase(s); G.fleet.push_front(s); _rerender()))
        box.add_child(UI.row(items))
    _division_section(box)

## Under the fleet list: detaching a fast division, and the main body when it is apart.
func _division_section(box: Control) -> void:
    var G: Dictionary = Campaign.G; var b = Campaign.body()
    box.add_child(UI.label("DIVISIONS", UI.DIM, 12))
    if b != null:
        var km := int(Campaign.mdist(G.player.x, G.player.y, b.x, b.y) * Campaign.KM_PER_UNIT)
        _p(box, "Your main body is detached: %s, %d km from you, following at %d knots. Apart from you it is a fleet like any other: a power at war with you will fight it if they meet." % [_counts(b.ships), km, int(Campaign.fleet_map_speed(b.ships) / 0.576 * 0.7)], UI.GOLD, 14)
        box.add_child(UI.row([UI.button("Signal the main body to rejoin" if not b.get("join", false) else "Rejoining when in company ✓", func(): b.join = not b.get("join", false); _rerender(), not b.get("join", false))]))
        _p(box, "It rejoins when it comes up with you (within about 75 km). Slow down or stop to let it.", UI.DIM, 13)
        return
    var fast: Array = G.fleet.filter(func(s): return s.get("fast", false))
    if G.fleet.size() < 2: _p(box, "One ship is no squadron to divide.", UI.DIM, 13); return
    var all_kn := int(Campaign.fleet_map_speed(G.fleet) / 0.576 * 0.7)
    _p(box, "The squadron steams at the pace of its slowest ship: %d knots at cruising speed. Mark your fastest ships above and detach them to run down a faster enemy; the rest follow as the main body.%s" % [all_kn, (" The marked ships would make %d knots." % int(Campaign.fleet_map_speed(fast) / 0.576 * 0.7)) if not fast.is_empty() else ""], UI.DIM, 13)
    box.add_child(UI.button("Detach the fast division (%d ships)" % fast.size(), func(): _toast(Campaign.detach(fast)); _rerender(), true, fast.is_empty() or fast.size() == G.fleet.size()))

var _scuttle_id := ""
## Open the sea cocks: the ship is gone, with nothing for her but her crew, who stay with you.
func _scuttle(s: Dictionary) -> void:
    var G: Dictionary = Campaign.G
    G.fleet.erase(s)
    for o in G.officers: if o.ship == s.id: o.ship = null
    var over: Dictionary = Campaign.trim_cargo()
    if not over.is_empty(): _toast("Cargo that no longer fits goes down with her: %s." % Campaign.cargo_text(over))
    var left := Structures.trim_troops()
    _toast("The %s is scuttled. Her crew is taken off%s." % [s.name, (", but %d soldiers had no berth left and were paid off" % left) if left > 0 else ""])
    Campaign.log_ev("Scuttled the " + s.name); _rerender()

# ------------------------------------------------------------------ ports (market and repairs for now)
var cur_port: Dictionary = {}
var port_tab = "market"
func repair_cost(s: Dictionary) -> int: return int(ceil((1 - s.hullFrac) * GameData.hulls[s.type].price * 0.2))
## What a yard pays for a ship. A ship you bought (`paid`: what you have put into her, the yard's price and refits
## since) never fetches more than 45% of that: a yard charges for the hull and fits the standard weapons with it, so
## selling her by the value of those weapons paid more than she had cost (free money, round after round).
func sell_value(s: Dictionary) -> int:
    var v: float = Campaign.ship_value(s)
    if s.has("paid"): v = minf(v, float(s.paid))
    return int(floor(v * 0.45 * (0.4 + 0.6 * s.hullFrac)))
## Commissions a new ship from a yard for the price given: she joins the squadron with her standard fit.
func buy_ship(t: String, pr: int) -> Dictionary:
    var G: Dictionary = Campaign.G
    G.credits -= pr; var s: Dictionary = Campaign.new_ship(t, null, "player", G.tech); s.paid = pr; G.fleet.append(s)
    return s
## What a refit plan costs: [new weapons, sold back]. Weapons taken off go back at half price, but a ship you bought
## cannot return more than half of what you have put into her (her standard weapons came with the yard's price).
const YARD_PER_TON := 12
## Tons landed and shipped by a planned refit.
func refit_tons(s: Dictionary, plan: Array) -> float:
    var t := 0.0
    for i in s.fit.size():
        var a: String = s.fit[i] if s.fit[i] != null else ""; var b: String = plan[i] if plan[i] != null else ""
        if a != b: t += BattleSim.weapon_tons(a) + BattleSim.weapon_tons(b)
    return t
func refit_cost(s: Dictionary, plan: Array) -> Array:
    var buy := 0; var refund := 0
    for i in s.fit.size():
        var a: String = s.fit[i] if s.fit[i] != null else ""; var b: String = plan[i] if plan[i] != null else ""
        if a == b: continue
        if b != "": buy += int(GameData.weapons[b].price)
        if a != "": refund += int(GameData.weapons[a].price / 2)
        buy += int((BattleSim.weapon_tons(a) + BattleSim.weapon_tons(b)) * YARD_PER_TON)   # the yard's labour: every ton landed or shipped
    if s.has("paid"): refund = mini(refund, int(float(s.paid) * 0.5) + buy)
    return [buy, refund]
func apply_refit(s: Dictionary, plan: Array) -> void:
    var c := refit_cost(s, plan)
    Campaign.G.credits -= c[0] - c[1]; var moved := refit_tons(s, plan); s.fit = plan.duplicate(); Campaign.refit_done(s, moved)
    if s.has("paid"): s.paid = maxf(0.0, float(s.paid) + c[0] - c[1])
func port_price(p: Dictionary, gid: String) -> int:
    var base = 1.0
    for g in Campaign.C.GOODS: if g.id == gid: base = g.base
    return maxi(1, int(round(base * p.mod[gid] * (1 + p.drift[gid]) * Campaign.supply_mult(p, gid))))
func buy_price(p: Dictionary, gid: String) -> int: return int(ceil(port_price(p, gid) * 1.06 * (1.1 if Campaign.G.rep.get(p.fac, 0) < 0 else 1.0) * (1.15 if Campaign.restricted(p.fac) else 1.0) * (1.0 - float(Campaign.perk("trade", 0.0)))))
func sell_price(p: Dictionary, gid: String) -> int: return int(floor(port_price(p, gid) * 0.93 * (0.9 if Campaign.restricted(p.fac) else 1.0) * (1.0 + float(Campaign.perk("trade", 0.0)))))

func open_port(p: Dictionary) -> void:
    Sfx.cue("gong", 0.4)   # the bell: alongside
    if not Campaign.hostile(p.fac) and Campaign.G.day - p.get("offDay", -99) > 20: # the officers' mess turns over every few weeks
        p.offDay = Campaign.G.day; p.officers = [Campaign.new_officer(randi_range(1, 2)), Campaign.new_officer(randi_range(1, 3))]
        if randf() < 0.4: p.officers.append(Campaign.new_officer(randi_range(2, 4)))
    var sm = Diplomacy.smuggle_for(p)
    if Campaign.hostile(p.fac) and sm != null:   # a closed harbour, but there is a cargo to land
        open_panel(func(box):
            box.add_child(UI.title(p.name)); _p(box, "The harbour is closed to you, but your contact has named a beach and a night. Lights out, engines slow.")
            _p(box, "Chance of being caught: %d%%. Caught, the cargo is seized, %s standing falls by 12, and their warships will hunt you for three months." % [int(Diplomacy.smuggle_risk(p) * 100), GameData.fac[p.fac].short], UI.DIM, 14)
            box.add_child(UI.row([UI.button("Run the cargo ashore", func(): var t: String = Diplomacy.run_contraband(sm, p); close_panel(); _toast(t), true), UI.button("Turn away", close_panel)])))
        return
    if Campaign.hostile(p.fac) and Flag.founded() and Structures.troops() > 0: _storm_panel(p, true); return
    if Campaign.hostile(p.fac):
        open_panel(func(box): box.add_child(UI.title(p.name)); _p(box, "Shore batteries track your ships as you close the harbour. %s ports are closed to you while your standing with them is this low. Raise your standing, or dock somewhere friendlier." % GameData.fac[p.fac].name); box.add_child(UI.button("Stand off", close_panel, true)))
        return
    Diplomacy.on_dock(p)
    cur_port = p; port_tab = "market"; _render_port(); Campaign.save()

## Storming a port with your troops: the defenders, the odds, what it means, and the order.
func _storm_panel(p: Dictionary, closed: bool) -> void:
    open_panel(func(box):
        box.add_child(UI.title("Storm " + p.name))
        if closed: _p(box, "The harbour is closed to you and its batteries track your ships. Your transports stand by to put the troops ashore.")
        else: _p(box, "You lie in the roads as a guest. Your transports could put the troops ashore before the garrison stands to.")
        var bats := 0
        for s in Structures.all(): if int(s.port) == int(p.id) and s.fac == p.fac and (s.kind == "battery" or s.kind == "navalbase") and not Structures.silenced(s): bats += 1
        _p(box, "Your troops: %s. Defenders: about %s%s. The staff put the chances at %d in 100." % [Campaign.fmt(Structures.troops()), Campaign.fmt(int(Flag.port_defenders(p))), (", with %d batteries and bases of the port still standing (silence them first and their crews stay out of the fight)" % bats) if bats > 0 else "", int(round(Flag.assault_odds(p) * 100))], UI.INK, 14)
        _p(box, "This is war with the %s: standing -40, their warships engage you on sight, and they will send a relief force to take it back. Won, the port flies your flag: its market and yard serve you, it pays dues every month (about %s), and the batteries and bases that stand round it come with it. It will want a garrison of %s." % [GameData.fac[p.fac].name, Campaign.fmt(int(Flag.TAX * Flag.weight(p))), Campaign.fmt(Flag.hold_need(p))], UI.RED, 13)
        var why := Flag.can_assault(p)
        if why != "": _p(box, why, UI.DIM, 13)
        box.add_child(UI.row([UI.button("Storm the harbour (%s men)" % Campaign.fmt(Structures.troops()), func(): _storm_report(p, Flag.assault(p)), true, why != ""), UI.button("Stand off", close_panel)]))
    , true, 760)

func _storm_report(p: Dictionary, r: Dictionary) -> void:
    open_panel(func(box):
        box.add_child(UI.title(("%s is yours" if r.won else "Repulsed at %s") % p.name))
        _p(box, "%s soldiers went ashore against about %s defenders; the staff had put the chances at %d in 100." % [Campaign.fmt(int(r.men)), Campaign.fmt(int(r.defenders)), int(round(float(r.odds) * 100))])
        if r.won:
            _p(box, "%s of your men fell. %s hold the port as its garrison and %s are back aboard. %s flies over the harbour." % [Campaign.fmt(int(r.lost)), Campaign.fmt(int(p.men)), Campaign.fmt(Structures.troops()), Flag.flag_name()], UI.GOLD)
            if not r.took.is_empty(): _p(box, "With the port come: " + ", ".join(r.took) + ".", UI.INK, 14)
            _p(box, "The %s will send a relief force. Keep the garrison up to strength (Governor tab) and meet their transports at sea." % GameData.fac[r.from].name, UI.DIM, 14)
            box.add_child(UI.row([UI.button("Enter the port", func(): open_port(p), true), UI.button("Return to the chart", close_panel)]))
        else:
            _p(box, "The landing was thrown back. %s of your men were lost; %s were taken off." % [Campaign.fmt(int(r.lost)), Campaign.fmt(Structures.troops())], UI.RED)
            box.add_child(UI.row([UI.button("Return to the chart", close_panel, true)]))
    , true, 720)

## The Governor's office of a port that flies your flag.
func _governor(box: Control, p: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var need := Flag.hold_need(p); var men := int(p.get("men", 0)); var from: String = p.get("from", "")
    _p(box, "%s flies your flag since %s%s." % [p.name, Campaign.date_str(int(p.get("took", G.day))), (", taken from the %s, who want it back" % GameData.fac[from].name) if from != "" else ""], UI.GOLD, 14)
    _p(box, "Garrison %s of %s wanted (wages %s a day). Harbour dues and customs: %s a month, paid on the 30th%s." % [Campaign.fmt(men), Campaign.fmt(need), Campaign.fmt(men * 0.15), Campaign.fmt(Flag.tax(p)), "" if men >= need else "; an under-strength garrison collects less and holds worse"], UI.INK, 14)
    for f in G.fleets: if Flag.is_relief(f) and int(f.portAssault) == int(p.id): _p(box, "Threat: a %s is bound here, %s." % [Campaign.fname(f), Diplomacy.where(f.x, f.y)], UI.RED, 14)
    box.add_child(UI.row([UI.button("Land 100 from the transports", func(): Flag.reinforce(p, 100); _render_port(), false, Structures.troops() <= 0),
        UI.button("Land all (%s)" % Campaign.fmt(Structures.troops()), func(): Flag.reinforce(p, Structures.troops()); _render_port(), false, Structures.troops() <= 0),
        UI.button("Take 100 off", func(): Flag.take_off(p, 100); _render_port(), false, men <= 0 or Structures.troop_capacity() <= Structures.troops())]))
    _p(box, "Soldiers are raised here as anywhere (Repairs & crew) and landed from your transports. The yard still builds its old owner's designs, and anything you have captured and measured.", UI.DIM, 13)
    # the guard squadron
    box.add_child(UI.label("GUARD SQUADRON", UI.DIM, 12))
    var gd = Flag.guard(p)
    if gd != null:
        _p(box, "On station: %s (%s a day). It meets a relief force before it lands and fights raiders and enemies that come near." % [_counts(gd.ships), Campaign.fmt(Flag.GUARD_PAY)], UI.INK, 14)
        box.add_child(UI.button("Pay the squadron off", func(): Flag.disband_guard(p); _render_port()))
    else:
        var wg := Flag.can_guard(p)
        _p(box, "Warships of your own to cruise off the harbour, built in this yard: they meet a relief force before it lands. %s a day to keep." % Campaign.fmt(Flag.GUARD_PAY), UI.DIM, 13)
        box.add_child(UI.button("Raise a guard squadron · " + Campaign.fmt(int(Flag.GUARD_COST * Flag.weight(p))), func(): Flag.raise_guard(p); _toast("A guard squadron puts out from %s." % p.name); _render_port(), false, wg != ""))
    # works
    box.add_child(UI.label("WORKS", UI.DIM, 12))
    for k in Flag.WORKS:
        var w: Dictionary = Flag.WORKS[k]; var why := Flag.can_build(p, k); var have := Flag.works(p, k); var left := Flag.works_building(p, k)
        var st: String = ("building, %d days left" % left) if left > 0 else (("built" + ((" ×%d" % have) if int(w.max) > 1 else "")) if have > 0 else "not built")
        var nm := UI.label(w.name, UI.GOLD if have > 0 else UI.INK, 14); nm.custom_minimum_size.x = 170
        box.add_child(UI.row([nm, UI.label(st, UI.GREEN if have > 0 and left == 0 else UI.DIM, 13),
            UI.button("Build · " + Campaign.fmt(int(w.cost)), func(): _toast(Flag.build(p, k)); _render_port(), false, why != "")]))
        _p(box, w.text, UI.DIM, 12)
    # ships that have come over
    var vol: Array = p.get("volunteers", [])
    if not vol.is_empty():
        box.add_child(UI.label("SHIPS ASKING TO SERVE", UI.DIM, 12))
        for sh in vol:
            var h: Dictionary = Campaign.hull(sh); var b := Flag.bounty(sh)
            box.add_child(UI.row([UI.label(sh.name, UI.INK, 14), UI.label("%s · %s class · hull %d%% · late of the %s" % [h.name, h.dn, int(float(sh.hullFrac) * 100), GameData.fac[sh.get("cameFrom", "freeport")].short], UI.DIM, 13),
                UI.button("Commission her · bounty " + Campaign.fmt(b), func(): _toast(Flag.commission(p, sh)); _render_port(), true, G.credits < b or Campaign.can_add_ship(sh.type) != ""),
                UI.button("Send her away", func(): p.volunteers.erase(sh); _render_port())]))
    box.add_child(UI.button("Give the port up", func(): var t := Flag.abandon(p); cur_port = {}; close_panel(); _toast(t)))

func _rerender() -> void:
    if not cur_port.is_empty(): _render_port()
    else: show_command()

func _market(box: Control, p: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var free = Campaign.cargo_cap() - Campaign.cargo_used()
    _p(box, "Hold %d / %d · Funds %s · Fleet burns %.1f fuel a day under way · Bunkers %d / %d%s" % [Campaign.cargo_used(), Campaign.cargo_cap(), Campaign.fmt(G.credits), Campaign.fuel_use(), int(G.cargo.fuel), Campaign.bunker_cap(), (" (%d in oilers' tanks)" % Campaign.tank_cap()) if Campaign.tank_cap() > 0 else ""], UI.DIM, 14)
    for g in Campaign.C.GOODS:
        var gid: String = g.id; var m: float = p.mod[gid] * (1 + p.drift[gid]) * Campaign.supply_mult(p, gid)
        var tag = " · surplus" if m < 0.75 else (" · shortage" if m > 1.3 else "")
        var bp = buy_price(p, gid); var sp = sell_price(p, gid); var held = int(floor(G.cargo[gid]))
        var can: bool = G.credits >= bp and (Campaign.fuel_room() >= 1 if gid == "fuel" else free >= 1)
        var nm = UI.label(g.name + tag, UI.GREEN if m < 0.75 else (UI.RED if m > 1.3 else UI.INK)); nm.custom_minimum_size.x = 200
        box.add_child(UI.row([nm, UI.label("buy %d · sell %d · held %d" % [bp, sp, held], UI.DIM, 13),
            UI.button("Buy 10", func(): _buy(p, gid, 10), false, not can), UI.button("Max", func(): _buy(p, gid, -1), false, not can),
            UI.button("Sell 10", func(): _sell(p, gid, 10), false, held < 1), UI.button("Sell all", func(): _sell(p, gid, -1), false, held < 1)]))
    var why: Array = Campaign.market_notes(p)
    if why.size(): _p(box, "Supply: " + "; ".join(why) + ".", UI.GOLD, 13)
    _p(box, "Prices follow the world: wars, sieges, convoys that arrive or are lost, and the works that feed a flag. Your own trading moves them too.", UI.DIM, 13)

func _buy(p: Dictionary, gid: String, n: int) -> void:
    var G: Dictionary = Campaign.G; var bp = buy_price(p, gid)
    var free: int = Campaign.fuel_room() if gid == "fuel" else Campaign.cargo_cap() - Campaign.cargo_used()
    var want: int = free if n < 0 else mini(n, free)
    # the price climbs ton by ton as you buy, as it falls ton by ton when you sell (a whole batch used to go at the
    # first ton's price, so buying a shipload and selling it straight back made money)
    for i in want:
        bp = buy_price(p, gid)
        if G.credits < bp: break
        G.credits -= bp; G.cargo[gid] += 1; p.drift[gid] = minf(0.6, p.drift[gid] + 0.003)
    _render_port()

func _sell(p: Dictionary, gid: String, n: int) -> void:
    var G: Dictionary = Campaign.G; var held = int(floor(G.cargo[gid])); var k = held if n < 0 else mini(n, held); var got = 0
    for i in k: got += sell_price(p, gid); p.drift[gid] = maxf(-0.5, p.drift[gid] - 0.003)
    G.credits += got; G.cargo[gid] -= k; _render_port()

func _sell_ship(s: Dictionary) -> void:
    var G: Dictionary = Campaign.G
    G.credits += sell_value(s); G.fleet.erase(s)
    var over: Dictionary = Campaign.trim_cargo()   # her holds go with her: what no longer fits is sold here at the port's price
    if not over.is_empty():
        var got := 0
        for gid in over: got += int(over[gid]) * sell_price(cur_port, gid) if not cur_port.is_empty() else 0
        G.credits += got; _toast("Cargo that no longer fits is landed and sold: %s, for %s." % [Campaign.cargo_text(over), Campaign.fmt(got)])
    var left := Structures.trim_troops()
    if left > 0: _toast("%d soldiers had no berth left and were paid off." % left)
    for o in G.officers:
        if o.ship == s.id: o.ship = null
    _rerender()

func _repair_all(total: int) -> void:
    var G: Dictionary = Campaign.G
    G.credits -= total
    for s in G.fleet: s.hullFrac = 1.0
    _render_port()

