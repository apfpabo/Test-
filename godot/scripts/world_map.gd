func _update_dock() -> void:
    if panel_open: dock.visible = false; return
    var np = Campaign.nearest_port(28.0); var poi = null if np != null else Campaign.nearest_poi(22.0)
    var base = null
    if np == null and poi == null:
        for s in Structures.held(): if s.kind == "navalbase" and Structures.off_coast(s): base = s
    dock.set_meta("base", base.id if base != null else -1)
    if base != null: dock.visible = true; dock.text = "Dock at " + base.name; dock.set_meta("port", -1); dock.set_meta("poi", -1); return
    dock.visible = np != null or poi != null
    if np != null: dock.text = "Dock at " + np.name; dock.set_meta("port", np.id); dock.set_meta("poi", -1)
    elif poi != null: dock.text = "Survey " + poi.name; dock.set_meta("poi", poi.id); dock.set_meta("port", -1)

func _on_dock() -> void:
    if dock.get_meta("port", -1) >= 0: open_port(Campaign.G.ports[dock.get_meta("port")])
    elif dock.get_meta("poi", -1) >= 0: open_survey(Campaign.G.pois[dock.get_meta("poi")])
    elif dock.get_meta("base", -1) >= 0: open_struct(Structures.all()[dock.get_meta("base")])

# ------------------------------------------------------------------ input
func _unhandled_input(e: InputEvent) -> void:
    if panel_open:
        if e is InputEventKey and e.pressed and e.keycode == KEY_ESCAPE and not _blocking: close_panel()
        return
    if e is InputEventKey and e.pressed and e.keycode == KEY_ESCAPE: _pause_menu(); return
    if e is InputEventMouseButton:
        var mb = e as InputEventMouseButton
        if mb.button_index == MOUSE_BUTTON_WHEEL_UP and mb.pressed: _zoom_at(1.12, mb.position)
        elif mb.button_index == MOUSE_BUTTON_WHEEL_DOWN and mb.pressed: _zoom_at(1 / 1.12, mb.position)
        elif mb.button_index == MOUSE_BUTTON_RIGHT and mb.pressed: _context(mb.position)
        elif mb.button_index == MOUSE_BUTTON_LEFT:
            if mb.pressed: drag = {"at": mb.position, "cam": cam, "moved": false}
            else:
                if not drag.is_empty() and not drag.moved: _click(mb.position)
                drag = {}
    elif e is InputEventMouseMotion and not drag.is_empty():
        var d: Vector2 = e.position - drag.at
        if not drag.moved and d.length() < 6: return
        drag.moved = true; free_cam = true; cam = drag.cam - d / zoom
    elif e is InputEventKey and e.pressed and not e.echo:
        match e.keycode:
            KEY_SPACE: Campaign.paused = not Campaign.paused
            KEY_Q, KEY_E:   # the telegraph: Q slower, E faster
                var i: int = Campaign.SPEED_ORDER.find(Campaign.speed_order()) + (1 if e.keycode == KEY_E else -1)
                _set_speed(Campaign.SPEED_ORDER[clampi(i, 0, Campaign.SPEED_ORDER.size() - 1)])
            KEY_1: _speed(1)
            KEY_2: _speed(2)
            KEY_3: _speed(4)
            KEY_4: _speed(8)
            KEY_C, KEY_HOME: free_cam = false
            KEY_EQUAL, KEY_KP_ADD: zoom = clampf(zoom * 1.25, 0.14, 14)
            KEY_MINUS, KEY_KP_SUBTRACT: zoom = clampf(zoom / 1.25, 0.14, 14)

func _zoom_at(f: float, sp: Vector2) -> void:
    var before = to_world(sp); zoom = clampf(zoom * f, 0.14, 14)
    if free_cam: cam += before - to_world(sp)

func _click(sp: Vector2) -> void:
    var G: Dictionary = Campaign.G; var P: Dictionary = G.player; var w = to_world(sp); w.x = Campaign.wrap_x(w.x)
    var near = func(x: float, y: float, r: float) -> bool: return Campaign.mdist(x, y, w.x, w.y) < r / zoom   # r in screen pixels
    if P.get("towed") != null: _toast("You are under tow. Right-click to cast off the tow."); return
    if Campaign.dead_in_water(): _toast("Your squadron is dead in the water: no fuel, no reserve. Right-click a friendly fleet to call it by wireless.")
    if Input.is_key_pressed(KEY_CTRL) and P.get("route") != null and P.get("follow") == null and P.get("escort") == null:   # another waypoint
        var tp = null
        for p in G.ports: if near.call(p.x, p.y, 14) or near.call(p.sx, p.sy, 10): tp = p
        var at: Vector2 = Vector2(tp.sx, tp.sy) if tp != null else Vector2(w.x, clampf(w.y, 4, Campaign.MH - 4))
        if tp == null and Campaign.on_land(at.x, at.y): _toast("That is land. Pick a point on the water."); return
        if Campaign.add_waypoint(P, at.x, at.y): P.destPort = tp.id if tp != null else null; Campaign.paused = false
        else: _toast("No sea route to that point.")
        return
    P.destPort = null; P.follow = null; P.escort = null; Campaign.paused = false
    var hit = fleet_at(w)
    for f in ([hit] if hit != null else []):
        P.follow = f.id; P.repathT = 0.0; f.cool = 0.0; _toast("Intercept course locked on the " + f.name.to_lower() + ". You will close and make contact."); return
    for p in G.ports:
        if near.call(p.x, p.y, 14) or near.call(p.sx, p.sy, 10):
            if Campaign.mdist(p.sx, p.sy, P.x, P.y) < 28: open_port(p); return
            P.destPort = p.id
            if not Campaign.set_course(P, p.sx, p.sy): P.tx = null; _toast("No sea route to " + p.name + ".")
            return
    for q in G.pois:
        if near.call(q.x, q.y, 12):
            if Campaign.mdist(q.x, q.y, P.x, P.y) < 22: open_survey(q); return
            Campaign.set_course(P, q.x, q.y); return
    if zoom >= 0.3:
        var st = Structures.at_point(w.x, w.y, maxf(10.0 / zoom, struct_r(Structures.at_point(w.x, w.y, 40.0)) if zoom >= 3.0 else 0.0))
        if st != null and (st.fac == "player" or zoom >= (0.3 if Structures.kind(st).military else 0.45)): open_struct(st); return
    if Campaign.on_land(w.x, w.y): _toast("That is land. Pick a point on the water."); return
    if not Campaign.set_course(P, w.x, clampf(w.y, 4, Campaign.MH - 4)): P.tx = null; _toast("No sea route to that point.")

## Right-click on a fleet: orders for it. Friendly fleets: escort, close and hail, cancel; hostile ones: intercept.
var _menu: PopupMenu
func _context(sp: Vector2) -> void:
    var G: Dictionary = Campaign.G; var P: Dictionary = G.player; var w = to_world(sp); var hit = null
    hit = fleet_at(Vector2(Campaign.wrap_x(w.x), w.y))
    if _menu == null:
        _menu = PopupMenu.new(); _menu.add_theme_font_size_override("font_size", 14); ui.add_child(_menu)
        _menu.id_pressed.connect(_context_pick)
    _menu.clear()
    var busy: bool = P.get("towed") != null or P.get("escort") != null or P.get("follow") != null or P.get("route") != null
    if hit != null:
        _menu.set_meta("fleet", int(hit.id))
        _menu.add_separator(hit.name + " (%d)" % hit.ships.size())
        if Campaign.hostile_fleet(hit): _menu.add_item("Intercept", 2)
        else:
            _menu.add_item("Escort her" if P.get("escort") != int(hit.id) else "Escorting her (keep station)", 1)
            _menu.set_item_disabled(_menu.get_item_index(1), P.get("escort") == int(hit.id))
            _menu.add_item("Close and hail", 2)
            var dP: float = Campaign.mdist(hit.x, hit.y, P.x, P.y)
            if dP < Campaign.CONTACT * 1.5: _menu.add_item("Hail her now (signals)", 5)
            else: _menu.add_item("Call her by wireless (%d km)" % int(dP * Campaign.KM_PER_UNIT), 4); _menu.set_item_disabled(_menu.get_item_index(4), dP > Campaign.WIRELESS)
    elif not busy: return
    if P.get("towed") != null: _menu.add_item("Cast off the tow", 6)
    _menu.add_item("Cancel orders (heave to)", 3)
    _menu.set_item_disabled(_menu.get_item_index(3), not busy)
    _menu.position = Vector2i(sp)
    _menu.reset_size(); _menu.popup()

func _context_pick(id: int) -> void:
    var G: Dictionary = Campaign.G; var P: Dictionary = G.player; var f = Campaign._fleet(_menu.get_meta("fleet", -1))
    match id:
        1:
            if f == null: return
            P.follow = null; P.destPort = null; P.escort = int(f.id); P.repathT = 0.0; free_cam = false; Campaign.paused = false
            _toast("You take station astern of the %s and keep with her." % f.name.to_lower())
        2:
            if f == null: return
            P.escort = null; P.destPort = null; P.follow = int(f.id); P.repathT = 0.0; f.cool = 0.0; Campaign.paused = false
            _toast(("Intercept course locked on the %s." if Campaign.hostile_fleet(f) else "Closing the %s to signalling distance.") % f.name.to_lower())
        3:
            if P.get("towed") != null: _context_pick(6)
            P.escort = null; P.follow = null; P.destPort = null; P.route = null; P.tx = null
            _toast("Orders cancelled. The squadron heaves to.")
        4: if f != null: _toast(Campaign.call_fleet(f))
        5: if f != null: _hail(f)
        6:
            var tf = Campaign._fleet(P.towed); P.towed = null; P.route = null; P.tx = null; P.destPort = null
            if tf != null: tf.cool = 20.0
            _toast("You cast off the tow. The fee is not returned.")

## The fleet under a chart point: within 16 pixels or about its drawn size, whichever is larger; the nearest wins.
func fleet_at(w: Vector2):
    var best = null; var bd := INF
    for f in Campaign.G.fleets:
        var d := Campaign.mdist(f.x, f.y, Campaign.wrap_x(w.x), w.y)
        var r: float = maxf(16.0 / zoom, marks._layout(f.ships)[0][3] * 0.55 if zoom >= 0.32 else 0.0)
        if d < r and d < bd: bd = d; best = f
    return best

# ------------------------------------------------------------------ panels
var _blocking = false   # a panel that must be answered (an encounter or an aftermath)
var cur_panel: Control

## `key` names what the panel shows (a port and tab, a Command tab): redrawn with the same key, it keeps its scroll
## position, so pressing a button far down a long list doesn't throw you back to the top.
var _panel_key := ""
var _panel_scroll: ScrollContainer
func open_panel(build: Callable, blocking := false, width := 760.0, key := "") -> VBoxContainer:
    var keep := 0
    if key != "" and key == _panel_key and is_instance_valid(_panel_scroll): keep = _panel_scroll.scroll_vertical
    # a fresh panel fades and settles in; a new page in an open panel fades in; a redraw of the same page doesn't
    var fresh: bool = not panel_open
    var new_page: bool = key == "" or key != _panel_key
    _panel_key = key
    _clear_panel(); panel_open = true; _blocking = blocking; Campaign.paused = true
    var shade = ColorRect.new(); shade.color = Color(0.016, 0.047, 0.063, 0.6); shade.set_anchors_preset(Control.PRESET_FULL_RECT); panel_layer.add_child(shade); shade.mouse_filter = Control.MOUSE_FILTER_STOP
    var center = CenterContainer.new(); center.set_anchors_preset(Control.PRESET_FULL_RECT); shade.add_child(center)
    var pc = PanelContainer.new(); pc.custom_minimum_size = Vector2(width, 0); center.add_child(pc)
    var scroll = ScrollContainer.new(); scroll.custom_minimum_size = Vector2(width - 44, 0); scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED; pc.add_child(scroll)
    var box = VBoxContainer.new(); box.size_flags_horizontal = Control.SIZE_EXPAND_FILL; box.add_theme_constant_override("separation", 8); scroll.add_child(box)
    cur_panel = shade; _panel_scroll = scroll
    build.call(box)
    if fresh:
        shade.modulate.a = 0.0; pc.modulate.a = 0.0; pc.scale = Vector2(0.97, 0.97)
        pc.resized.connect(func(): pc.pivot_offset = pc.size / 2, CONNECT_ONE_SHOT)
        var tw := create_tween().set_parallel(true)
        tw.tween_property(shade, "modulate:a", 1.0, 0.16)
        tw.tween_property(pc, "modulate:a", 1.0, 0.2).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
        tw.tween_property(pc, "scale", Vector2.ONE, 0.2).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC)
    elif new_page:
        box.modulate.a = 0.0
        create_tween().tween_property(box, "modulate:a", 1.0, 0.18).set_ease(Tween.EASE_OUT)
    _fit_panel.call_deferred(scroll, box, keep)
    return box

## Panels grow with their contents up to the screen height, then scroll.
func _fit_panel(scroll: ScrollContainer, box: Control, keep := 0) -> void:
    if not is_instance_valid(scroll): return
    scroll.custom_minimum_size.y = minf(box.get_combined_minimum_size().y + 4, get_viewport_rect().size.y - 140)
    if keep > 0:
        await get_tree().process_frame
        if is_instance_valid(scroll): scroll.scroll_vertical = keep

## Esc on the chart: the game stops while this is open. Like the battle's pause menu.
func _pause_menu() -> void:
    open_panel(func(box):
        box.add_child(UI.title("Paused"))
        _p(box, Campaign.date_str(Campaign.G.day) + " · Esc to resume", UI.DIM, 14)
        box.add_child(UI.button("Resume", close_panel, true))
        box.add_child(UI.button("Command", func(): show_command()))
        box.add_child(UI.button("Codex", func(): cmd_tab = "codex"; show_command()))
        box.add_child(UI.button("Settings", func(): _pause_settings()))
        var snd := UI.button("Sound: off (click to turn on)" if Sfx.muted else "Sound: on (click to mute)", func(): pass)
        snd.pressed.connect(func(): Sfx.muted = not Sfx.muted; snd.text = "Sound: off (click to turn on)" if Sfx.muted else "Sound: on (click to mute)")
        box.add_child(snd)
        box.add_child(UI.button("Save & exit to title", func(): Campaign.save(); get_tree().change_scene_to_file("res://scenes/main_menu.tscn")))
        box.add_child(UI.button("Save & quit to desktop", func(): Campaign.save(); get_tree().quit()))
    , false, 420)

func _pause_settings() -> void:
    open_panel(func(box):
        box.add_child(Settings.panel())
        box.add_child(UI.button("Back", _pause_menu, true))
    , false, 640)

func close_panel() -> void:
    # the panel fades away; it takes no more clicks while it does
    for c in panel_layer.get_children():
        if c.has_meta("closing"): continue
        c.set_meta("closing", true); c.propagate_call("set_mouse_filter", [Control.MOUSE_FILTER_IGNORE])
        var tw := create_tween(); tw.tween_property(c, "modulate:a", 0.0, 0.14).set_ease(Tween.EASE_IN); tw.tween_callback(c.queue_free)
    panel_open = false; _blocking = false; Campaign.paused = false

## Clears the panel at once (when another replaces it).
func _clear_panel() -> void:
    for c in panel_layer.get_children(): c.queue_free()
    panel_open = false; _blocking = false; Campaign.paused = false

func _p(box: Control, text: String, col := UI.INK, size := 15) -> void:
    var l = UI.label(text, col, size, true); l.size_flags_horizontal = Control.SIZE_EXPAND_FILL; box.add_child(l)

func _counts(ships: Array) -> String:
    var counts = {}; var order = []
    for s in ships:
        var h: Dictionary = GameData.hulls[s.type]; var k: String = h.dn + "-class " + h.name.to_lower()
        if not counts.has(k): counts[k] = 0; order.append(k)
        counts[k] += 1
    return ", ".join(order.map(func(k): return "%d× %s" % [counts[k], k]))

func _on_encounter(f: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var P: Dictionary = G.player; P.tx = null; P.route = null; P.follow = null
    var ratio = Campaign.strength(f.ships) / maxf(1.0, Campaign.strength(G.fleet))
    var odds = "They badly outgun you." if ratio > 1.6 else ("They have the heavier squadron." if ratio > 1.1 else ("It would be an even fight." if ratio > 0.75 else "You outgun them."))
    var evade = int(round(clampf(0.4 + (Campaign.fleet_map_speed(G.fleet) - Campaign.fleet_map_speed(f.ships)) / 40.0 + float(Campaign.perk("evade", 0)) / 100.0, 0.1, 0.92) * 100))
    open_panel(func(box):
        if not Campaign.hostile_fleet(f):
            _hail_body(box, f)
        else:
            var who: String = ("Your mission target, " + f.name + ",") if f.get("mission", false) else ("The flotilla you were hired to hunt" if int(f.get("contract", 0)) > 0 else (("%s's squadron, worth %s," % [f.captain, Campaign.fmt(f.reward)]) if f.kind == "bounty" else "A " + GameData.fac[f.fac].name + " force"))
            box.add_child(UI.title("Contact")); box.add_child(_lead_pic(f)); _p(box, "%s is closing on you: %s." % [who, _counts(f.ships)]); _p(box, _contact_line(f), UI.DIM); _p(box, odds, UI.DIM)
            box.add_child(UI.row([UI.button("Battle stations", func(): _battle(f), true),
                UI.button("Break off (%d%%)" % evade, func():
                    if randf() * 100 < evade: f.cool = 7.0; P.cool = 4.0; close_panel(); _toast("You turn away under a smoke screen and open the range.")
                    else: open_panel(func(b2): b2.add_child(UI.title("No escape")); _p(b2, "Their lookouts have you, and they hold the faster ships. You will have to fight."); b2.add_child(UI.button("Battle stations", func(): _battle(f), true)), true))]))
    , true)

## Where the contact was made and whose reach made it: lookouts and radar, missiles, or a carrier's search planes.
## Hailing a fleet that does not fire on you (alongside, or come to your wireless call): pass on, trade with a
## merchant convoy, ask a warship for a tow when your bunkers are dry, or open fire.
func _hail(f: Dictionary) -> void:
    open_panel(func(box): _hail_body(box, f), true)

func _hail_body(box: Control, f: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var P: Dictionary = G.player; f.answering = false
    var en = Campaign.enemies_of(f.fac)
    var ratio = Campaign.strength(f.ships) / maxf(1.0, Campaign.strength(G.fleet))
    var odds = "They badly outgun you." if ratio > 1.6 else ("They have the heavier squadron." if ratio > 1.1 else ("It would be an even fight." if ratio > 0.75 else "You outgun them."))
    box.add_child(UI.title(f.name)); box.add_child(_lead_pic(f)); _p(box, "%s ships close to signalling distance: %s." % [GameData.fac[f.fac].name, _counts(f.ships)])
    var merchant: bool = f.kind == "convoy" or f.ships.all(func(s): return Campaign.hull(s).kind == "merchant")
    var dry: bool = G.cargo.fuel <= 0 or int(G.crew) <= 0
    var acts := [UI.button("Exchange signals and pass", func(): f.cool = 8.0; P.cool = 3.0; close_panel(), true)]
    if merchant: acts.append(UI.button("Trade", func(): _trade(f)))
    if not merchant and dry:
        var fee := Campaign.tow_fee(); var np = Campaign.nearest_open_port()
        var tow_l: String = "Request a tow to %s · %s" % [np.name if np != null else "port", Campaign.fmt(fee)] if G.credits >= fee else "Ask for a tow to %s (you cannot pay)" % (np.name if np != null else "port")
        acts.append(UI.button(tow_l, func(): f.cool = 8.0; _toast(Campaign.take_tow(f)); close_panel(), false, np == null))
    if merchant: _p(box, "Merchant ships carry spare bunker fuel and a little of everything, and will deal at sea, at worse prices than a port.", UI.DIM, 14)
    elif dry: _p(box, ("You have no crew to raise steam." if int(G.crew) <= 0 else "Your bunkers are dry.") + " A warship can take you in tow to the nearest harbour open to you, for a fee; if you cannot pay, she will still tow you, but her flag will remember it.", UI.GOLD, 14)
    _p(box, odds + " Opening fire breaks the armistice: it costs 30 %s standing%s, and %s warships will engage you on sight for three months." % [GameData.fac[f.fac].short, (" and earns thanks from " + " and ".join(en.map(func(e): return GameData.fac[e].short))) if en.size() else "", GameData.fac[f.fac].short], UI.DIM, 13)
    acts.append(UI.button("Open fire", func():
        G.rep[f.fac] -= 30; Campaign.incident(f.fac); Diplomacy.on_open_fire(f.fac)
        for e in en: G.rep[e] = mini(100, G.rep[e] + 5)
        _toast("%s standing is now %d." % [GameData.fac[f.fac].name, G.rep[f.fac]]); _battle(f)))
    box.add_child(UI.row(acts))

## Trading with a merchant convoy at sea: a small floating market. What they carry, their own cash, and prices a
## third worse than a port's either way.
func _trade(f: Dictionary) -> void:
    var G: Dictionary = Campaign.G
    if not f.has("cash"): f.cash = 12000
    open_panel(func(box):
        box.add_child(UI.title("Trade with the " + f.name))
        _p(box, "Funds %s · Hold %d / %d · Bunkers %d / %d · Their cash %s" % [Campaign.fmt(G.credits), Campaign.cargo_used(), Campaign.cargo_cap(), int(G.cargo.fuel), Campaign.bunker_cap(), Campaign.fmt(int(f.cash))], UI.DIM, 14)
        for g in Campaign.C.GOODS:
            var gid: String = g.id; var have := int(f.cargo.get(gid, 0)); var held := int(floor(G.cargo[gid]))
            var bp := int(ceil(float(g.base) * 1.35)); var sp := int(floor(float(g.base) * 0.7))
            var room: int = Campaign.fuel_room() if gid == "fuel" else Campaign.cargo_cap() - Campaign.cargo_used()
            var can_buy := mini(mini(have, room), int(G.credits / bp)); var can_sell := mini(held, int(int(f.cash) / maxi(1, sp)))
            var nm := UI.label(g.name, UI.INK); nm.custom_minimum_size.x = 160
            box.add_child(UI.row([nm, UI.label("they have %d · buy %d · sell %d · you hold %d" % [have, bp, sp, held], UI.DIM, 13),
                UI.button("Buy %d" % mini(10, can_buy), func(): _deal(f, gid, mini(10, can_buy), bp, true), false, can_buy <= 0),
                UI.button("Buy max", func(): _deal(f, gid, can_buy, bp, true), false, can_buy <= 0),
                UI.button("Sell %d" % mini(10, can_sell), func(): _deal(f, gid, mini(10, can_sell), sp, false), false, can_sell <= 0)]))
        box.add_child(UI.row([UI.button("Done", func(): f.cool = 8.0; Campaign.G.player.cool = 3.0; close_panel(), true), UI.button("Back", func(): _hail(f))]))
    , true, 860)

func _deal(f: Dictionary, gid: String, n: int, price: int, buying: bool) -> void:
    var G: Dictionary = Campaign.G
    if n <= 0: return
    if buying: G.credits -= n * price; G.cargo[gid] += n; f.cargo[gid] = int(f.cargo.get(gid, 0)) - n; f.cash = int(f.cash) + n * price
    else: G.credits += n * price; G.cargo[gid] -= n; f.cargo[gid] = int(f.cargo.get(gid, 0)) + n; f.cash = int(f.cash) - n * price
    if gid == "fuel" and buying: G.deadWarned = false
    _trade(f)

func _contact_line(f: Dictionary) -> String:
    var km := int(f.get("contactKm", 0)); var er := Campaign.strike_reach(f.ships); var pr := Campaign.strike_reach(Campaign.G.fleet)
    var by := func(r: float) -> String: return "search planes" if r * Campaign.KM_PER_UNIT >= 240.0 else "missile ships"
    if km <= int(Campaign.CONTACT * Campaign.KM_PER_UNIT) + 5: return "Contact at about %d km, on lookouts and radar." % km
    if er >= pr: return "Contact at about %d km: their %s found you first." % [km, by.call(er)]
    return "Contact at about %d km: your %s found them first." % [km, by.call(pr)]

func _battle(f: Dictionary) -> void:
    GameData.pending = Campaign.battle_setup(f)
    Campaign.paused = true
    get_tree().change_scene_to_file("res://scenes/battle.tscn")

## The opening of a campaign: who you were, what you have, and who wants what from you.
func _show_origin() -> void:
    var G: Dictionary = Campaign.G; var key: String = G.origin; var L: Dictionary = Origins.lore(key); var info: Dictionary = Origins.INFO[key]
    open_panel(func(box):
        box.add_child(UI.title(L.get("title", info.label)))
        if G.get("navy", "") != "" and info.navy: _p(box, "Formerly of the " + GameData.fac[G.navy].name + ".", UI.DIM, 14)
        _p(box, L.get("story", ""), UI.INK, 15)
        _p(box, L.get("world", ""), UI.DIM, 14)
        if Codex.backstory(key) != "": box.add_child(Codex.rich(Codex.backstory(key), UI.GOLD, 14))
        box.add_child(_thumb(G.fleet[0].type, "player", 520, G.fleet[0].fit))
        _p(box, info.start, UI.INK, 14)
        var st = []
        for f in G.rep:
            if f == "raiders" or G.rep[f] == 0: continue
            st.append("%s %s%d" % [GameData.fac[f].short, "+" if G.rep[f] > 0 else "", G.rep[f]])
        if st.size(): _p(box, "Standing: " + " · ".join(st), UI.DIM, 13)
        for h in Campaign.perk("hunted", []): _p(box, "Hunted: %s, for some %d days." % [h.name, int(h.days)], UI.RED, 13)
        box.add_child(UI.button("Put to sea", func(): close_panel(); Campaign.paused = false, true)), true)

func _show_aftermath(r: Dictionary) -> void:
    if Campaign.G.fleet.is_empty():
        open_panel(func(box):
            box.add_child(UI.title("Struck from the list")); _p(box, "Your last ship went down with her colours flying.")
            _p(box, "You lasted %d days, until %d, and sank or captured %d ships." % [Campaign.G.day, Campaign.year(), Campaign.G.kills], UI.DIM)
            DirAccess.remove_absolute(Campaign.SAVE_PATH)
            box.add_child(UI.button("New campaign", func(): get_tree().change_scene_to_file("res://scenes/main_menu.tscn"), true)), true)
        return
    open_panel(func(box):
        box.add_child(UI.title("Victory" if r.victory else ("Disengaged" if r.retreated else "Defeat")))
        var nm = func(list): return ", ".join(list.map(func(s): return "%s (%s)" % [s.name, GameData.hulls[s.type].name]))
        if r.sunk.size(): _p(box, "Sunk: " + nm.call(r.sunk))
        if r.lost.size(): _p(box, "Lost: " + nm.call(r.lost), Color(0.95, 0.75, 0.71))
        if r.casualties: _p(box, "%s sailors killed or wounded." % Campaign.fmt(r.casualties), UI.DIM)
        if r.coin: _p(box, "Prize money: %s%s." % [Campaign.fmt(r.coin), (", plus " + r.goods) if r.goods != "" else ""])
        if r.rp: _p(box, "Research: +%d RP from salvaged equipment and documents." % r.rp)
        if r.bounty: _p(box, "Bounty paid: %s." % Campaign.fmt(r.bounty))
        for n in r.notes: _p(box, n, UI.GOLD)
        if r.prizes.size():
            box.add_child(UI.label("PRIZES", UI.DIM, 12)); _p(box, "These ships struck their colours. Each prize takes a fleet slot and needs crew. It comes in at its current condition with its weapons intact.", UI.DIM)
            for s in r.prizes:
                var h: Dictionary = GameData.hulls[s.type]
                if s.get("taken", "") != "": _p(box, "%s · %s · %s" % [s.name, h.name, s.taken], UI.GREEN); continue
                box.add_child(UI.row([UI.label("%s · %s · %d%% · needs %d crew" % [s.name, h.name, int(s.hullFrac * 100), h.crew]),
                    UI.button("Take as prize", func(): _take_prize(s), true, Campaign.G.fleet.size() >= 10),
                    UI.button("Scuttle for " + Campaign.fmt(Campaign.ship_value(s) * 0.1), func(): s.taken = "Scuttled"; Campaign.G.credits += round(Campaign.ship_value(s) * 0.1); _show_aftermath(r))]))
        box.add_child(UI.button("Return to the chart", func(): _aftermath_done(r), true))
    , true)

func _take_prize(s: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var r: Dictionary = Campaign.last_result
    s.taken = "Taken"; var ns = s.duplicate(true); ns.erase("taken"); ns.pal = "player"; ns.id = str(randi()); G.fleet.append(ns); G.kills += 1
    _toast("%s sails under your flag. She needs %d crew." % [s.name, GameData.hulls[s.type].crew])
    var study := Campaign.study_prize(ns)
    if study != "": _toast(study)
    if G.mission != null:
        var m: Dictionary = Campaign.mission_def()
        if m.goal == "capture" and s.name == m.target: Campaign._complete_mission(r)
    _show_aftermath(r)

func _aftermath_done(r: Dictionary) -> void:
    var G: Dictionary = Campaign.G
    if G.mission != null:
        var m: Dictionary = Campaign.mission_def()
        if m.goal == "capture" and r.prizes.any(func(s): return s.name == m.target and s.get("taken", "") != "Taken"):
            _toast("Without the %s the codebook is lost. Return to the %s for new orders." % [m.target, Campaign.story_office(G.mission.get("by", "concord"))]); G.mission = null; Campaign.log_ev("Mission failed: " + m.title)
    G.player.cool = 4.0; Campaign.save(); close_panel()

func open_survey(q: Dictionary) -> void:
    open_panel(func(box):
        box.add_child(UI.title("Survey: " + q.name)); _p(box, q.get("text", Campaign.C.POI_TEXT[q.type]))
        box.add_child(UI.row([UI.button("Send the divers down", func(): _do_survey(q), true, Campaign.G.day < q.next), UI.button("Leave", close_panel)])))

func _do_survey(q: Dictionary) -> void:
    var out = Campaign.do_survey(q)
    open_panel(func(box):
        box.add_child(UI.title("Survey: " + q.name))
        for l in out.lines: _p(box, l)
        if out.ambush != null: box.add_child(UI.button("Battle stations", func(): _battle(out.ambush), true))
        else: box.add_child(UI.button("Return to the chart", close_panel, true))
    , out.ambush != null)

## A ship's hull condition as a thin bar centred in its row, with a tooltip saying what it measures.
func _hull_bar(f: float) -> Control:
    var b := UI.bar(f); b.size_flags_vertical = Control.SIZE_SHRINK_CENTER; b.tooltip_text = "Hull condition: %d%% of full strength. Repair in port." % int(f * 100)
    b.mouse_filter = Control.MOUSE_FILTER_PASS
    return b

func _fleet_table(box: Control, at_port: bool) -> void:
    var G: Dictionary = Campaign.G; var need = Campaign.crew_need(); var short = maxi(0, need - int(G.crew))
    _p(box, "The first ship listed is your flagship. Crew %s of %s needed%s. Wages %s a day." % [Campaign.fmt(G.crew), Campaign.fmt(need), ", so undermanned ships reload and steam slower" if short else "", Campaign.fmt(Campaign.wages())], UI.DIM, 14)
    for i in G.fleet.size():
        var s: Dictionary = G.fleet[i]; var h: Dictionary = GameData.hulls[s.type]; var o = Campaign.officer_of(s)
        var items = [UI.label(("★ " if i == 0 else "") + s.name, UI.INK), UI.label("%s · %s class (%s)" % [h.name, h.dn, GameData.makers[h.yard].short], UI.DIM, 13), UI.label("Hull", UI.DIM, 13), _hull_bar(s.hullFrac), UI.label("%d%%" % int(s.hullFrac * 100), UI.DIM, 13),
            _captain_pick(s)]
        if at_port:
            var rc = repair_cost(s)
            items.append(UI.button("Repair " + Campaign.fmt(rc), func(): G.credits -= rc; s.hullFrac = 1.0; _rerender(), false, rc == 0 or G.credits < rc))
            items.append(UI.button("Sell " + Campaign.fmt(sell_value(s)), func(): _sell_ship(s), false, G.fleet.size() < 2))
        if i: items.append(UI.button("Flagship", func(): G.fleet.erase(s); G.fleet.push_front(s); _rerender()))
        box.add_child(UI.row(items))

# ------------------------------------------------------------------ ports (market and repairs for now)
var cur_port: Dictionary = {}
var port_tab = "market"
func repair_cost(s: Dictionary) -> int: return int(ceil((1 - s.hullFrac) * GameData.hulls[s.type].price * 0.2))
func sell_value(s: Dictionary) -> int: return int(floor(Campaign.ship_value(s) * 0.45 * (0.4 + 0.6 * s.hullFrac)))
func port_price(p: Dictionary, gid: String) -> int:
    var base = 1.0
    for g in Campaign.C.GOODS: if g.id == gid: base = g.base
    return maxi(1, int(round(base * p.mod[gid] * (1 + p.drift[gid]) * Diplomacy.price_mult(p.fac, gid))))
func buy_price(p: Dictionary, gid: String) -> int: return int(ceil(port_price(p, gid) * 1.06 * (1.1 if Campaign.G.rep.get(p.fac, 0) < 0 else 1.0) * (1.15 if Campaign.restricted(p.fac) else 1.0) * (1.0 - float(Campaign.perk("trade", 0.0)))))
func sell_price(p: Dictionary, gid: String) -> int: return int(floor(port_price(p, gid) * 0.93 * (0.9 if Campaign.restricted(p.fac) else 1.0) * (1.0 + float(Campaign.perk("trade", 0.0)))))

func open_port(p: Dictionary) -> void:
    if not Campaign.hostile(p.fac) and Campaign.G.day - p.get("offDay", -99) > 20: # the officers' mess turns over every few weeks
        p.offDay = Campaign.G.day; p.officers = [Campaign.new_officer(randi_range(1, 2)), Campaign.new_officer(randi_range(1, 3))]
        if randf() < 0.4: p.officers.append(Campaign.new_officer(randi_range(2, 4)))
    var sm = Diplomacy.smuggle_for(p)
    if Campaign.hostile(p.fac) and sm != null:   # a closed harbour, but there is a cargo to land
        open_panel(func(box):
            box.add_child(UI.title(p.name)); _p(box, "The harbour is closed to you, but your contact has named a beach and a night. Lights out, engines slow.")
            _p(box, "Chance of being caught: %d%%. Caught, the cargo is seized, %s standing falls by 12, and their warships will hunt you for three months." % [int(Diplomacy.smuggle_risk(p) * 100), GameData.fac[p.fac].short], UI.DIM, 14)
            box.add_child(UI.row([UI.button("Run the cargo ashore", func(): var t: String = Diplomacy.run_contraband(sm, p); close_panel(); _toast(t), true), UI.button("Turn away", close_panel)])))
        return
    if Campaign.hostile(p.fac):
        open_panel(func(box): box.add_child(UI.title(p.name)); _p(box, "Shore batteries track your ships as you close the harbour. %s ports are closed to you while your standing with them is this low. Raise your standing, or dock somewhere friendlier." % GameData.fac[p.fac].name); box.add_child(UI.button("Stand off", close_panel, true)))
        return
    Diplomacy.on_dock(p)
    cur_port = p; port_tab = "market"; _render_port(); Campaign.save()

func _rerender() -> void:
    if not cur_port.is_empty(): _render_port()
    else: show_command()

func _market(box: Control, p: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var free = Campaign.cargo_cap() - Campaign.cargo_used()
    _p(box, "Hold %d / %d · Funds %s · Fleet burns %.1f fuel a day underway · Bunkers %d / %d%s" % [Campaign.cargo_used(), Campaign.cargo_cap(), Campaign.fmt(G.credits), Campaign.fuel_use(), int(G.cargo.fuel), Campaign.bunker_cap(), (" (%d in oilers' tanks)" % Campaign.tank_cap()) if Campaign.tank_cap() > 0 else ""], UI.DIM, 14)
    for g in Campaign.C.GOODS:
        var gid: String = g.id; var m: float = p.mod[gid] * (1 + p.drift[gid])
        var tag = " · surplus" if m < 0.75 else (" · shortage" if m > 1.3 else "")
        var bp = buy_price(p, gid); var sp = sell_price(p, gid); var held = int(floor(G.cargo[gid]))
        var can: bool = G.credits >= bp and (Campaign.fuel_room() >= 1 if gid == "fuel" else free >= 1)
        var nm = UI.label(g.name + tag, UI.GREEN if m < 0.75 else (UI.RED if m > 1.3 else UI.INK)); nm.custom_minimum_size.x = 200
        box.add_child(UI.row([nm, UI.label("buy %d · sell %d · held %d" % [bp, sp, held], UI.DIM, 13),
            UI.button("Buy 10", func(): _buy(p, gid, 10), false, not can), UI.button("Max", func(): _buy(p, gid, -1), false, not can),
            UI.button("Sell 10", func(): _sell(p, gid, 10), false, held < 1), UI.button("Sell all", func(): _sell(p, gid, -1), false, held < 1)]))
    _p(box, "Your own trading moves local prices. Buying drives them up, selling drives them down.", UI.DIM, 13)

func _buy(p: Dictionary, gid: String, n: int) -> void:
    var G: Dictionary = Campaign.G; var bp = buy_price(p, gid)
    var free: int = Campaign.fuel_room() if gid == "fuel" else Campaign.cargo_cap() - Campaign.cargo_used()
    var k = mini(free, int(G.credits / bp)) if n < 0 else mini(mini(n, free), int(G.credits / bp))
    if k > 0: G.credits -= k * bp; G.cargo[gid] += k; p.drift[gid] = minf(0.6, p.drift[gid] + k * 0.003)
    _render_port()

func _sell(p: Dictionary, gid: String, n: int) -> void:
    var G: Dictionary = Campaign.G; var held = int(floor(G.cargo[gid])); var k = held if n < 0 else mini(n, held); var got = 0
    for i in k: got += sell_price(p, gid); p.drift[gid] = maxf(-0.5, p.drift[gid] - 0.003)
    G.credits += got; G.cargo[gid] -= k; _render_port()

func _sell_ship(s: Dictionary) -> void:
    var G: Dictionary = Campaign.G
    G.credits += sell_value(s); G.fleet.erase(s)
    var left := Structures.trim_troops()
    if left > 0: _toast("%d soldiers had no berth left and were paid off." % left)
    for o in G.officers:
        if o.ship == s.id: o.ship = null
    _rerender()

func _repair_all(total: int) -> void:
    var G: Dictionary = Campaign.G
    G.credits -= total
    for s in G.fleet: s.hullFrac = 1.0
    _render_port()

# ------------------------------------------------------------------ port and command panels
var cmd_tab = "fleet"
var refit_idx = 0

func _tabs(box: Control, tabs: Array, cur: String, cb: Callable) -> void:
    box.add_child(UI.tabs(tabs, cur, cb))

func _render_port() -> void:
    var p = cur_port; var G: Dictionary = Campaign.G
    var tabs = [["market", "Market"], ["contracts", "Contracts"], ["yard", "Shipyard"], ["refit", "Refit"], ["fleet", "Repairs & crew"], ["officers", "Officers"]]
    if p.capital and Diplomacy.D.commissions.has(p.fac): tabs.append(["commission", "Commission"])
    if p.capital and not Campaign.story_chain(p.fac).is_empty(): tabs.append(["admiralty", Campaign.story_office(p.fac)])
    if p.capital and p.fac == "concord": tabs.append(["research", "Research"])
    elif p.fac == "enclave": tabs.append(["research", "Research exchange"])
    if not Structures.store_of(p).is_empty(): tabs.insert(1, ["warehouse", "Warehouse"])
    var limited: bool = Campaign.restricted(p.fac)
    if limited: # your old flag: the market and the dockyard's repair berth, nothing more, and at a price
        tabs = tabs.filter(func(t): return t[0] == "market" or t[0] == "fleet" or t[0] == "contracts" or t[0] == "warehouse")
        if not ["market", "fleet"].has(port_tab): port_tab = "market"
    open_panel(func(box):
        box.add_child(UI.title(p.name))
        _p(box, "%s%s · %d, day %d · Funds %s" % [GameData.fac[p.fac].name, " · capital" if p.capital else "", Campaign.year(), G.day, Campaign.fmt(G.credits)], UI.DIM, 14)
        var att: String = Codex.profile(p.fac).get("Attitude toward independents", "")
        if att != "": box.add_child(Codex.rich("*" + att + "*", UI.DIM, 13))
        if p.get("rumour", "") != "": box.add_child(Codex.rich("Rumour has it: " + p.rumour, UI.GOLD, 13))
        if limited: _p(box, "Your old service remembers you. The harbourmaster will sell you stores and berth you for repairs, at a price, but the shipyard, the officers' mess and the Admiralty are closed to you.", UI.GOLD, 14)
        _tabs(box, tabs, port_tab, func(k): port_tab = k; _render_port())
        match port_tab:
            "market": _market(box, p)
            "yard": _yard(box, p)
            "refit": _refit(box)
            "fleet": _repairs(box)
            "officers": _officers(box, p)
            "admiralty": _missions(box, true, p.fac)
            "contracts": _contracts(box, p)
            "commission": _commission(box, p)
            "research": _research(box)
            "warehouse":
                _p(box, "Goods from your holdings ashore, kept here for you. Load them into the hold, or sell them at this port's price.", UI.DIM, 14)
                _store_rows(box, p, true, p.name, p)
        box.add_child(UI.button("Put to sea", func(): cur_port = {}; G.player.cool = maxf(G.player.cool, 2.5); Campaign.save(); close_panel(), true))
    , false, 960, "port:%s:%s:%d" % [p.name, port_tab, refit_idx])

func show_command() -> void:
    cur_port = {}
    open_panel(func(box):
        box.add_child(UI.title(str(CMD_TABS.filter(func(t): return t[0] == cmd_tab)[0][1])))
        match cmd_tab:
            "fleet": _fleet_table(box, false)
            "officers": _officers(box, {})
            "research": _research(box)
            "missions": _missions(box, false)
            "holdings": _holdings(box)
            "codex": Codex.build(box, codex_tab, func(k): codex_tab = k; show_command())
            "hold":
                for g in Campaign.C.GOODS: box.add_child(UI.row([UI.label(g.name), UI.label(str(int(floor(Campaign.G.cargo[g.id]))), UI.DIM)]))
                _p(box, "%d / %d used. %d enemy ships sunk or taken." % [Campaign.cargo_used(), Campaign.cargo_cap(), Campaign.G.kills], UI.DIM, 14)
        box.add_child(UI.row([UI.button("Close", close_panel, true)]))   # save and exit live in the pause menu (Esc)
    , false, 960, "cmd:" + cmd_tab)

func _repairs(box: Control) -> void:
    var G: Dictionary = Campaign.G
    _fleet_table(box, true)
    var total = 0
    for s in G.fleet: total += repair_cost(s)
    var short = maxi(0, Campaign.crew_need() - int(G.crew))
    var arm := 0; var low := 1.0
    for s in G.fleet: arm += Campaign.rearm_cost(s); low = minf(low, float(s.get("ammo", 1.0)))
    if low < 0.999: _p(box, "Magazines: the emptiest ship is %d%% full." % int(low * 100), UI.GOLD if low < 0.5 else UI.DIM, 14)
    box.add_child(UI.row([UI.button("Rearm all · " + Campaign.fmt(arm), func():
        G.credits -= arm
        for s in G.fleet: s.ammo = 1.0
        _toast("Magazines filled."); _render_port(), false, arm == 0 or G.credits < arm)]))
    box.add_child(UI.row([UI.button("Repair all · " + Campaign.fmt(total), func(): _repair_all(total), false, total == 0 or G.credits < total),
        UI.button("Hire %s crew · %s" % [Campaign.fmt(short), Campaign.fmt(short * 25)], func(): G.credits -= short * 25; G.crew += short; _render_port(), false, short == 0 or G.credits < short * 25),
        UI.button("Hire 50 spare · 1,250", func(): G.credits -= 1250; G.crew += 50; _render_port(), false, G.credits < 1250)]))
    var cap := Structures.troop_capacity(); var men := Structures.troops()
    if cap > 0 or men > 0:
        box.add_child(UI.label("TROOPS", UI.DIM, 12))
        _p(box, "%s soldiers embarked, berths for %s in your transports. A soldier costs %d to raise and equip, draws %.1f a day and eats with the crew. Land them on a structure from its panel on the chart." % [Campaign.fmt(men), Campaign.fmt(cap), Structures.TROOP_COST, Structures.TROOP_WAGE], UI.DIM, 14)
        var room := cap - men
        box.add_child(UI.row([UI.button("Embark 100 · " + Campaign.fmt(mini(100, room) * Structures.TROOP_COST), func(): Structures.embark(100); _render_port(), false, room <= 0 or G.credits < Structures.TROOP_COST),
            UI.button("Fill the berths (%s) · %s" % [Campaign.fmt(room), Campaign.fmt(room * Structures.TROOP_COST)], func(): Structures.embark(room); _render_port(), false, room <= 0 or G.credits < Structures.TROOP_COST),
            UI.button("Put them ashore", func(): _toast("%d soldiers paid off." % Structures.disembark()); _render_port(), false, men <= 0)]))
    var ae: Array = Campaign.aux("ammo"); var ar: Array = Campaign.aux("repair")
    if not ae.is_empty() or not ar.is_empty():
        box.add_child(UI.label("REPLENISHMENT AT SEA", UI.DIM, 12))
        if not ae.is_empty():
            _p(box, "%s: passes shells across at sea, 40 tons of munitions a day from the holds (%d tons aboard). A full reload of the whole squadron takes about %d tons." % [", ".join(ae.map(func(s): return s.name)), int(G.cargo.munitions), int(_full_reload_tons())], UI.DIM, 14)
        if not ar.is_empty():
            _p(box, "%s: patches hulls at sea up to 75%%, 15 tons of steel a day from the holds (%d tons aboard)." % [", ".join(ar.map(func(s): return s.name)), int(G.cargo.steel)], UI.DIM, 14)
    var rc := Structures.replace_cost()
    if Structures.air_group() > 0 or rc > 0:
        _p(box, "Air groups: %d aircraft aboard your carriers%s." % [Structures.air_group(), (", %d short" % (rc / Structures.plane_cost())) if rc > 0 else ", at full strength"], UI.DIM, 14)
        box.add_child(UI.row([UI.button("Replace aircraft · " + Campaign.fmt(rc), func(): G.credits -= rc; Structures.replace_planes(); _render_port(), false, rc == 0 or G.credits < rc)]))

func _full_reload_tons() -> float:
    var t := 0.0
    for s in Campaign.G.fleet:
        var w := 0.0
        for wid in s.fit: if wid != null and wid != "" and GameData.weapons.has(wid): w += float(GameData.weapons[wid].price)
        t += w * 0.15 / Campaign.AMMO_TONS
    return t

func _captain_pick(s: Dictionary) -> OptionButton:
    var ob = OptionButton.new(); ob.add_item("(no captain)"); ob.set_item_metadata(0, "")
    var G: Dictionary = Campaign.G; var sel = 0
    for o in G.officers:
        ob.add_item("%s · L%d" % [o.name, o.lvl]); ob.set_item_metadata(ob.item_count - 1, o.id)
        if o.ship == s.id: sel = ob.item_count - 1
    ob.selected = sel
    ob.item_selected.connect(func(i):
        for o in G.officers:
            if o.ship == s.id: o.ship = null
        var oid = ob.get_item_metadata(i)
        for o in G.officers:
            if o.id == oid: o.ship = s.id
        _rerender())
    return ob

# shipyard: the classes a flag builds, in every design its own shipbuilders offer at your technology level
func yard_of(p: Dictionary) -> Array:
    if Campaign.test_mode():   # test mode: every design, in every port
        var all := []
        for id in GameData.hulls: if Campaign.design_ok(id, Campaign.G.tech): all.append(id)
        all.sort_custom(func(a, b): return GameData.hull_order.find(GameData.hulls[a].klass) * 10000 + GameData.hulls[a].year < GameData.hull_order.find(GameData.hulls[b].klass) * 10000 + GameData.hulls[b].year)
        return all
    var makers: Array = GameData.fac_makers.get(p.fac, []) if GameData.fac_makers.get(p.fac) != null else []
    var out = []
    for c in Campaign.C.YARDS[p.fac]:
        if (c == "bb" or c == "cv") and not p.capital: continue
        for id in Campaign.C.DESIGNS_OF.get(c, []):
            if makers.has(GameData.hulls[id].yard) and Campaign.design_ok(id, Campaign.G.tech): out.append(id)
    if p.fac == "freeport":   # the Syndicate's improvised carriers: escort carriers bought second-hand from any yard and refitted
        for id in Campaign.C.DESIGNS_OF.get("cve", []): if Campaign.design_ok(id, Campaign.G.tech) and not out.has(id): out.append(id)
    out.sort_custom(func(a, b): return GameData.hull_order.find(GameData.hulls[a].klass) * 10000 + GameData.hulls[a].year < GameData.hull_order.find(GameData.hulls[b].klass) * 10000 + GameData.hulls[b].year)
    return out
## What an auxiliary does for the squadron, for the yard's listing.
func _aux_text(h: Dictionary) -> String:
    var t := ""
    if int(h.get("troops", 0)) > 0: t += " · berths for %s soldiers" % Campaign.fmt(int(h.troops))
    if int(h.get("tank", 0)) > 0: t += " · carries %d tons of fuel oil beyond the bunkers" % int(h.tank)
    if h.get("ammo", false): t += " · rearms the squadron at sea from munitions in the holds"
    if h.get("repair", false): t += " · patches hulls at sea with steel from the holds"
    if h.get("nuc", false) or (h.kind == "sub" and float(h.fuel) <= 0.0): t += " · nuclear: burns no fuel oil"
    return t
func ship_price(p: Dictionary, t: String) -> int: return int(round(GameData.hulls[t].price * (1.1 if p.fac == "freeport" else 1.0) * (0.9 if Campaign.G.rep.get(p.fac, 0) > 30 else 1.0)))

func _thumb(id: String, pal: String, w: float, fit = null) -> Control:
    var t = ShipThumb.new(); t.id = id; t.pal = pal; t.fit = fit; var info: Dictionary = GameData.sprites.ships[id]
    t.custom_minimum_size = Vector2(w, w * info.h / info.w + 4); return t

## A ship's plan with its armament, for panels.
class ShipThumb extends Control:
    var id = ""
    var pal = "player"
    var fit = null
    var sel := -1          # a mount to ring in gold (the one being refitted), or -1
    var guns: Control
    func _ready() -> void:
        texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
        guns = ThumbMounts.new(); guns.thumb = self; guns.material = GameData.mount_material(pal); guns.mouse_filter = Control.MOUSE_FILTER_IGNORE
        guns.set_anchors_preset(Control.PRESET_FULL_RECT); add_child(guns)
        if sel >= 0:
            var hl := ThumbHighlight.new(); hl.thumb = self; hl.mouse_filter = Control.MOUSE_FILTER_IGNORE; hl.set_anchors_preset(Control.PRESET_FULL_RECT); add_child(hl)
    ## Pixels per metre: the plan drawn as large as fits inside this box (a box stretched wider by its container
    ## no longer makes the ship spill out above and below it).
    func px_per_m() -> float:
        var info: Dictionary = GameData.sprites.ships[id]
        return minf(size.x / float(info.w), (size.y - 4.0) / float(info.h))
    func _draw() -> void:
        var info: Dictionary = GameData.sprites.ships[id]
        var k = px_per_m()   # pixels per metre: the plan fits inside the box, whatever the box's shape
        var c = size / 2
        for layer in ["base", "top"]:
            var t = GameData.ship_tex(id, pal, layer); draw_texture_rect(t, Rect2(c - Vector2(info.w, info.h) * k / 2, Vector2(info.w, info.h) * k), false)
        if guns: guns.queue_redraw()

## A gold ring round the mount being refitted, pulsing gently, with corner ticks so it reads on any deck.
class ThumbHighlight extends Control:
    var thumb
    func _process(_d: float) -> void: queue_redraw()
    func _draw() -> void:
        var d: Dictionary = GameData.hulls[thumb.id]; var info: Dictionary = GameData.sprites.ships[thumb.id]
        if thumb.sel < 0 or thumb.sel >= d.slots.size(): return
        var sl: Dictionary = d.slots[thumb.sel]; var k: float = thumb.px_per_m(); var c: Vector2 = size / 2 + Vector2(sl.x, sl.y) * k
        var wid = thumb.fit[thumb.sel] if thumb.fit != null else sl.def
        var w: Dictionary = GameData.weapons.get(wid if wid != null else "", {})
        var r := maxf(9.0, maxf(float(w.get("tw", 3.0)), float(w.get("tl", 3.0))) * 0.75 * k + 5.0)
        var pulse := 0.65 + 0.35 * sin(Time.get_ticks_msec() * 0.006)
        draw_arc(c, r + 3.0, 0, TAU, 40, Color(0.89, 0.7, 0.24, 0.25 * pulse), 6.0)
        draw_arc(c, r, 0, TAU, 40, Color(0.95, 0.78, 0.3, 0.95 * pulse), 2.0)
        for q in 4:
            var a := q * PI / 2 + PI / 4; var p0 := c + Vector2.from_angle(a) * (r + 5.0)
            draw_line(p0, p0 + Vector2.from_angle(a) * 6.0, Color(0.95, 0.78, 0.3, pulse), 2.0)

## The armament over a thumbnail, lit by the mount shader in the yard's national style.
class ThumbMounts extends Control:
    var thumb
    func _draw() -> void:
        var id: String = thumb.id; var fit = thumb.fit
        var info: Dictionary = GameData.sprites.ships[id]; var d: Dictionary = GameData.hulls[id]
        var k = thumb.px_per_m(); var c = size / 2; var style := GameData.style_of(id)
        for i in d.slots.size():
            var sl: Dictionary = d.slots[i]; var wid = fit[i] if fit != null else sl.def
            if wid == null or wid == "" or not GameData.sprites.mounts.has(wid): continue
            if d.kind == "sub" and sl.s == "T": continue
            var mi: Dictionary = GameData.sprites.mounts[wid]; var sc: float = k / mi.spr; var ta: float = sl.arcs[0][0]
            draw_set_transform(c + Vector2(sl.x, sl.y) * k, ta, Vector2(sc, sc))
            var o = -Vector2(mi.ox, mi.oy) * mi.spr; var code := GameData.mount_code(Vector2(0.55, 0.85).rotated(-ta), 0)
            if mi.get("split", false): draw_texture(GameData.mount_img(wid, style, true), o, code)
            draw_texture(GameData.mount_img(wid, style), o, code)
        draw_set_transform(Vector2.ZERO)

func _yard(box: Control, p: Dictionary) -> void:
    var G: Dictionary = Campaign.G
    _p(box, "Funds %s · Fleet %d / 10. New ships arrive with standard armament, and you can refit them afterwards." % [Campaign.fmt(G.credits), G.fleet.size()], UI.DIM, 14)
    for t in yard_of(p):
        var h: Dictionary = GameData.hulls[t]; var pr = ship_price(p, t)
        var fit: Array = BattleSim.default_fit(h, G.tech); var arms = {}
        for w in fit: if w != "": arms[GameData.weapons[w].name] = arms.get(GameData.weapons[w].name, 0) + 1
        var col = VBoxContainer.new(); col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
        col.add_child(UI.label("%s · %s class · %s %s" % [h.name, h.dn, h.cls, ("· era %d" % h.era) if h.era > 1 else ""], UI.INK, 16))
        col.add_child(UI.label("%s · %d · modelled on the %s" % [GameData.makers[h.yard].name, h.year, h.model], UI.DIM, 13, true))
        col.add_child(UI.label("%s t · %s m · %s kn · turning circle %s m · belt %d mm · Hull %d · Crew %s · Cargo %d%s%s" % [Campaign.fmt(h.t), str(h.L), str(h.kn), Campaign.fmt(h.td), h.armor, h.hull, Campaign.fmt(h.crew), h.cargo, (" · %d air squadrons" % h.hangar) if h.get("hangar", 0) else "", " · sonar" if h.get("sonar", false) else ""] + _aux_text(h), UI.DIM, 13, true))
        col.add_child(UI.label(", ".join(arms.keys().map(func(k): return "%d× %s" % [arms[k], k])), UI.DIM, 13, true))
        col.add_child(UI.button("Buy · " + Campaign.fmt(pr), func():
            if G.credits >= pr and G.fleet.size() < 10:
                G.credits -= pr; var s = Campaign.new_ship(t, null, "player", G.tech); G.fleet.append(s); _toast("%s (%s) commissioned. Hire crew for her." % [s.name, h.name])
            _render_port(), false, G.credits < pr or G.fleet.size() >= 10))
        var row = HBoxContainer.new(); row.add_theme_constant_override("separation", 14); row.add_child(_thumb(t, "player", 300, fit)); row.add_child(col); box.add_child(row)
        box.add_child(HSeparator.new())
    var mk: Array = GameData.fac_makers.get(p.fac, []) if GameData.fac_makers.get(p.fac) != null else []
    _p(box, "Shipbuilders here: " + ", ".join(mk.map(func(m): return GameData.makers[m].name)) + ". " + " ".join(mk.map(func(m): return GameData.makers[m].desc)), UI.DIM, 13)
    if p.fac == "freeport": _p(box, "Improvised carriers: the Syndicate buys escort carriers second-hand from any yard that will sell, no questions asked, and refits them here for anyone who can pay.", UI.DIM, 13)
    if Campaign.era_of(G.tech) < 3: _p(box, "Newer designs appear here as your research reaches the next era.", UI.DIM, 13)

## Refit: weapons chosen here form a plan for the ship; nothing is bought until the refit is confirmed. Undo discards
## the plan, Standard fit plans the design's own armament, and the card shows the selected mount against what is fitted.
var refit_plan := {}   # ship id -> planned fit
var refit_sel := 0     # slot shown on the weapon card
func _refit(box: Control) -> void:
    var G: Dictionary = Campaign.G
    refit_idx = clampi(refit_idx, 0, G.fleet.size() - 1); var s: Dictionary = G.fleet[refit_idx]; var d: Dictionary = GameData.hulls[s.type]
    var plan: Array = refit_plan.get(s.id, s.fit.duplicate()); refit_plan[s.id] = plan
    refit_sel = clampi(refit_sel, 0, d.slots.size() - 1)
    _p(box, "Choose a weapon for any mount, then confirm the refit. Old weapons sell back for half their price. Smaller guns fit larger mounts.", UI.DIM, 14)
    var picks = HBoxContainer.new()
    for i in G.fleet.size():
        var k = i
        picks.add_child(UI.button(G.fleet[i].name, func(): refit_idx = k; refit_sel = 0; _render_port(), i == refit_idx))
    box.add_child(picks)
    var th = _thumb(s.type, "player", 520, plan); th.sel = refit_sel; box.add_child(th)
    box.add_child(UI.label("%s · %s · %s class (%s) · %s t · %s kn · belt %d mm · Hull %d" % [s.name, d.name, d.dn, GameData.makers[d.yard].short, Campaign.fmt(d.t), str(d.kn), d.armor, d.hull], UI.INK, 15))
    var sizes = {"S": "Small gun", "M": "Medium gun", "L": "Large gun", "H": "Heavy gun", "A": "AA / PD", "T": "Torpedo", "V": "Launch cells"}
    var body = HBoxContainer.new(); body.add_theme_constant_override("separation", 18)
    var rows = VBoxContainer.new(); body.add_child(rows)
    for i in d.slots.size():
        var sl: Dictionary = d.slots[i]; var cur: String = plan[i] if plan[i] != null else ""; var fitted: String = s.fit[i] if s.fit[i] != null else ""
        var lab: String = sizes[sl.s] + (" · fwd" if sl.x > 10 else (" · aft" if sl.x < -10 else " · mid"))
        var ob = OptionButton.new(); ob.add_item("(empty)"); ob.set_item_metadata(0, "")
        for wid in GameData.weapons:
            var w: Dictionary = GameData.weapons[wid]
            if not _fits(wid, sl.s) or not Campaign.tech_ok(w.get("tech"), G.tech): continue
            ob.add_item(w.name + ("" if wid == fitted else " · " + Campaign.fmt(w.price))); ob.set_item_metadata(ob.item_count - 1, wid)
            if wid == cur: ob.selected = ob.item_count - 1
        var idx = i; ob.custom_minimum_size.x = 290
        ob.item_selected.connect(func(j): plan[idx] = ob.get_item_metadata(j); refit_sel = idx; _render_port())
        ob.pressed.connect(func(): if refit_sel != idx: refit_sel = idx; call_deferred("_render_port"))
        var l = UI.label(("▸ " if i == refit_sel else "") + lab + (" *" if cur != fitted else ""), UI.INK if i == refit_sel else UI.DIM, 14); l.custom_minimum_size.x = 180
        var info = UI.button("Details", func(): refit_sel = idx; _render_port(), i == refit_sel)
        rows.add_child(UI.row([l, ob, info]))
    body.add_child(_weapon_card(s, plan, refit_sel))
    box.add_child(body)
    # what the plan costs, and the buttons to act on it
    var buy := 0; var refund := 0; var changes := 0
    for i in d.slots.size():
        var a: String = s.fit[i] if s.fit[i] != null else ""; var b: String = plan[i] if plan[i] != null else ""
        if a == b: continue
        changes += 1
        if b != "": buy += int(GameData.weapons[b].price)
        if a != "": refund += int(GameData.weapons[a].price / 2)
    var net: int = buy - refund
    if changes: _p(box, "%d mount%s changed · new weapons %s · sold back %s · %s %s" % [changes, "" if changes == 1 else "s", Campaign.fmt(buy), Campaign.fmt(refund), "net cost" if net >= 0 else "net refund", Campaign.fmt(absi(net))], UI.INK, 14)
    var can: bool = changes > 0 and G.credits >= net
    var confirm = UI.button(("Confirm refit · " + Campaign.fmt(net)) if net > 0 else "Confirm refit", func():
        G.credits -= net; s.fit = plan.duplicate(); refit_plan.erase(s.id); _toast("%s refitted." % s.name); _render_port(), true, not can)
    var undo = UI.button("Undo changes", func(): refit_plan.erase(s.id); _render_port(), false, changes == 0)
    var std = UI.button("Standard fit", func(): refit_plan[s.id] = BattleSim.default_fit(d, G.tech); _render_port())
    box.add_child(UI.row([confirm, undo, std]))
    if changes and G.credits < net: _p(box, "You need %s more for this refit." % Campaign.fmt(net - G.credits), UI.RED, 14)
    _systems(box, s)

## Ship systems: machinery, hull, magazine protection, fire control, radar and sonar, each fitted in two marks.
func _systems(box: Control, s: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var d: Dictionary = GameData.hulls[s.type]
    if not s.has("up"): s.up = {}
    box.add_child(UI.label("SHIP SYSTEMS", UI.DIM, 12))
    _p(box, "Yard work on the %s herself: fitted at once, paid now, and kept for the life of the ship." % s.name, UI.DIM, 13)
    for k in BattleSim.UPGRADES:
        var u: Dictionary = BattleSim.UPGRADES[k]; var lvl: int = int(s.up.get(k, 0))
        if u.get("needs_sonar", false) and not d.get("sonar", false): continue
        var name_l := UI.label(u.name, UI.INK, 14); name_l.custom_minimum_size.x = 170
        var mk := UI.label(["standard", "Mk I", "Mk II"][lvl], UI.GREEN if lvl > 0 else UI.DIM, 13); mk.custom_minimum_size.x = 70
        var eff := UI.label(u.per + " per mark", UI.DIM, 12); eff.custom_minimum_size.x = 300
        if lvl >= 2: box.add_child(UI.row([name_l, mk, eff, UI.label("fully fitted", UI.DIM, 12)])); continue
        var cost := int(round(float(d.price) * float(u.cost) * (1.0 if lvl == 0 else 1.8) / 100.0) * 100)
        var needs: String = u.get("mk2", "") if lvl == 1 else ""
        var locked: bool = needs != "" and not G.tech.has(needs)
        var b := UI.button("Fit Mk %s · %s" % ["I" if lvl == 0 else "II", Campaign.fmt(cost)], func():
            G.credits -= cost; s.up[k] = lvl + 1; _toast("%s: %s Mk %s fitted." % [s.name, u.name, "I" if lvl == 0 else "II"]); _render_port(), false, locked or G.credits < cost)
        if locked: b.tooltip_text = "Mk II needs the research: " + needs
        box.add_child(UI.row([name_l, mk, eff, b]))

## A card for the weapon planned in one mount: its picture in the builder's style, its figures, and how it compares
## with the weapon fitted there now.
func _weapon_card(s: Dictionary, plan: Array, i: int) -> Control:
    var col = VBoxContainer.new(); col.custom_minimum_size.x = 300
    var wid: String = plan[i] if plan[i] != null else ""; var was: String = s.fit[i] if s.fit[i] != null else ""
    if wid == "": col.add_child(UI.label("Mount left empty.", UI.DIM, 14)); return col
    var w: Dictionary = GameData.weapons[wid]
    col.add_child(UI.label(w.name, UI.INK, 16))
    var pic = MountPicture.new(); pic.wid = wid; pic.style = GameData.style_of(s.type); pic.custom_minimum_size = Vector2(300, 120); pic.material = GameData.mount_material("player")
    col.add_child(pic)
    for line in _weapon_lines(w, GameData.weapons.get(was, {}) if was != wid else {}): col.add_child(UI.label(line, UI.DIM, 13))
    col.add_child(UI.label(("Fitted now: " + GameData.weapons[was].name) if was != "" and was != wid else ("Fitted now" if was == wid else "Mount empty now"), UI.DIM, 13))
    return col

func _weapon_lines(w: Dictionary, o: Dictionary) -> Array:
    var cmp = func(k: String, v: float, better_low := false) -> String:
        if o.is_empty() or not o.has(k): return ""
        var dv: float = v - float(o[k])
        if absf(dv) < 0.001: return ""
        return "  (%s%s, %s)" % ["+" if dv > 0 else "", str(snappedf(dv, 0.01)), "better" if (dv > 0) != better_low else "worse"]
    var out = []
    match w.kind:
        "gun":
            out.append("Shell damage %d × %d barrel%s%s" % [w.dmg, w.barrels, "" if w.barrels == 1 else "s", cmp.call("dmg", w.dmg)])
            out.append("Reload %s s%s · %d per minute a mount" % [str(w.rel), cmp.call("rel", w.rel, true), int(60.0 / w.rel * w.barrels)])
            out.append("Weight of fire %d a minute" % int(w.dmg * w.barrels * 60.0 / w.rel))
            out.append("Range %s m%s · shell %d m/s" % [Campaign.fmt(w.range), cmp.call("range", w.range), w.speed])
            if w.get("aa", 0) > 0: out.append("Anti-aircraft %d%s" % [int(w.aa * 100), cmp.call("aa", w.aa)])
            out.append("Gunhouse %s × %s m" % [str(w.tw), str(w.tl)])
        "aa":
            out.append("Anti-aircraft %d · point defence %d" % [int(w.aa * 100), int(w.get("pd", 0) * 100)])
            out.append("Range %s m · %d barrel%s" % [Campaign.fmt(w.range), w.barrels, "" if w.barrels == 1 else "s"])
        "torp":
            out.append("Warhead %d · %d tubes%s" % [w.dmg, w.count, " · homing" if w.get("homing", false) else ""])
            out.append("Range %s m · %d kn · reload %d s" % [Campaign.fmt(w.range), w.speed, w.rel])
        _:
            out.append("Damage %d · range %s m · reload %d s" % [w.dmg, Campaign.fmt(w.range), w.rel])
            if w.get("aa", 0) > 0: out.append("Air defence %d · point defence %d" % [int(w.aa * 100), int(w.get("pd", 0) * 100)])
    out.append("Price %s" % Campaign.fmt(w.price))
    return out

## A mount drawn large, lit by the mount shader, barrels to the right.
class MountPicture extends Control:
    var wid := ""
    var style := "us"
    func _draw() -> void:
        if not GameData.sprites.mounts.has(wid): return
        var mi: Dictionary = GameData.sprites.mounts[wid]
        var k: float = minf(size.x / mi.w, size.y / mi.h) * 0.92 # pixels per metre
        var sc: float = k / mi.spr; var c = size / 2
        draw_set_transform(c - Vector2(mi.w / 2 - mi.ox, 0) * k, 0.0, Vector2(sc, sc))
        var o = -Vector2(mi.ox, mi.oy) * mi.spr; var code := GameData.mount_code(Vector2(0.55, 0.85), 0)
        if mi.get("split", false): draw_texture(GameData.mount_img(wid, style, true), o, code)
        draw_texture(GameData.mount_img(wid, style), o, code)
        draw_set_transform(Vector2.ZERO)

func _fits(wid: String, slot: String) -> bool:
    var w: Dictionary = GameData.weapons[wid]; var gs = ["S", "M", "L", "H"]
    if gs.has(slot): return gs.has(w.size) and gs.find(w.size) <= gs.find(slot) and gs.find(w.size) >= gs.find(slot) - 1
    return w.size == slot

func _officers(box: Control, p: Dictionary) -> void:
    var G: Dictionary = Campaign.G
    if not p.is_empty():
        box.add_child(UI.label("OFFICERS' MESS AT " + p.name.to_upper(), UI.DIM, 12))
        if p.officers.is_empty(): _p(box, "Nobody is looking for a berth today.", UI.DIM, 14)
        for i in p.officers.size():
            var o: Dictionary = p.officers[i]; var cost: int = 3000 * o.lvl
            var sk = []
            for k in Campaign.C.SKILLS: if o.sk[k]: sk.append("%s %d" % [Campaign.C.SKILLS[k][0], o.sk[k]])
            box.add_child(UI.row([UI.label("%s · level %d" % [o.name, o.lvl], UI.INK), UI.label((" · ".join(sk) if sk.size() else "Green, but eager") + " · salary %d a day" % (40 * o.lvl), UI.DIM, 13),
                UI.button("Sign on · " + Campaign.fmt(cost), func():
                    G.credits -= cost; p.officers.erase(o); var free = null
                    for s in G.fleet:
                        if Campaign.officer_of(s) == null: free = s; break
                    if free != null: o.ship = free.id
                    G.officers.append(o); _toast(o.name + " signs on" + ((" and takes command of " + free.name) if free != null else "") + ".")
                    _render_port(), false, G.credits < cost)]))
    box.add_child(UI.label("YOUR OFFICERS", UI.DIM, 12))
    if G.officers.is_empty(): _p(box, "No officers yet.", UI.DIM, 14)
    for o in G.officers:
        var sh = null
        for s in G.fleet: if s.id == o.ship: sh = s
        box.add_child(UI.label("%s · level %d%s · %s · XP %d/%d" % [o.name, o.lvl, (" · %d point%s to spend" % [o.pts, "s" if o.pts > 1 else ""]) if o.pts else "", ("Commands " + sh.name) if sh != null else "Ashore, no command", o.xp, o.lvl * 100], UI.GOLD if o.pts else UI.INK))
        var row = HBoxContainer.new(); row.add_theme_constant_override("separation", 14)
        for k in Campaign.C.SKILLS:
            var key: String = k
            row.add_child(UI.label("%s %s%s" % [Campaign.C.SKILLS[k][0], "■".repeat(o.sk[k]), "□".repeat(3 - o.sk[k])], UI.DIM, 13))
            if o.pts and o.sk[k] < 3: row.add_child(UI.button("+", func(): o.sk[key] += 1; o.pts -= 1; _rerender()))
        row.add_child(UI.button("Dismiss", func(): G.officers.erase(o); _rerender()))
        box.add_child(row)
    _p(box, ". ".join(Campaign.C.SKILLS.values().map(func(v): return v[0] + ": " + v[1].to_lower())) + ".", UI.DIM, 13)

func rp_price(p: Dictionary) -> int: return 6000 if p.get("fac") == "enclave" else (8000 if p.get("capital", false) and p.get("fac") == "concord" else 0)

func _research(box: Control) -> void:
    var G: Dictionary = Campaign.G; var pr = rp_price(cur_port) if not cur_port.is_empty() else 0
    _p(box, "%d research points available. You earn them by sinking and capturing ships, surveying sites and completing missions." % G.rp, UI.DIM, 14)
    if pr: box.add_child(UI.button(("The enclave trades research data" if cur_port.fac == "enclave" else "The Admiralty sells research") + ": buy 10 RP · " + Campaign.fmt(pr), func(): G.credits -= pr; G.rp += 10; _rerender(), false, G.credits < pr))
    _p(box, "You: %s." % Campaign.C.ERA_NAME[str(Campaign.player_era())])
    var eras := []
    for f in Campaign.RESEARCH_PACE: if GameData.fac.has(f): eras.append("%s %s" % [GameData.fac[f].short, ["I", "II", "III"][Campaign.fac_era(f) - 1]])
    _p(box, "Each power runs its own Quiet Race; their fleets carry what their own research has reached. Eras now: " + " · ".join(eras) + ".", UI.DIM, 13)
    var pe := Campaign.player_era(); var shown_era := 0
    for t in Campaign.C.TECH:
        if int(t.era) != shown_era:   # each era: a header, and how far you are from opening the next
            shown_era = int(t.era)
            box.add_child(UI.label(String(Campaign.C.ERA_NAME[str(shown_era)]).to_upper() + ("" if pe >= shown_era else "  ·  NOT YET OPEN"), UI.DIM, 12))
            if shown_era < 3:
                var have := Campaign.era_count(G.tech, shown_era)
                var nxt: String = String(Campaign.C.ERA_NAME[str(shown_era + 1)]).split(" · ")[0]
                _p(box, ("%s is open." % nxt) if have >= Campaign.ERA_GATE and pe >= shown_era else ("%s opens when you have researched %d of these %s technologies: %d of %d so far." % [nxt, Campaign.ERA_GATE, String(Campaign.C.ERA_NAME[str(shown_era)]).split(" · ")[0], mini(have, Campaign.ERA_GATE), Campaign.ERA_GATE]), UI.GOLD if have < Campaign.ERA_GATE and pe == shown_era else UI.DIM, 13)
        var done: bool = G.tech.has(t.id); var ok: bool = t.req.all(func(r): return G.tech.has(r)) and int(t.era) <= pe
        var col = VBoxContainer.new(); col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
        col.add_child(UI.label("%s · era %d" % [t.name, t.era], UI.GREEN if done else (UI.INK if ok else UI.DIM)))
        col.add_child(UI.label(t.desc, UI.DIM, 13, true))
        var act: Control
        if done: act = UI.label("Researched", UI.GREEN, 13)
        elif ok: act = UI.button("Research · %d RP" % t.cost, func():
            G.rp -= t.cost; G.tech.append(t.id); _toast("Research complete: %s." % t.name); Campaign.log_ev("Researched " + t.name); _rerender(), false, G.rp < t.cost)
        elif int(t.era) > pe: act = UI.label("Opens with %s" % String(Campaign.C.ERA_NAME[str(int(t.era))]).split(" · ")[0], UI.DIM, 13)
        else: act = UI.label("Requires " + ", ".join(t.req.map(func(r): return Campaign.C.TECH.filter(func(x): return x.id == r)[0].name)), UI.DIM, 13)
        box.add_child(UI.row([col, act]))

func _contracts(box: Control, p: Dictionary) -> void:
    var G: Dictionary = Campaign.G
    _p(box, "Work posted at %s by the %s. Pay on completion; failing a contract costs 8 standing with whoever posted it." % [p.name, GameData.fac[p.fac].name], UI.DIM, 14)
    var list: Array = Diplomacy.offers(p)
    if list.is_empty(): _p(box, "Nothing posted today. The board is renewed every couple of weeks.", UI.DIM, 14)
    for c in list:
        box.add_child(UI.label(c.title, UI.GOLD, 16)); _p(box, c.text, UI.INK, 14)
        var why: String = Diplomacy.can_accept(c)
        box.add_child(UI.row([UI.label("Pays %s · %s standing +%d · %d days" % [Campaign.fmt(int(c.reward)), GameData.fac[c.fac].short, int(c.rep), int(c.days)], UI.DIM, 13),
            UI.button("Sign", func(): Diplomacy.accept(c); _toast("Signed: " + c.title + ". Marked in gold on the chart."); _rerender(), true, why != "")]))
        if why != "": _p(box, why, UI.DIM, 12)
    _active_contracts(box)

func _active_contracts(box: Control) -> void:
    var G: Dictionary = Campaign.G
    if G.get("contracts", []).is_empty(): return
    box.add_child(UI.label("YOUR CONTRACTS", UI.DIM, 12))
    for c in G.contracts:
        var prog: String = (" · %d of %d sunk" % [int(c.got), int(c.need)]) if c.kind == "war" else ""
        var cl := UI.label("%s (%s)%s · %d days left" % [c.title, c.from, prog, maxi(0, int(c.deadline) - G.day)], UI.INK, 14)
        cl.tooltip_text = Diplomacy.contract_info(c); cl.mouse_filter = Control.MOUSE_FILTER_PASS
        box.add_child(UI.row([cl,
            UI.button("Abandon", func(): Diplomacy.fail(c, "Abandoned."); _rerender())]))

func _commission(box: Control, p: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var C: Dictionary = Diplomacy.D.commissions[p.fac]
    box.add_child(UI.label(C.title, UI.GOLD, 18)); _p(box, C.text)
    _p(box, "Pay %s a month. Sinking the %s's enemies earns twice the standing. %s Turning your guns on the %s is betrayal, and is never forgiven." % [Campaign.fmt(int(C.stipend)), GameData.fac[p.fac].short,
        ("You become a combatant to the %s." % GameData.fac[C.marque].name) if C.has("marque") else "Its wars become yours.", GameData.fac[p.fac].short], UI.DIM, 14)
    if G.commission != null and G.commission.fac == p.fac:
        _p(box, "You hold this commission, since %s." % Campaign.date_str(int(G.commission.since)), UI.GREEN, 14)
        box.add_child(UI.button("Resign (standing -10)", func(): Diplomacy.resign(); _rerender()))
        return
    var why: String = Diplomacy.can_commission(p.fac)
    if why != "": _p(box, why, UI.DIM, 14)
    else: box.add_child(UI.button("Accept the " + C.title, func(): Diplomacy.take_commission(p.fac); _rerender(), true))

## The powers as they stand: how each great power regards the others, and the latest news between them.
func _powers(box: Control) -> void:
    var G: Dictionary = Campaign.G
    box.add_child(UI.label("THE POWERS", UI.DIM, 12))
    var P: Array = Diplomacy.POWERS
    for i in P.size():
        for j in range(i + 1, P.size()):
            var a: String = P[i]; var b: String = P[j]; var bd: String = Diplomacy.band(a, b)
            if bd == "neutral" or bd == "cool": continue
            var col: Color = UI.RED if bd == "war" else (Color(0.9, 0.55, 0.35) if bd in ["armistice", "hostile"] else UI.GREEN)
            box.add_child(UI.row([UI.label("%s and %s" % [GameData.fac[a].short, GameData.fac[b].short], UI.INK, 14), UI.label(Diplomacy.BAND_TEXT[bd] + " (%d)" % int(round(Diplomacy.rel(a, b))), col, 13)]))
    if not G.get("news", []).is_empty():
        box.add_child(UI.label("NEWS", UI.DIM, 12))
        var nw: Array = G.news.slice(-8); nw.reverse()
        for n in nw: _p(box, "%s: %s" % [Campaign.date_str(int(n[0])), n[1]], UI.DIM, 13)

func _missions(box: Control, at_admiralty: bool, by := "") -> void:
    var G: Dictionary = Campaign.G
    if G.mission != null:
        var am: Dictionary = Campaign.mission_def(); var mby: String = G.mission.get("by", "concord")
        box.add_child(UI.label("Active orders (%s): %s" % [Campaign.story_office(mby), am.title], UI.GOLD, 17)); _p(box, am.brief); _p(box, "The target is marked in yellow on your chart.", UI.DIM, 14)
    if at_admiralty:
        var chain: Array = Campaign.story_chain(by); var i: int = Campaign.story_idx(by); var office := Campaign.story_office(by)
        if i >= chain.size(): _p(box, ("The war is won, for now. Directorate fleets keep modernising, so keep your research ahead of theirs." if by == "concord" else Campaign.S.chains[by].end), UI.DIM, 15)
        elif G.mission == null:
            var m: Dictionary = chain[i]
            box.add_child(UI.label("%s orders %d of %d: %s" % [office, i + 1, chain.size(), m.title], UI.GOLD, 17)); _p(box, m.brief)
            _p(box, "Reward %s, %d RP, %s standing +%d" % [Campaign.fmt(m.reward.credits), m.reward.rp, GameData.fac[by].short, m.reward.rep], UI.DIM, 14)
            if G.rep.get(by, 0) >= 0 and not Campaign.at_war(by):
                box.add_child(UI.button("Accept orders", func():
                    Campaign.accept_mission(by); _toast("Orders received: %s. The target is marked in yellow." % m.title); _rerender(), true))
            else: _p(box, "The %s will not deal with you while your standing is below zero." % office, UI.DIM, 14)
        else: _p(box, "Finish your current orders first.", UI.DIM, 14)
    elif G.mission == null:
        var waiting := []
        for f in GameData.fac:
            if f != "raiders" and Campaign.story_idx(f) < Campaign.story_chain(f).size() and G.rep.get(f, 0) >= 0 and not Campaign.at_war(f):
                for p in G.ports: if p.fac == f and p.capital: waiting.append("the %s in %s" % [Campaign.story_office(f), p.name])
        if not waiting.is_empty(): _p(box, "Orders are waiting from " + ", ".join(waiting) + ".", UI.DIM, 14)
    if not at_admiralty:
        _active_contracts(box)
        if G.get("commission") != null: _p(box, "In service: %s (pay %s a month)." % [Diplomacy.commission_title(G.commission.fac), Campaign.fmt(int(Diplomacy.D.commissions[G.commission.fac].stipend))], UI.GREEN, 14)
    box.add_child(UI.label("STANDING", UI.DIM, 12))
    _p(box, "The armistice of November 1945 holds, just. A flag's warships engage you on sight only if your standing with it falls to %d, or for three months after you open fire on its ships. Its ports close below -10." % Campaign.WAR_STANDING, UI.DIM, 13)
    for f in GameData.fac:
        if f == "raiders": continue
        var r: int = G.rep.get(f, 0)
        var nl := UI.label(GameData.fac[f].name); nl.tooltip_text = GameData.fac[f].get("desc", ""); nl.mouse_filter = Control.MOUSE_FILTER_PASS
        var stt: String = ("at war · engages on sight" + (" (incident, %d days)" % Campaign.incident_days(f) if Campaign.incident_days(f) > 0 else "")) if Campaign.at_war(f) else ("ports closed" if Campaign.hostile(f) else ("favoured" if r >= 30 else "neutral"))
        var sc: Color = UI.RED if Campaign.at_war(f) else (UI.GOLD if Campaign.hostile(f) else (UI.GREEN if r >= 30 else UI.DIM))
        box.add_child(UI.row([nl, UI.label(("+" if r > 0 else "") + str(r), UI.INK), UI.label(stt, sc, 13)]))
    if not at_admiralty: _powers(box)
    if G.log.size():
        box.add_child(UI.label("LOG", UI.DIM, 12))
        var lg: Array = G.log.slice(-8); lg.reverse()
        for l in lg: _p(box, "Day %d: %s" % [l[0], l[1]], UI.DIM, 13)

func _lead_pic(f: Dictionary) -> Control:
    var lead: Dictionary = f.ships[0]
    for s in f.ships: if GameData.hulls[s.type].L > GameData.hulls[lead.type].L: lead = s
    return _thumb(lead.type, GameData.ship_pal(lead.type, f.fac), clampf(GameData.hulls[lead.type].L * 2.2 + 60, 260.0, 420.0), lead.fit)

# ------------------------------------------------------------------ land structures
## Your structures ashore: what each yields, who holds it, where its goods go, and the goods waiting for you.
func _holdings(box: Control) -> void:
    var G: Dictionary = Campaign.G; var hs: Array = Structures.held()
    if hs.is_empty():
        _p(box, "You hold nothing ashore. Strike a structure from the air until its defences are silenced, then demand its surrender with your fleet off the coast; or land a garrison on an unclaimed one. Each held structure pays monthly.", UI.DIM, 14)
        return
    var money := 0
    for s in hs: money += int(Structures.yield_of(s).get("money", 0))
    _p(box, "%d structures held by %d men (wages %s a day). Paid on the 30th: %s a month, and goods to the nearest open port or your naval base." % [hs.size(), Structures.garrison_total(), Campaign.fmt(Structures.garrison_total() * 0.15), Campaign.fmt(money)], UI.DIM, 14)
    for s in hs:
        var y := Structures.yield_of(s); var yl := []
        for g in y: yl.append(Campaign.fmt(y[g]) if g == "money" else "%d %s" % [y[g], g])
        var dp = Structures.depot_of(s)
        var row := [UI.label(s.name, UI.GOLD, 14), UI.label("%s · garrison %d · %s%s" % [Structures.kind(s).name, int(s.garrison), ", ".join(yl) if yl.size() else "no income", (" → " + ("held there" if dp == s else Structures.depot_name(dp))) if not y.is_empty() and y.keys() != ["money"] else ""], UI.DIM, 13)]
        row.append(UI.button("Details", func(): open_struct(s)))
        box.add_child(UI.row(row))
    var stores := []
    for p in G.ports: if not Structures.store_of(p).is_empty(): stores.append("%s: %s" % [p.name, ", ".join(Structures.store_of(p).keys().map(func(k): return "%d %s" % [int(Structures.store_of(p)[k]), k]))])
    for s in hs: if not Structures.store_of(s).is_empty(): stores.append("%s: %s" % [s.name, ", ".join(Structures.store_of(s).keys().map(func(k): return "%d %s" % [int(Structures.store_of(s)[k]), k]))])
    if stores.size(): box.add_child(UI.label("GOODS WAITING", UI.DIM, 12)); for t in stores: _p(box, t, UI.INK, 13)

## A structure's panel: what it is, who holds it, its defences and output, and what you can do about it from here.
func open_struct(s: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var k: Dictionary = Structures.kind(s)
    var dkm := int(Campaign.mdist(G.player.x, G.player.y, s.x, s.y) * Campaign.KM_PER_UNIT)
    open_panel(func(box):
        box.add_child(UI.title(s.name))
        var fac_col: Color = UI.GOLD if s.fac == "player" else (UI.DIM if s.fac == "" else Color(GameData.fac[s.fac].map))
        box.add_child(UI.label("%s · %s · %s · %d km inland · %d km from you" % [k.name, Structures.owner_name(s), String(s.land).trim_prefix("the ").capitalize() if s.land != "" else "", int(s.coastKm), dkm], fac_col, 14))
        var pic := StructPic.new(); pic.s = s; pic.map = self; pic.clip_contents = true; pic.custom_minimum_size = Vector2(0, 230); box.add_child(pic)
        _p(box, k.text, UI.INK, 14)
        var y := Structures.yield_of(s); var yl := []
        for g in y: yl.append(("%s a month" % Campaign.fmt(y[g])) if g == "money" else "%d %s a month" % [y[g], g])
        if not yl.is_empty(): _p(box, "Output: " + ", ".join(yl) + (" (war damage: %d%% wrecked, mending slowly)" % int(float(s.ruin) * 100) if float(s.ruin) > 0.02 else ""), UI.INK, 14)
        _p(box, "Defences: %s. %d%% out of action%s." % [Structures.defence_text(s), int(float(s.dmg) * 100), " (silenced)" if Structures.silenced(s) else ""], UI.DIM, 14)
        var cov: Array = Structures.cover_fields(s)
        if not cov.is_empty() and s.fac != "player": _p(box, "Fighter cover from: " + ", ".join(cov.map(func(a): return a.name)) + ". Silence those airfields first and the strike meets fewer fighters.", UI.DIM, 13)
        if s.fac == "player": _held_struct(box, s)
        else: _foreign_struct(box, s)
        var acts := [UI.button("Set course for the coast", func(): _course_coast(s))]
        acts.append(UI.button("Close", close_panel, true))
        box.add_child(UI.row(acts))
    , false, 820, "struct:%d" % int(s.id))

func _course_coast(s: Dictionary) -> void:
    var w := Structures.coast_point(s)
    if Campaign.set_course(Campaign.G.player, w.x, w.y): free_cam = false; close_panel(); _toast("Course set for the coast off the " + s.name + ".")
    else: _toast("No sea route to the coast off the " + s.name + ".")

func _foreign_struct(box: Control, s: Dictionary) -> void:
    var G: Dictionary = Campaign.G
    var ag := Structures.air_group()
    if ag > 0: _p(box, "Your air groups: %d %s aircraft. Strike reach %d km." % [ag, "jet" if Structures.jets() else "piston", int(Campaign.strike_reach(G.fleet) * Campaign.KM_PER_UNIT)], UI.DIM, 13)
    if s.fac != "":
        var why := Structures.can_strike(s)
        if Structures.breaks_armistice(s) and why == "":
            _p(box, "Striking it breaks the armistice: %s standing -30, and %s warships will engage you on sight for three months." % [GameData.fac[s.fac].short, GameData.fac[s.fac].short], UI.RED, 13)
        var sb := UI.button("Launch an air strike", func(): _launch_strike(s), true, why != "")
        box.add_child(sb)
        if why != "": _p(box, why, UI.DIM, 13)
        var wb := Structures.can_bombard(s)
        box.add_child(UI.button("Bombard it from the sea", func(): _launch_strike(s, true), wb == "" and why != "", wb != ""))
        if wb != "": _p(box, wb, UI.DIM, 13)
        elif float(Structures.defences(s).guns) > 0.05: _p(box, "Its heavy guns will answer: expect hits on your ships. Each bombardment uses about a sixth of each ship's magazines.", UI.DIM, 13)
        else: _p(box, "Each bombardment uses about a sixth of each firing ship's magazines.", UI.DIM, 13)
    if Structures.troop_capacity() > 0 or Structures.troops() > 0:
        var wi := Structures.can_invade(s)
        var D := int(round(Structures.defenders(s)))
        _p(box, "Your troops: %s embarked. Defenders: about %s. A landing now would carry it about %d times in 100%s. Strikes and bombardment thin the defenders first." % [Campaign.fmt(Structures.troops()), Campaign.fmt(D), int(round(Structures.invade_odds(s) * 100)), "" if Campaign.has_tech("amphib") else " (amphibious warfare research adds a quarter to your men's weight)"], UI.INK, 13)
        if s.fac != "" and Structures.breaks_armistice(s) and wi == "": _p(box, "Landing breaks the armistice with the %s." % GameData.fac[s.fac].short, UI.RED, 13)
        box.add_child(UI.button("Land the troops (%s men)" % Campaign.fmt(Structures.troops()), func(): _invade_report(s, Structures.invade(s)), true, wi != ""))
        if wi != "": _p(box, wi, UI.DIM, 13)
    var tw := Structures.can_take(s)
    var lbl := ("Land a garrison (%d men)" % Structures.garrison_need(s)) if s.fac == "" else ("Demand its surrender (garrison %d men)" % Structures.garrison_need(s))
    box.add_child(UI.button(lbl, func():
        var t := Structures.take(s); _toast(t); open_struct(s), s.fac == "", tw != ""))
    if tw != "": _p(box, tw, UI.DIM, 13)
    else:
        _p(box, "Held structures pay monthly; their garrisons draw wages (%s a day for this one), and the old owner will try to retake it." % Campaign.fmt(Structures.garrison_need(s) * 0.15), UI.DIM, 13)
        var short := Campaign.crew_need() - (int(Campaign.G.crew) - Structures.garrison_need(s))
        if short > 0: _p(box, "Landing them leaves your ships %d men short: they will reload and steam slower until you hire more in port." % short, UI.GOLD, 13)

## The story of a landing.
func _invade_report(s: Dictionary, r: Dictionary) -> void:
    open_panel(func(box):
        box.add_child(UI.title("Landing at the " + s.name))
        _p(box, "%s soldiers went in over the beaches against about %s defenders. The staff had put the chances at %d in 100." % [Campaign.fmt(int(r.men)), Campaign.fmt(int(r.defenders)), int(round(float(r.odds) * 100))])
        if r.won:
            _p(box, "The %s is yours. %s of your men fell taking it; %s hold it as its garrison and %s are back aboard." % [s.name, Campaign.fmt(int(r.lost)), Campaign.fmt(int(s.garrison)), Campaign.fmt(Structures.troops())], UI.GOLD)
            _p(box, "It pays monthly from now on, its garrison draws wages, and its old owner will want it back.", UI.DIM, 14)
        else:
            _p(box, "The landing was beaten off. %s of your men were lost; %s were taken off the beaches." % [Campaign.fmt(int(r.lost)), Campaign.fmt(Structures.troops())], UI.RED)
            _p(box, "The defence was shaken by it too. Strike or bombard it again before the next attempt, or bring more men.", UI.DIM, 14)
        box.add_child(UI.row([UI.button("Back to the %s" % s.name, func(): open_struct(s), true), UI.button("Return to the chart", close_panel)]))
    , true, 720)

func _held_struct(box: Control, s: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var dp = Structures.depot_of(s)
    _p(box, "Garrison: %d men, held since %s.%s" % [int(s.garrison), Campaign.date_str(int(s.took)), (" The %s wants it back." % GameData.fac[s.from].name) if s.from != "" else ""], UI.GOLD, 14)
    if not Structures.kind(s).yields.is_empty(): _p(box, "Money is paid to you on the 30th of each month; goods go to %s." % ("its own stores here" if dp == s else Structures.depot_name(dp)), UI.DIM, 13)
    if Structures.radar_held(s): _p(box, "Under your radar's watch (%s): you will hear the moment an assault sails, and the garrison fights a quarter better." % Structures.radar_name(s), UI.DIM, 13)
    for f in G.fleets: if Structures._is_assault(f) and int(f.assault) == int(s.id) and f.get("warned", false): _p(box, "Threat: a %s is bound here, %s." % [f.name.to_lower(), Diplomacy.where(f.x, f.y)], UI.RED, 14)
    var near := Structures.off_coast(s)
    if s.kind == "navalbase" and near: _base_services(box, s)
    elif not Structures.store_of(s).is_empty(): _store_rows(box, s, near, s.name)
    var acts := []
    if Structures.can_hand_over(s): acts.append(UI.button("Hand it to the %s" % GameData.fac[G.commission.fac].short, func(): _toast(Structures.hand_over(s)); close_panel()))
    acts.append(UI.button("Withdraw the garrison", func(): _toast(Structures.withdraw(s)); open_struct(s), false, not near))
    box.add_child(UI.row(acts))
    if not near: _p(box, "To take the garrison off, or load goods, bring the fleet off its coast.", UI.DIM, 12)

## Goods waiting at a port warehouse, a naval base or a structure: load them, or sell them where a market exists.
func _store_rows(box: Control, dp: Dictionary, can_load: bool, where: String, market = null) -> void:
    var G: Dictionary = Campaign.G; var st: Dictionary = Structures.store_of(dp)
    box.add_child(UI.label("GOODS HELD AT " + where.to_upper(), UI.DIM, 12))
    if st.is_empty(): _p(box, "Nothing waiting.", UI.DIM, 13); return
    for gid in st.keys():
        var n := int(st[gid]); var free := Campaign.cargo_cap() - Campaign.cargo_used()
        var items := [UI.label("%d %s" % [n, gid], UI.INK, 14)]
        items.append(UI.button("Load %d" % mini(n, free), func():
            var k := mini(n, Campaign.cargo_cap() - Campaign.cargo_used()); G.cargo[gid] = G.cargo.get(gid, 0) + k; st[gid] = n - k
            if int(st[gid]) <= 0: st.erase(gid)
            _rerender_store(dp), false, not can_load or free <= 0))
        if market != null:
            var pr: int = sell_price(market, gid)
            items.append(UI.button("Sell here · %s" % Campaign.fmt(pr * n), func(): G.credits += pr * n; st.erase(gid); _rerender_store(dp)))
        box.add_child(UI.row(items))

func _rerender_store(dp: Dictionary) -> void:
    if dp.has("kind") and dp.has("garrison"): open_struct(dp)
    else: _render_port()

## A naval base you hold: repairs, rearming, fuel, aircraft and its stores, at plain dockyard prices.
func _base_services(box: Control, s: Dictionary) -> void:
    var G: Dictionary = Campaign.G
    box.add_child(UI.label("YOUR NAVAL BASE", UI.DIM, 12))
    var rep := 0; var arm := 0
    for sh in G.fleet: rep += repair_cost(sh); arm += Campaign.rearm_cost(sh)
    var fuel_need := Campaign.fuel_room(); var fuel_cost := fuel_need * 9
    var rc := Structures.replace_cost()
    box.add_child(UI.row([UI.button("Repair all · " + Campaign.fmt(rep), func(): _base_do(s, "repair", rep), false, rep == 0 or G.credits < rep),
        UI.button("Rearm all · " + Campaign.fmt(arm), func(): _base_do(s, "rearm", arm), false, arm == 0 or G.credits < arm),
        UI.button("Refuel · " + Campaign.fmt(fuel_cost), func(): _base_do(s, "fuel", fuel_cost, fuel_need), false, fuel_need == 0 or G.credits < fuel_cost),
        UI.button("Replace aircraft · " + Campaign.fmt(rc), func(): _base_do(s, "air", rc), false, rc == 0 or G.credits < rc)]))
    var known: Array = G.get("studied", [])
    if not known.is_empty():
        box.add_child(UI.label("SLIPWAY · DESIGNS COPIED FROM YOUR PRIZES", UI.DIM, 12))
        for id in known:
            var h: Dictionary = GameData.hulls[id]; var pr := int(round(float(h.price) * 1.15))
            box.add_child(UI.row([UI.label("%s class %s" % [h.dn, h.name.to_lower()], UI.INK), UI.label("era %d · crew %s" % [int(h.era), Campaign.fmt(h.crew)], UI.DIM, 13),
                UI.button("Build · " + Campaign.fmt(pr), func():
                    G.credits -= pr; var ns: Dictionary = Campaign.new_ship(id, null, "player", G.tech); ns.name = GameData.names.player.pick_random(); G.fleet.append(ns)
                    _toast("The %s is commissioned at your base. She needs %d crew." % [ns.name, int(h.crew)]); open_struct(s), false, G.credits < pr or G.fleet.size() >= 10)]))
        _p(box, "Your own yard builds what you have captured and measured, whatever its era, armed with the weapons you have researched.", UI.DIM, 12)
    _store_rows(box, s, true, s.name)

func _base_do(s: Dictionary, what: String, cost: int, n := 0) -> void:
    var G: Dictionary = Campaign.G; G.credits -= cost
    match what:
        "repair": for sh in G.fleet: sh.hullFrac = 1.0
        "rearm": for sh in G.fleet: sh.ammo = 1.0
        "fuel": G.cargo.fuel += n
        "air": Structures.replace_planes()
    open_struct(s)

## The strike: a warning if it breaks the armistice, then the raid, then the report.
func _launch_strike(s: Dictionary, naval := false) -> void:
    if Structures.breaks_armistice(s):
        open_panel(func(box):
            box.add_child(UI.title("Break the armistice?"))
            _p(box, "The %s is a %s installation, and the %s is not at war with you. A strike on it is an act of war: %s standing -30%s, and their warships will engage you on sight for three months." % [s.name, GameData.fac[s.fac].short, GameData.fac[s.fac].name, GameData.fac[s.fac].short, (". It is also betrayal of the flag you serve" if Campaign.G.get("commission") != null and Campaign.G.commission.fac == s.fac else "")])
            box.add_child(UI.row([UI.button("Open fire" if naval else "Launch the strike", func(): _fly_strike(s, naval), true), UI.button("Stand down", func(): open_struct(s))]))
        , true, 640)
        return
    _fly_strike(s, naval)

func _fly_strike(s: Dictionary, naval := false) -> void:
    var res := Structures.bombard(s) if naval else Structures.strike(s)
    close_panel(); panel_open = true; _blocking = true; Campaign.paused = true
    face_of(s)
    var raid := AirRaid.new(); raid.res = res; raid.s = s; raid.set_anchors_preset(Control.PRESET_FULL_RECT)
    raid.done.connect(func(): raid.queue_free(); _strike_report(s, res))
    panel_layer.add_child(raid)

func _strike_report(s: Dictionary, r: Dictionary) -> void:
    if r.get("mode", "") == "naval": _bombard_report(s, r); return
    open_panel(func(box):
        box.add_child(UI.title("Strike on the " + s.name))
        _p(box, "%d %s aircraft took off%s." % [int(r.planes), "jet" if r.jets else "piston-engined", (", %d of them flying escort" % int(r.escorts)) if int(r.escorts) > 0 else ""])
        if int(r.fighters) > 0: _p(box, "About %d defending fighters met the strike. They shot down %d of ours; the escorts claimed %d." % [int(r.fighters), int(r.lost_fighters), int(r.downed)])
        else: _p(box, "No fighters rose to meet it.", UI.DIM)
        _p(box, "Flak over the target brought down %d. %d aircraft bombed." % [int(r.lost_flak), int(r.bombers)])
        _p(box, "Its defences: %d%% out of action before, %d%% now.%s" % [int(r.before * 100), int(r.after * 100), " The defences are silenced: bring the fleet off its coast and demand its surrender." if r.silenced else " Strike again when the air groups have rearmed (half a day)."], UI.GOLD if r.silenced else UI.INK)
        for n in r.get("notes", []): _p(box, n, UI.GOLD)
        var lost := int(r.lost_fighters) + int(r.lost_flak)
        if lost > 0: _p(box, "%d aircraft lost. %d left aboard your carriers; replace them in port (%s each)." % [lost, Structures.air_group(), Campaign.fmt(Structures.plane_cost())], UI.DIM, 14)
        box.add_child(UI.row([UI.button("Back to the target", func(): open_struct(s), true), UI.button("Return to the chart", close_panel)]))
    , true, 720)

func _bombard_report(s: Dictionary, r: Dictionary) -> void:
    open_panel(func(box):
        box.add_child(UI.title("Bombardment of the " + s.name))
        _p(box, "From %d km offshore, %s shelled it for an hour%s." % [int(r.km), ", ".join(r.ships), " with heavy guns" if r.heavy else ""])
        if r.answers.is_empty(): _p(box, "Nothing answered from the shore." if float(r.guns) < 0.05 else "Its guns answered, but found nothing.", UI.DIM)
        else: _p(box, "Its guns answered: " + "; ".join(r.answers) + ".", Color(0.95, 0.75, 0.71))
        _p(box, "Its defences: %d%% out of action before, %d%% now.%s" % [int(r.before * 100), int(r.after * 100), " The defences are silenced: demand its surrender." if r.silenced else " The guns can fire again in six hours."], UI.GOLD if r.silenced else UI.INK)
        for n in r.get("notes", []): _p(box, n, UI.GOLD)
        box.add_child(UI.row([UI.button("Back to the target", func(): open_struct(s), true), UI.button("Return to the chart", close_panel)]))
    , true, 720)

## A structure's picture for its panel: the ground, the sea on its seaward side, and the installation drawn large.
class StructPic extends Control:
    var s: Dictionary
    var map
    func _process(_d: float) -> void: if s.kind == "radar": queue_redraw()
    func _draw() -> void:
        var face: float = map.face_of(s); var c := size / 2
        InstallationArt.landscape(self, Rect2(Vector2.ZERO, size), int(s.id), Campaign.y_lat(s.y), c, size.y * 0.5)
        if Structures.kind(s).military and s.kind != "airfield" and s.kind != "radar":
            var u := Vector2.from_angle(face); var far := c + u * size.y * 0.46 * (0.72 if s.kind == "navalbase" else 0.62)
            var n := Vector2(-u.y, u.x) * 2000.0
            draw_colored_polygon(PackedVector2Array([far + n, far - n, far - n + u * 2000.0, far + n + u * 2000.0]), Color("#24434c"))
            draw_line(far + n, far - n, Color(0.6, 0.72, 0.75, 0.5), 3.0)
        InstallationArt.draw(self, s.kind, c, size.y * 0.46, int(s.id), face, float(s.dmg), float(s.ruin), false, Time.get_ticks_msec() / 1000.0)
