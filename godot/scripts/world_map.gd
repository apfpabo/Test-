extends Node2D
## The chart: the world's oceans (generated by tools/worldgen), ports, survey sites, pack ice and every fleet at sea. Shows the
## campaign and feeds it input; all rules live in campaign.gd.

const SANS := 13
var zoom = 0.9                 # screen pixels per map unit
var cam = Vector2.ZERO         # camera centre in map units
var free_cam = false
var drag = {}
var world: Node2D
var land_copies: Array = []
var marks: Node2D
var overlay: Control
var ui: Control
var top: HBoxContainer
var stats = {}
var speed_btns = []
var toasts: VBoxContainer
var dock: Button
var panel_layer: Control
var panel_open = false
var codex_tab = "world"
var trails: Dictionary = {}   # wake trails: fleet id ("player" for yours) -> points {x, y, h, t, s}, newest last
var tnow = 0.0
var land_tris: Array = []       # [PackedVector2Array] parts that triangulate
var land_uvs: Array = []        # matching terrain texture coordinates
var terrain: Texture2D
var land_mat: ShaderMaterial
var coast_lines: Array = []     # PackedVector2Array per polygon, closed
var chan_lines: Array = []
var last_coast_zoom = -1.0

func _ready() -> void:
    RenderingServer.set_default_clear_color(Color("#0a171c"))
    _prepare_land()
    world = Node2D.new(); add_child(world)
    var sea = SeaDrawer.new(); sea.map = self; world.add_child(sea)
    for k in [-1, 0, 1]:
        var copy = LandCopy.new(); copy.map = self; copy.position.x = k * Campaign.MW; world.add_child(copy); land_copies.append(copy)
        # land is static geometry, triangulated once; redrawing it on every zoom step made zooming crawl
        # shaded terrain baked by tools/worldgen (terrain.png, one texel per 0.1°), in the battle islands' palette
        for i in land_tris.size():
            var poly = Polygon2D.new(); poly.polygon = land_tris[i]; poly.show_behind_parent = true
            if terrain != null:
                poly.texture = terrain; poly.uv = land_uvs[i]; poly.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
                poly.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS; poly.material = land_mat
            else: poly.color = Color("#c9bb93")
            copy.add_child(poly)
        # shallow-water glow along the coasts, with rounded joins so sharp headlands don't throw spikes
        for pl in coast_lines:
            for g in [[14.0, 0.09], [5.0, 0.14]]:
                var ln = Line2D.new(); ln.points = pl; ln.width = g[0]; ln.default_color = Color(0.5, 0.69, 0.75, g[1])
                ln.joint_mode = Line2D.LINE_JOINT_ROUND; ln.begin_cap_mode = Line2D.LINE_CAP_ROUND; ln.end_cap_mode = Line2D.LINE_CAP_ROUND
                ln.show_behind_parent = true; copy.add_child(ln)
    marks = Marks.new(); marks.map = self; world.add_child(marks)
    var cl = CanvasLayer.new(); cl.layer = 5; add_child(cl)
    ui = Control.new(); ui.set_anchors_preset(Control.PRESET_FULL_RECT); ui.mouse_filter = Control.MOUSE_FILTER_IGNORE; ui.theme = UI.theme(); cl.add_child(ui)
    overlay = Overlay.new(); overlay.map = self; overlay.set_anchors_preset(Control.PRESET_FULL_RECT); overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE; ui.add_child(overlay)
    _build_top(); _build_toasts(); _build_orders(); _build_telegraph(); _build_cmdbar()
    dock = UI.button("Dock", _on_dock, true); dock.set_anchors_preset(Control.PRESET_CENTER_BOTTOM); dock.position = Vector2(-80, -60); dock.visible = false; ui.add_child(dock)
    dock.set_anchor_and_offset(SIDE_LEFT, 0.5, -90); dock.set_anchor_and_offset(SIDE_RIGHT, 0.5, 90); dock.set_anchor_and_offset(SIDE_TOP, 1.0, -64); dock.set_anchor_and_offset(SIDE_BOTTOM, 1.0, -26)
    panel_layer = Control.new(); panel_layer.set_anchors_preset(Control.PRESET_FULL_RECT); panel_layer.mouse_filter = Control.MOUSE_FILTER_IGNORE; ui.add_child(panel_layer)
    ui.move_child(cmdbar, -1)   # the Command tabs stay clickable over an open panel
    Campaign.toast.connect(_toast); Campaign.encounter.connect(_on_encounter); Campaign.reached_port.connect(open_port)
    cam = Vector2(Campaign.G.player.x, Campaign.G.player.y)
    if Campaign.show_origin: Campaign.show_origin = false; Campaign.paused = true; _show_origin()
    elif Campaign.show_aftermath: Campaign.show_aftermath = false; _show_aftermath(Campaign.last_result)
    else: Campaign.paused = false

## Texture coordinates for a land polygon: map units to terrain texels, wrapping east-west and held inside the
## texture at the poles (polar coasts run off the chart).
func _uvs(pv: PackedVector2Array) -> PackedVector2Array:
    var out = PackedVector2Array(); var k := Vector2(terrain.get_width() / Campaign.MW, terrain.get_height() / Campaign.MH)
    for p in pv: out.append(Vector2(p.x * k.x, clampf(p.y * k.y, 0.5, terrain.get_height() - 0.5)))
    return out

func _prepare_land() -> void:
    for poly in Campaign.C.land:
        var pv = PackedVector2Array()
        for i in range(0, poly.size(), 2): pv.append(Vector2(poly[i], poly[i + 1]))
        var closed = pv.duplicate(); closed.append(pv[0]); coast_lines.append(closed)
        if not Geometry2D.triangulate_polygon(pv).is_empty(): land_tris.append(pv)
        else:
            for q in Geometry2D.offset_polygon(pv, 0.01): # repair self-touching outlines; parts that still fail (lakes) are skipped
                if not Geometry2D.triangulate_polygon(q).is_empty(): land_tris.append(q)
    if ResourceLoader.exists("res://data/terrain.png"):
        terrain = load("res://data/terrain.png"); land_mat = ShaderMaterial.new(); land_mat.shader = load("res://shaders/chart_land.gdshader")
    if terrain != null: for pv in land_tris: land_uvs.append(_uvs(pv))
    for ch in Campaign.C.channels:
        var pv = PackedVector2Array()
        for q in ch: pv.append(Vector2(q[0], q[1]))
        chan_lines.append(pv)

var coast := 0.0
var coast_t := 0.0
func _exit_tree() -> void: Sfx.engine(0.0); Sfx.ambience(0.0)
func rx(x: float) -> float: return cam.x + Campaign.wdx(cam.x, x) # place a wrapped world x next to the camera
func to_screen(p: Vector2) -> Vector2: return (Vector2(rx(p.x), p.y) - cam) * zoom + get_viewport_rect().size / 2
func to_world(sp: Vector2) -> Vector2: return (sp - get_viewport_rect().size / 2) / zoom + cam
## How large a structure is drawn close in (map units): larger than life so it reads, but never reaching past the
## coast for an inland one, and no bigger than a few kilometres' worth for a battery, radar or harbour on the shore.
func struct_r(s) -> float:
    if s == null: return 0.0
    var r: float = 18.0 * boost() / zoom
    if Structures.COASTAL.has(s.kind): return minf(r, 2.6)
    return minf(r, maxf(1.0, float(s.coastKm) / Campaign.KM_PER_UNIT * 0.8))

## The bearing from a structure to the nearest sea (batteries and piers face it), worked out once.
func face_of(s: Dictionary) -> float:
    if not s.has("face"): var w := Campaign.nearest_water(s.x, s.y, 80); s.face = Campaign.mang(s.x, s.y, w.x, w.y)
    return float(s.face)
func boost() -> float: return pow(zoom, 0.75) if zoom > 1 else 1.0

# ------------------------------------------------------------------ frame
func _process(delta: float) -> void:
    var dt = minf(delta, 0.05); tnow += dt
    var G: Dictionary = Campaign.G
    if not panel_open:
        var pan = Vector2((1 if Input.is_key_pressed(KEY_RIGHT) or Input.is_key_pressed(KEY_D) else 0) - (1 if Input.is_key_pressed(KEY_LEFT) or Input.is_key_pressed(KEY_A) else 0),
            (1 if Input.is_key_pressed(KEY_DOWN) or Input.is_key_pressed(KEY_S) else 0) - (1 if Input.is_key_pressed(KEY_UP) or Input.is_key_pressed(KEY_W) else 0))
        if pan != Vector2.ZERO: free_cam = true; cam += pan * 600 * dt / zoom
        if not Campaign.paused:
            for i in Campaign.map_speed:
                if panel_open or Campaign.paused: break
                Campaign.update(dt)
            _wakes(dt)
    if not free_cam: cam = Vector2(G.player.x, G.player.y)
    var vs = get_viewport_rect().size
    cam.x = Campaign.wrap_x(cam.x)
    cam.y = clampf(cam.y, vs.y / 2 / zoom - 40, Campaign.MH - vs.y / 2 / zoom + 40) if vs.y / zoom < Campaign.MH else Campaign.MH / 2
    world.scale = Vector2(zoom, zoom); world.position = vs / 2 - cam * zoom
    if absf(zoom - last_coast_zoom) / maxf(last_coast_zoom, 0.01) > 0.4:  # coast lines keep roughly a pixel wide; redrawing 16k points per wheel step was slow
        last_coast_zoom = zoom
        for c in land_copies: c.queue_redraw()
    marks.queue_redraw(); overlay.queue_redraw(); world.get_child(0).queue_redraw()
    _orders_t -= delta
    if _orders_t <= 0.0: _orders_t = 0.5; _update_orders()
    _update_top(); _update_dock(); _update_telegraph()
    for k in cmd_btns:   # the tab of the Command page that is open, underlined in gold
        var on: bool = panel_open and _panel_key == "cmd:" + k
        cmd_btns[k].get_theme_stylebox("normal").border_color = UI.GOLD if on else Color(0, 0, 0, 0)
        cmd_btns[k].add_theme_color_override("font_color", UI.GOLD if on else UI.DIM)
    # your ships under way: engines and the sea along the hull, louder as the chart closes in on them
    var under_way: bool = not Campaign.paused and not panel_open and G.player.v > 0.8
    Sfx.engine(clampf(G.player.v / 16.0, 0.2, 1.0) * clampf((zoom - 0.5) / 6.0, 0.03, 0.3) if under_way else 0.0)
    # the sea all round, and gulls when there is land near
    coast_t -= delta
    if coast_t <= 0.0:
        coast_t = 1.0; var n := 0
        for i in 12: if Campaign.on_land(G.player.x + cos(i * TAU / 12.0) * 4.0, G.player.y + sin(i * TAU / 12.0) * 4.0): n += 1
        coast = n / 12.0
    Sfx.ambience(0.4, minf(1.0, coast * 2.5))

## Wake trails, recorded only for fleets on or near the screen. Each point ages out after a few seconds; every ship in
## the column draws its own wake along the trail (see Marks._wake).
func _wakes(dt: float) -> void:
    var G: Dictionary = Campaign.G; var vs = get_viewport_rect().size; var seen := {}
    var step := clampf(2.5 / zoom, 0.04, 3.0)
    var rec = func(key, o: Dictionary):
        seen[key] = true
        var tr: Array = trails.get(key, [])
        if o.v > 0.8 and (tr.is_empty() or Campaign.mdist(tr[-1].x, tr[-1].y, o.x, o.y) > step):
            tr.append({"x": o.x, "y": o.y, "h": o.h, "t": 0.0, "s": minf(1.0, o.v / 16.0)})
        trails[key] = tr
    rec.call("player", G.player)
    var half: Vector2 = vs / 2 / zoom + Vector2(60, 60)
    for f in G.fleets:
        if absf(Campaign.wdx(cam.x, f.x)) < half.x and absf(f.y - cam.y) < half.y: rec.call(f.id, f)
    for key in trails.keys():
        if not seen.has(key): trails.erase(key); continue
        var tr: Array = trails[key]
        for q in tr: q.t += dt
        while not tr.is_empty() and tr[0].t > 4.0: tr.pop_front()

# ------------------------------------------------------------------ drawing
class SeaDrawer extends Node2D:   # open sea, graticule and pack ice
    var map
    func _draw() -> void:
        var z: float = map.zoom; var vs: Vector2 = map.get_viewport_rect().size; var cam: Vector2 = map.cam
        var hw = vs.x / 2 / z; var hh = vs.y / 2 / z
        draw_rect(Rect2(cam.x - hw, 0, hw * 2, Campaign.MH), Color("#183039"))
        var g0 = int(floor((cam.x - hw) / 200.0)) - 1; var g1 = int(ceil((cam.x + hw) / 200.0)) + 1
        for k in range(g0, g1 + 1): draw_line(Vector2(k * 200, 0), Vector2(k * 200, Campaign.MH), Color(0.5, 0.69, 0.86, 0.09), 1.0 / z)
        for lat in range(80, -71, -10): draw_line(Vector2(cam.x - hw, Campaign.lat_y(lat)), Vector2(cam.x + hw, Campaign.lat_y(lat)), Color(0.5, 0.69, 0.86, 0.09), 1.0 / z)
        var eq = Campaign.lat_y(0); var x = cam.x - hw
        while x < cam.x + hw: draw_line(Vector2(x, eq), Vector2(x + 10 / z, eq), Color(0.89, 0.7, 0.24, 0.18), 1.0 / z); x += 20 / z
        # seasonal pack ice: a broken edge that moves with the season, loose floes off it, white enough to read as ice
        var ie = Campaign.ice_edges(Campaign.G.day)
        var ice = Color(0.83, 0.88, 0.9, 0.42); var rim = Color(0.93, 0.96, 0.97, 0.75)
        var jag := func(x: float) -> float: return sin(x * 0.131) * 2.2 + sin(x * 0.047 + 1.3) * 4.5 + sin(x * 0.29 + 0.7) * 1.1
        var north = PackedVector2Array([Vector2(cam.x - hw - 40, -60)]); var south = PackedVector2Array([Vector2(cam.x - hw - 40, Campaign.MH + 60)])
        var en = PackedVector2Array(); var es = PackedVector2Array()
        var step: float = clampf(6.0 / z, 4.0, 20.0); var xx = cam.x - hw - 40
        while xx <= cam.x + hw + 40 + step:
            var yn: float = Campaign.lat_y(Campaign.ice_north_at(Campaign.x_lon(xx), ie)) + jag.call(xx)
            var ys: float = Campaign.lat_y(ie.y) - jag.call(xx + 977.0)
            north.append(Vector2(xx, yn)); en.append(Vector2(xx, yn)); south.append(Vector2(xx, ys)); es.append(Vector2(xx, ys)); xx += step
        north.append(Vector2(xx, -60)); south.append(Vector2(xx, Campaign.MH + 60))
        draw_colored_polygon(north, ice); draw_colored_polygon(south, ice)
        draw_polyline(en, rim, 1.5 / z); draw_polyline(es, rim, 1.5 / z)
        if z > 0.5:   # floes drifting off the edge
            var gx0 = int(floor((cam.x - hw) / 6.0)); var gx1 = int(ceil((cam.x + hw) / 6.0))
            for g in range(gx0, gx1 + 1):
                for side in [1.0, -1.0]:
                    var h1 = fposmod(sin(g * 12.9898 + side * 3.1) * 43758.5453, 1.0)
                    if h1 < 0.45: continue
                    var fx = g * 6.0 + h1 * 5.0
                    var base_y: float = Campaign.lat_y(Campaign.ice_north_at(Campaign.x_lon(fx), ie)) + jag.call(fx) if side > 0 else Campaign.lat_y(ie.y) - jag.call(fx + 977.0)
                    var fy = base_y + side * (1.5 + h1 * 9.0); var r = 0.5 + fposmod(h1 * 7.31, 1.0) * 1.6
                    # drawn round its own centre: a floe a map unit across, given in map coordinates in the thousands,
                    # is too fine for the triangulator's float precision and fails to fill
                    var pts = PackedVector2Array()
                    for k in 6: var a = k * TAU / 6 + h1 * 4.0; pts.append(Vector2.from_angle(a) * r * (0.7 + 0.5 * fposmod(h1 * (k + 3) * 5.7, 1.0)))
                    draw_set_transform(Vector2(fx, fy)); draw_colored_polygon(pts, Color(0.88, 0.92, 0.94, 0.55)); draw_set_transform(Vector2.ZERO)

class LandCopy extends Node2D:    # one copy of the world's land; three side by side make the chart wrap
    var map
    func _draw() -> void:
        var z: float = map.zoom
        for pl in map.coast_lines: draw_polyline(pl, Color("#7e6e4a"), maxf(1.0 / z, 0.4))
        for pl in map.chan_lines: draw_polyline(pl, Color("#183039"), maxf(2.5, 1.6 / z))

class Marks extends Node2D:       # ports, sites, wakes, routes and fleets
    var map
    ## A dashed ring at a force's strike reach, drawn only for missile ships and carriers (guns need contact).
    func _reach_ring(c: Vector2, r: float, col: Color) -> void:
        if r <= Campaign.CONTACT + 0.5: return
        var z: float = map.zoom; var n := 48
        for i in n: if i % 2 == 0: draw_arc(c, r, i * TAU / n, (i + 1) * TAU / n, 4, col, 1.2 / z)
    func _draw() -> void:
        var G: Dictionary = Campaign.G; var z: float = map.zoom; var P: Dictionary = G.player; var vs: Vector2 = map.get_viewport_rect().size
        var hw = vs.x / 2 / z; var b: float = map.boost()
        for p in G.pois:
            var x: float = map.rx(p.x)
            if absf(x - map.cam.x) > hw + 50 or absf(p.y - map.cam.y) > vs.y / 2 / z + 50: continue
            var ready: bool = G.day >= p.next; var s = 6.0 / z; var col = Color(0.89, 0.7, 0.24, 1.0 if ready else 0.35)
            draw_polyline(PackedVector2Array([Vector2(x, p.y - s), Vector2(x + s, p.y), Vector2(x, p.y + s), Vector2(x - s, p.y), Vector2(x, p.y - s)]), col, 1.5 / z)
            if p.type == "wreck": draw_line(Vector2(x - s * 0.5, p.y), Vector2(x + s * 0.5, p.y), col, 1.5 / z)
        _structures(hw, vs.y / 2 / z)
        for p in G.ports:
            var x: float = map.rx(p.x)
            if absf(x - map.cam.x) > hw + 80 or absf(p.y - map.cam.y) > vs.y / 2 / z + 80: continue
            var s = (7.0 if p.capital else 5.5) / z
            draw_line(Vector2(x, p.y), Vector2(map.rx(p.sx), p.sy), Color(0.89, 0.91, 0.89, 0.35), 1.0 / z)
            var col = Color(GameData.fac[p.fac].map)
            if p.capital: draw_rect(Rect2(x - s, p.y - s, s * 2, s * 2), Color("#ecebe2")); draw_rect(Rect2(x - s, p.y - s, s * 2, s * 2), col, false, 3.0 / z)
            else: draw_circle(Vector2(x, p.y), s, Color("#ecebe2")); draw_arc(Vector2(x, p.y), s, 0, TAU, 20, col, 3.0 / z)
        for m in Diplomacy.marks():   # active contracts: where to go
            var x: float = map.rx(m[0]); var rr: float = 11.0 / z
            draw_arc(Vector2(x, m[1]), rr, 0, TAU, 28, Color("#e3b23c"), 2.0 / z); draw_arc(Vector2(x, m[1]), rr * 1.5, 0, TAU, 28, Color(0.89, 0.7, 0.24, 0.35), 1.2 / z)
        # planned route
        if P.get("tx") != null and P.get("route") != null:
            var r: Array = P.route; var off: Vector2 = Vector2(P.x, P.y) - Vector2(P.rx, P.ry)
            var pts = PackedVector2Array([Vector2(P.x, P.y)])
            for i in range(P.ri + 1, r.size()): pts.append(r[i] + off)
            for i in pts.size() - 1: _dash(pts[i], pts[i + 1], Color(0.89, 0.91, 0.89, 0.6), 1.5 / z, 8 / z)
            for wi in P.get("wps", []):   # waypoints still ahead (Ctrl+Click)
                if int(wi) <= P.ri or int(wi) >= r.size(): continue
                var q: Vector2 = r[int(wi)] + off
                draw_circle(q, 5.5 / z, Color(0.05, 0.1, 0.12, 0.8)); draw_arc(q, 5.5 / z, 0, TAU, 20, Color(0.93, 0.94, 0.92, 0.9), 2.0 / z)
            draw_arc(pts[-1], 5 / z, 0, TAU, 16, Color(0.89, 0.91, 0.89, 0.6), 1.5 / z)
        # fleets (and their wakes), only those on screen
        var hh = vs.y / 2 / z
        for f in G.fleets:
            var x: float = map.rx(f.x)
            if absf(x - map.cam.x) > hw + 60 or absf(f.y - map.cam.y) > hh + 60: continue
            if z >= 0.32: _wakes_of(f.id, f.ships, Vector2(x, f.y), f.h)
            var col = Color("#e3b23c") if (f.get("mission", false) or int(f.get("contract", 0)) > 0) else Color(GameData.fac[f.fac].map); var hos = Campaign.hostile_fleet(f)
            if z < 0.32:
                draw_colored_polygon(PackedVector2Array([Vector2(x, f.y) + Vector2.from_angle(f.h) * 7 / z, Vector2(x, f.y) + Vector2.from_angle(f.h + 2.5) * 4 / z, Vector2(x, f.y) + Vector2.from_angle(f.h - 2.5) * 4 / z]), col)
                continue
            if f.get("chasing", false): draw_arc(Vector2(x, f.y), 160, 0, TAU, 64, Color(0.85, 0.38, 0.29, 0.28), 1.0 / z)
            if hos: _reach_ring(Vector2(x, f.y), Campaign.strike_reach(f.ships), Color(0.85, 0.38, 0.29, 0.35))
            if P.get("escort") == f.id: draw_arc(Vector2(x, f.y), 19 * b / z, 0, TAU, 32, Color(0.55, 0.8, 0.6, 0.8), 1.5 / z)
            if hos or f.get("mission", false) or P.follow == f.id: draw_arc(Vector2(x, f.y), 16 * b / z, 0, TAU, 32, Color(Color("#e3b23c") if P.follow == f.id else col, 0.7), 1.5 / z)
            _fleet(f.ships, f.fac, Vector2(x, f.y), f.h, f.id)
        if G.fleet.size() and z >= 0.32: _wakes_of("player", G.fleet, Vector2(P.x, P.y), P.h)
        var ring_r: float = 17 * b / z
        if G.fleet.size(): ring_r = minf(ring_r, maxf(14.0 / z, _layout(G.fleet)[0][3] * 0.75))   # close in, the ring hugs the ship
        draw_arc(Vector2(P.x, P.y), ring_r, 0, TAU, 32, Color("#e3b23c"), 2.0 / z)
        if z >= 0.32: _reach_ring(Vector2(P.x, P.y), Campaign.strike_reach(G.fleet), Color(0.89, 0.7, 0.24, 0.4))
        if G.fleet.size(): _fleet(G.fleet, "player", Vector2(P.x, P.y), P.h, "player")

    ## Land structures: map symbols at normal zoom, drawn installations close in, and the reach of batteries that
    ## would fire on you.
    func _structures(hw: float, hh: float) -> void:
        var z: float = map.zoom; var b: float = map.boost(); var close := z >= 3.0
        for s in Structures.all():
            var x: float = map.rx(s.x)
            if absf(x - map.cam.x) > hw + 60 or absf(s.y - map.cam.y) > hh + 60: continue
            var mine: bool = s.fac == "player"; var mil: bool = Structures.kind(s).military
            if not mine and z < (0.3 if mil else 0.45): continue
            var c := Vector2(x, s.y)
            if s.kind == "battery" and s.fac != "" and not mine and not Structures.silenced(s) and Campaign.at_war(s.fac):
                var rr := Structures.battery_units(); var n := 40
                for i in n: if i % 2 == 0: draw_arc(c, rr, i * TAU / n, (i + 1) * TAU / n, 3, Color(0.85, 0.38, 0.29, 0.4), 1.2 / z)
            if close:
                var R: float = map.struct_r(s); var face: float = map.face_of(s)
                var dc := c - Vector2.from_angle(face) * R * 0.45 if Structures.COASTAL.has(s.kind) else c   # coastal works: the sea front on the shore
                InstallationArt.draw(self, s.kind, dc, R, int(s.id), face, float(s.dmg), float(s.ruin), true, map.tnow)
                var fc: Color = Color("#e3b23c") if mine else (Color(0.6, 0.6, 0.55) if s.fac == "" else Color(GameData.fac[s.fac].map))
                var fp := dc + Vector2(0, -R * 0.95)   # a small flag on its staff
                draw_line(fp, fp + Vector2(0, -9.0 / z), Color(0.85, 0.85, 0.8), 1.0 / z)
                draw_colored_polygon(PackedVector2Array([fp + Vector2(0, -9.0 / z), fp + Vector2(7.0 / z, -7.0 / z), fp + Vector2(0, -5.0 / z)]), fc)
            else:
                var ring: Color = Color("#e3b23c") if mine else (Color(0.55, 0.55, 0.5) if s.fac == "" else Color(GameData.fac[s.fac].map))
                InstallationArt.icon(self, s.kind, c, (6.5 if mil else 5.5) / z, ring, 1.5 / z, Structures.silenced(s) and not mine)

    func _dash(a: Vector2, b: Vector2, c: Color, w: float, d: float) -> void:
        var len = a.distance_to(b); var n = int(len / (d * 2)) + 1
        for i in n:
            var t0 = i * 2 * d / len; var t1 = minf(1.0, (i * 2 + 1) * d / len)
            if t0 >= 1: break
            draw_line(a.lerp(b, t0), a.lerp(b, t1), c, w)

    ## Where each ship of a fleet sits: past 2x zoom every ship is drawn, steaming in a staggered column behind the
    ## largest; below that the fleet shows as its largest ship. Returns [ship, metres astern, metres abeam, length, scale].
    func _layout(ships: Array) -> Array:
        var z: float = map.zoom; var b: float = map.boost()
        var sorted = ships.duplicate(); sorted.sort_custom(func(a, c): return GameData.hulls[a.type].L > GameData.hulls[c.type].L)
        var n = sorted.size() if z >= 2 else 1; var back = 0.0; var out = []
        # Ships are drawn larger than life so they read on the chart. Close in, that would make a ship longer than
        # the circle it turns in, and it would seem to spin on the spot: keep the leader within 1.8 turning radii.
        var lead_L: float = GameData.hulls[sorted[0].type].L
        var cap := 1.0; var R_turn := 1.2 / Campaign.fleet_turn_rate(ships)
        var lead_len: float = (22 + lead_L * 0.07) * b / z
        if lead_len > R_turn * 1.8: cap = R_turn * 1.8 / lead_len
        for k in n:
            var s: Dictionary = sorted[k]; var L: float = GameData.hulls[s.type].L
            var sc = (22 + L * 0.07) * b / (L * z) * (0.9 if k else 1.0) * cap; var len = L * sc
            if k: back += len * 1.35
            out.append([s, back, ((1 if k % 2 else -1) * len * 0.35) if k else 0.0, len, sc])
        return out

    ## The fleet's track, newest first, starting from where it is now: [position, heading] pairs in screen-wrapped map units.
    func _track(key, p: Vector2, h: float) -> Array:
        var out = [[p, h]]
        var tr: Array = map.trails.get(key, [])
        for i in range(tr.size() - 1, -1, -1): out.append([Vector2(map.rx(tr[i].x), tr[i].y), tr[i].h])
        return out

    ## Where a ship this far astern of the leader is: walked back along the track the leader has steamed, so a column
    ## follows its leader through a channel or round a headland instead of being drawn across the land beside it.
    ## With no track yet, the ships close up astern of the leader. Returns [position, heading].
    func _astern(track: Array, back: float) -> Array:
        var run := 0.0
        for i in range(1, track.size()):
            var a: Vector2 = track[i - 1][0]; var b: Vector2 = track[i][0]; var seg := a.distance_to(b)
            if seg > 1e-4 and run + seg >= back:
                var k := (back - run) / seg; var hd: float = (a - b).angle()
                return [a.lerp(b, k), hd]
            run += seg
        # past the end of the track: carry on straight astern, unless that would put the ship ashore
        var last: Array = track[-1]; var rest: float = back - run; var hl: float = last[1]
        var q: Vector2 = last[0] - Vector2.from_angle(hl) * rest
        if Campaign.on_land(Campaign.wrap_x(q.x), q.y): q = last[0] - Vector2.from_angle(hl) * minf(rest, 0.3)
        return [q, hl]

    func _fleet(ships: Array, pal: String, p: Vector2, h: float, key = null) -> void:
        var track = _track(key, p, h)
        for e in _layout(ships):
            var s: Dictionary = e[0]
            var at: Array = [p, h] if e[1] == 0.0 else _astern(track, e[1])
            var info: Dictionary = GameData.sprites.ships[s.type]
            draw_set_transform(at[0], at[1], Vector2.ONE * e[4] / info.spr)
            for layer in ["base", "top"]:
                var t = GameData.ship_tex(s.type, pal, layer); draw_texture(t, -t.get_size() / 2)
        draw_set_transform(Vector2.ZERO)

    ## Wakes along the track, one per ship, each starting at that ship's stern: two arms spreading out and a churned
    ## band between them, fading with distance and age.
    func _wakes_of(key, ships: Array, p: Vector2, h: float) -> void:
        var tr: Array = map.trails.get(key, [])
        if tr.size() < 2: return
        var z: float = map.zoom
        var track = _track(key, p, h)
        var r_turn := 1.2 / Campaign.fleet_turn_rate(ships)   # the arms never spread wider than the turn, or they cross in a hard turn
        var dist := [0.0]; var age := [0.0]   # distance back along the track, and each point's age
        for i in range(1, track.size()):
            dist.append(dist[-1] + track[i - 1][0].distance_to(track[i][0])); age.append(tr[tr.size() - i].t)
        for e in _layout(ships):
            var len: float = e[3]; var start: float = e[1] + len * 0.48; var reach: float = len * 3.0
            # sample the track evenly from the stern back, so the arms open smoothly
            var pts = []
            var j := 0
            for n in 17:
                var dd: float = start + reach * n / 16.0
                if dd > dist[-1]: break
                while j < dist.size() - 1 and dist[j + 1] < dd: j += 1
                var at: Array = _astern(track, dd)
                pts.append([at[0], at[1], age[mini(j + 1, age.size() - 1)], dd - start])
            var arm_l = PackedVector2Array(); var arm_r = PackedVector2Array(); var mid = PackedVector2Array()
            var ca = PackedColorArray(); var cm = PackedColorArray()
            for q in pts:
                var k: float = minf(1.0, maxf(q[2] / 4.0, q[3] / reach))
                var d = Vector2.from_angle(q[1]); var nrm = Vector2(-d.y, d.x); var spread: float = minf(len * (0.05 + 0.6 * k), r_turn * 0.3)
                arm_l.append(q[0] + nrm * spread); arm_r.append(q[0] - nrm * spread); mid.append(q[0])
                ca.append(Color(0.9, 0.95, 0.95, 0.45 * (1.0 - k) * (1.0 - k))); cm.append(Color(0.85, 0.93, 0.93, 0.2 * (1.0 - k) * (1.0 - k)))
                if k >= 1.0: break
            if mid.size() < 2: continue
            draw_polyline_colors(mid, cm, maxf(len * 0.1, 1.5 / z))
            draw_polyline_colors(arm_l, ca, maxf(len * 0.012, 1.0 / z)); draw_polyline_colors(arm_r, ca, maxf(len * 0.012, 1.0 / z))

class Overlay extends Control:    # text on the chart, at fixed pixel sizes
    var map
    func _t(p: Vector2, s: String, col: Color, size := 13, align := HORIZONTAL_ALIGNMENT_CENTER, w := 300.0) -> void:
        var x = p.x - (w / 2 if align == HORIZONTAL_ALIGNMENT_CENTER else 0.0)
        draw_string(ThemeDB.fallback_font, Vector2(x, p.y), s, align, w, size, col)
    func _draw() -> void:
        var G: Dictionary = Campaign.G; var z: float = map.zoom; var vs = size; var P: Dictionary = G.player; var b: float = map.boost()
        # graticule labels
        var hw = vs.x / 2 / z; var g0 = int(floor((map.cam.x - hw) / 200.0)) - 1; var g1 = int(ceil((map.cam.x + hw) / 200.0)) + 1
        for k in range(g0, g1 + 1):
            if z < 0.3 and k % 2: continue
            var lon = int(round(Campaign.x_lon(k * 200))); var sx: float = (k * 200 - map.cam.x) * z + vs.x / 2
            _t(Vector2(sx + 4, 58), "%d°%s" % [absi(lon), "W" if lon < 0 else ("E" if lon > 0 else "")], Color(0.5, 0.69, 0.86, 0.5), 11, HORIZONTAL_ALIGNMENT_LEFT, 60)
        for lat in range(80, -71, -10):
            var sy: float = (Campaign.lat_y(lat) - map.cam.y) * z + vs.y / 2
            _t(Vector2(6, sy + 14), "%d°%s" % [absi(lat), "N" if lat > 0 else ("S" if lat < 0 else "")], Color(0.5, 0.69, 0.86, 0.5), 11, HORIZONTAL_ALIGNMENT_LEFT, 60)
        if z < 1.6:
            for th in Campaign.C.THEATERS:
                var sp: Vector2 = map.to_screen(Vector2(Campaign.lon_x(th[1]), Campaign.lat_y(th[2])))
                _t(sp, " ".join(th[0].split("")), Color(0.78, 0.88, 0.92, 0.24 if z < 0.35 else 0.16), 15 if z < 0.35 else 19, HORIZONTAL_ALIGNMENT_CENTER, 600)
        if z > 0.25 and z < 4.0:   # name the pack ice where its edge crosses the middle of the screen
            var ie2 = Campaign.ice_edges(G.day)
            var yn: float = (Campaign.lat_y(Campaign.ice_north_at(Campaign.x_lon(map.cam.x), ie2)) - map.cam.y) * z + vs.y / 2
            var ys: float = (Campaign.lat_y(ie2.y) - map.cam.y) * z + vs.y / 2
            if yn > 60 and yn < vs.y: _t(Vector2(vs.x / 2, yn - 10), "PACK ICE · " + Campaign.MONTHS[Campaign.date_of(G.day).month - 1].to_upper() + " LIMIT", Color(0.9, 0.94, 0.96, 0.7), 11)
            if ys > 60 and ys < vs.y: _t(Vector2(vs.x / 2, ys + 20), "PACK ICE · " + Campaign.MONTHS[Campaign.date_of(G.day).month - 1].to_upper() + " LIMIT", Color(0.9, 0.94, 0.96, 0.7), 11)
        if z > 0.45:   # the choke points by name
            for st in Campaign.C.get("STRAITS", []):
                var sp: Vector2 = map.to_screen(Vector2(st.x, st.y))
                if sp.x < -150 or sp.x > vs.x + 150: continue
                _t(sp + Vector2(0, -10), st.name.to_upper() if z < 2.0 else st.name, Color(0.62, 0.8, 0.88, 0.75), 11 if z < 2.0 else 13)
        for p in G.pois:
            if z <= 0.45: break
            var sp: Vector2 = map.to_screen(Vector2(p.x, p.y))
            if sp.x < -100 or sp.x > vs.x + 100: continue
            _t(sp + Vector2(0, 20), p.name, Color(0.89, 0.7, 0.24, 0.9 if G.day >= p.next else 0.4), 11)
        for s in Structures.all():   # structure names: yours always, others when zoomed in
            var mine: bool = s.fac == "player"
            if not (mine and z > 0.2) and z < 1.0: continue
            var sp: Vector2 = map.to_screen(Vector2(s.x, s.y))
            if sp.x < -150 or sp.x > vs.x + 150 or sp.y < -50 or sp.y > vs.y + 50: continue
            var off: float = map.struct_r(s) * z * 0.95 + 6.0 if z >= 3.0 else 14.0
            var col: Color = Color("#e3b23c") if mine else (Color(0.75, 0.75, 0.7, 0.85) if s.fac == "" else Color(GameData.fac[s.fac].map))
            var st: String = " · silenced" if Structures.silenced(s) and not mine else ""
            _t(sp + Vector2(0, off + 10), s.name, Color(0.92, 0.92, 0.88, 0.9), 11)
            if z >= 1.6: _t(sp + Vector2(0, off + 23), Structures.owner_name(s) + st, col, 10)
        for p in G.ports:
            if not (z > 0.28 or p.capital): continue
            var sp: Vector2 = map.to_screen(Vector2(p.x, p.y))
            if sp.x < -150 or sp.x > vs.x + 150: continue
            var s = 7.0 if p.capital else 5.5; var closed = Campaign.hostile(p.fac)
            _t(sp - Vector2(0, s + 5), p.name, Color("#eef0ec"), 15 if p.capital else 13)
            if z > 0.45: _t(sp + Vector2(0, s + 15), GameData.fac[p.fac].short + (" · capital" if p.capital else "") + (" · closed to you" if closed else ""), Color("#d9614a") if closed else Color(GameData.fac[p.fac].map), 11)
        for f in G.fleets:
            var hos = Campaign.hostile_fleet(f)
            if not (z >= 0.6 or hos or f.get("mission", false) or f.kind == "bounty"): continue
            var sp: Vector2 = map.to_screen(Vector2(f.x, f.y))
            if sp.x < -150 or sp.x > vs.x + 150 or z < 0.32: continue
            var col = Color("#e3b23c") if (f.get("mission", false) or int(f.get("contract", 0)) > 0) else Color(GameData.fac[f.fac].map)
            var txt: String = (f.captain + " · " + Campaign.fmt(f.reward)) if f.kind == "bounty" else (f.name + " (%d)" % f.ships.size())
            _t(sp + Vector2(0, 18 * b + 12), ("◎ " if P.follow == f.id else ("⚓ escorted · " if P.get("escort") == f.id else "")) + txt, col, 12)
        for m in Diplomacy.marks():
            var sp: Vector2 = map.to_screen(Vector2(m[0], m[1]))
            if sp.x > -150 and sp.x < vs.x + 150 and z > 0.2: _t(sp + Vector2(0, -16 - 11.0), "Contract: " + m[2], Color("#e3b23c"), 12)
        var psp: Vector2 = map.to_screen(Vector2(P.x, P.y))
        var lab_off: float = 21 * b
        if G.fleet.size(): lab_off = minf(lab_off, maxf(14.0, map.marks._layout(G.fleet)[0][3] * z * 0.75) + 4.0)
        _t(psp + Vector2(0, lab_off + 13), "Your task force · %d kn%s" % [int(round(P.v / 0.8)), " · escorting" if P.get("escort") != null else ""], Color("#e3b23c"), 12)
        if P.get("tx") != null and P.get("route") != null:
            var end: Vector2 = P.route[-1] + Vector2(P.x, P.y) - Vector2(P.rx, P.ry)
            var days: float = Campaign.route_remaining(P) / maxf(0.5, Campaign.player_speed()) * 0.1
            _t(map.to_screen(end) + Vector2(0, 20), "under a day" if days < 1 else "≈ %d days" % int(ceil(days)), Color(0.89, 0.91, 0.89, 0.75), 11)
        var mp: Vector2 = map.to_world(get_local_mouse_position())
        _t(Vector2(vs.x - 160, vs.y - 14), "%.1f°%s %.1f°%s" % [absf(Campaign.y_lat(mp.y)), "N" if Campaign.y_lat(mp.y) >= 0 else "S", absf(Campaign.x_lon(mp.x)), "E" if Campaign.x_lon(mp.x) >= 0 else "W"], Color(0.62, 0.67, 0.67), 12, HORIZONTAL_ALIGNMENT_RIGHT, 150)

# ------------------------------------------------------------------ top bar, toasts, dock
func _build_top() -> void:
    var bg = PanelContainer.new(); bg.set_anchors_preset(Control.PRESET_TOP_WIDE)
    var sb = StyleBoxFlat.new(); sb.bg_color = Color(UI.PANEL, 0.93); sb.border_color = UI.LINE; sb.border_width_bottom = 1
    sb.content_margin_left = 16; sb.content_margin_right = 12; sb.content_margin_top = 5; sb.content_margin_bottom = 5
    bg.add_theme_stylebox_override("panel", sb); ui.add_child(bg)
    top = HBoxContainer.new(); top.add_theme_constant_override("separation", 22); bg.add_child(top)
    # stats as two-line chips: a small condensed key over its value
    for k in ["DATE", "FUNDS", "FUEL", "CREW", "HOLD", "RESEARCH", "SERVING"]:
        var box = VBoxContainer.new(); box.add_theme_constant_override("separation", -3)
        var key := Label.new(); key.text = k; key.add_theme_font_override("font", UI.font("cond")); key.add_theme_font_size_override("font_size", 11); key.add_theme_color_override("font_color", Color(UI.DIM, 0.8))
        var v := Label.new(); v.add_theme_font_override("font", UI.font("semi")); v.add_theme_font_size_override("font_size", 15); v.add_theme_color_override("font_color", UI.INK)
        box.add_child(key); box.add_child(v); stats[k] = v; top.add_child(box)
        if k == "SERVING": box.mouse_filter = Control.MOUSE_FILTER_PASS
    var spacer = Control.new(); spacer.size_flags_horizontal = Control.SIZE_EXPAND_FILL; top.add_child(spacer)
    # time: a segmented control
    var seg := HBoxContainer.new(); seg.add_theme_constant_override("separation", 0); top.add_child(seg)
    for pair in [[0, "❚❚"], [1, "1×"], [2, "2×"], [4, "4×"], [8, "8×"]]:
        var v: int = pair[0]
        var b = UI.button(pair[1], func(): _speed(v)); b.custom_minimum_size.x = 40; b.focus_mode = Control.FOCUS_NONE
        b.add_theme_font_size_override("font_size", 14); seg.add_child(b); speed_btns.append([v, b])
    var cb := UI.button("Centre", func(): free_cam = false); cb.focus_mode = Control.FOCUS_NONE; top.add_child(cb)

func _speed(v: int) -> void:
    if v == 0: Campaign.paused = not Campaign.paused
    else: Campaign.map_speed = v; Campaign.paused = false

func _update_top() -> void:
    var G: Dictionary = Campaign.G
    stats.DATE.text = Campaign.date_str(G.day) + (" · TEST" if Campaign.test_mode() else ""); stats.FUNDS.text = Campaign.fmt(G.credits)
    var fu = Campaign.fuel_use()
    if G.cargo.fuel > 0 or fu <= 0: stats.FUEL.text = "%d (%s)" % [int(G.cargo.fuel), ("%dd" % int(G.cargo.fuel / Campaign.fuel_burn())) if fu > 0 else "∞"]
    elif Campaign.reserve() > 0: stats.FUEL.text = "Reserve %dd" % int(ceil(Campaign.reserve() / (fu / 3.0)))
    else: stats.FUEL.text = "Under tow" if G.player.get("towed") != null else "DEAD IN WATER"
    if int(G.crew) <= 0 and G.player.get("towed") == null: stats.FUEL.text = "NO CREW · ADRIFT"
    stats.FUEL.add_theme_color_override("font_color", UI.RED if fu > 0 and G.cargo.fuel / fu < 5 else UI.INK)
    stats.FUEL.get_parent().tooltip_text = "Fuel oil in the bunkers, and days of steaming left. Behind it, a reserve of %d tons (%d days at a crawl) that fills again whenever the bunkers have fuel." % [int(Campaign.reserve()), int(Campaign.reserve() / maxf(0.1, fu / 3.0))]
    stats.FUEL.get_parent().mouse_filter = Control.MOUSE_FILTER_PASS
    var cm = G.get("commission")
    if cm != null:
        stats.SERVING.text = GameData.fac[cm.fac].short + (" · marque" if str(cm.get("marque", "")) != "" else "")
        stats.SERVING.add_theme_color_override("font_color", Color(GameData.fac[cm.fac].map))
        stats.SERVING.tooltip_text = "You serve the %s (%s) since %s. Its wars are yours%s; sinking its enemies earns double standing. Resign at its capital." % [GameData.fac[cm.fac].name, Diplomacy.commission_title(cm.fac), Campaign.date_str(int(cm.since)), (", and you are a combatant to the " + GameData.fac[cm.marque].name) if str(cm.get("marque", "")) != "" else ""]
    else:
        stats.SERVING.text = "Independent"; stats.SERVING.add_theme_color_override("font_color", UI.DIM)
        stats.SERVING.tooltip_text = "You fly no flag but your own. Powers offer commissions and letters of marque at their capitals once your standing reaches 20."
    stats.SERVING.mouse_filter = Control.MOUSE_FILTER_PASS; stats.SERVING.get_parent().tooltip_text = stats.SERVING.tooltip_text
    stats.CREW.text = "%d/%d" % [G.crew, Campaign.crew_need()] + ((" · %s troops" % Campaign.fmt(Structures.troops())) if Structures.troops() > 0 else ""); stats.HOLD.text = "%d/%d" % [Campaign.cargo_used(), Campaign.cargo_cap()]; stats.RESEARCH.text = "%d RP" % G.rp
    for pair in speed_btns:
        var on: bool = (pair[0] == 0 and Campaign.paused) or (pair[0] == Campaign.map_speed and not Campaign.paused)
        pair[1].add_theme_color_override("font_color", UI.GOLD if on else UI.DIM)
        pair[1].add_theme_color_override("font_hover_color", UI.GOLD if on else UI.INK)

# ------------------------------------------------------------------ the orders box (top right)
## Your story orders and contracts at a glance: hover one for its full brief, click it to plot a course to its target.
var orders_box: PanelContainer
var orders_list: VBoxContainer
var orders_open := true
var _orders_sig := ""
var _orders_t := 0.0
func _build_orders() -> void:
    orders_box = PanelContainer.new(); ui.add_child(orders_box)
    var sb := StyleBoxFlat.new(); sb.bg_color = Color(UI.PANEL, 0.9); sb.border_color = UI.LINE; sb.set_border_width_all(1); sb.border_width_top = 2
    sb.content_margin_left = 10; sb.content_margin_right = 10; sb.content_margin_top = 6; sb.content_margin_bottom = 8; sb.set_corner_radius_all(3)
    orders_box.add_theme_stylebox_override("panel", sb)
    orders_box.set_anchor_and_offset(SIDE_RIGHT, 1, -14); orders_box.set_anchor_and_offset(SIDE_LEFT, 1, -330); orders_box.set_anchor_and_offset(SIDE_TOP, 0, 58)   # right first: Godot pushes the other anchor
    orders_list = VBoxContainer.new(); orders_list.add_theme_constant_override("separation", 4); orders_box.add_child(orders_list)
    _update_orders(true)

func _update_orders(force := false) -> void:
    var G: Dictionary = Campaign.G; var items := []
    if G.mission != null:
        var m: Dictionary = Campaign.mission_def(); var by: String = G.mission.get("by", "concord")
        items.append({"t": "★ " + m.title, "tip": "%s\n%s\nOrders from the %s. Target near %s. Reward %s, %d RP, %s standing +%d." % [m.title, m.brief, Campaign.story_office(by), m.near, Campaign.fmt(m.reward.credits), m.reward.rp, GameData.fac[by].short, m.reward.rep], "fleet": int(G.mission.fleet), "col": UI.GOLD})
    for c in G.get("contracts", []):
        items.append({"t": "%s · %dd" % [c.title, maxi(0, int(c.deadline) - G.day)], "tip": Diplomacy.contract_info(c), "c": c, "col": UI.INK if int(c.deadline) - G.day > 7 else UI.RED})
    for f in G.fleets:
        if Structures._is_assault(f) and f.get("warned", false):
            var st: Dictionary = Structures.all()[int(f.assault)]
            items.append({"t": "⚑ %s → %s" % [f.name, st.name], "tip": "A %s is sailing to retake the %s with %d troopships. Sink them before they land, or trust the garrison of %d." % [f.name.to_lower(), st.name, f.ships.filter(func(x): return x.get("troops", false)).size(), int(st.garrison)], "fleet": int(f.id), "col": UI.RED})
    var sig := str(orders_open) + "|" + "|".join(items.map(func(i): return i.t))
    orders_box.visible = not items.is_empty()
    if sig == _orders_sig and not force: return
    _orders_sig = sig
    for ch in orders_list.get_children(): ch.queue_free()
    var head := Button.new(); head.flat = true; head.alignment = HORIZONTAL_ALIGNMENT_LEFT
    head.text = ("▾ " if orders_open else "▸ ") + "ORDERS & CONTRACTS (%d)" % items.size(); head.add_theme_font_size_override("font_size", 14); head.add_theme_color_override("font_color", Color(UI.GOLD, 0.85))
    head.add_theme_font_override("font", UI.font("cond"))
    head.pressed.connect(func(): orders_open = not orders_open; _update_orders(true)); orders_list.add_child(head)
    if not orders_open: return
    for it in items:
        var b := Button.new(); b.flat = true; b.alignment = HORIZONTAL_ALIGNMENT_LEFT; b.text = it.t; b.tooltip_text = it.tip + "\n\nClick to set a course to the target."
        b.clip_text = true; b.custom_minimum_size.x = 296; b.add_theme_font_size_override("font_size", 13); b.add_theme_color_override("font_color", it.col)
        b.pressed.connect(func(): _course_to_order(it))
        orders_list.add_child(b)

func _course_to_order(it: Dictionary) -> void:
    var G: Dictionary = Campaign.G; var t = null
    if it.has("c"): t = Diplomacy.target_of(it.c)
    elif it.has("fleet"):
        for f in G.fleets: if int(f.id) == int(it.fleet): t = Vector2(f.x, f.y)
    if t == null: _toast("No fix on that target yet."); return
    var P: Dictionary = G.player; P.follow = null; P.escort = null; P.destPort = null
    if it.has("c") and (it.c.kind == "delivery" or it.c.kind == "smuggle"): P.destPort = int(it.c.dest)
    if Campaign.set_course(P, t.x, t.y): free_cam = false; _toast("Course set: " + it.t.split(" · ")[0] + ".")

func _build_toasts() -> void:
    toasts = VBoxContainer.new(); toasts.add_theme_constant_override("separation", 6); ui.add_child(toasts)
    toasts.set_anchor_and_offset(SIDE_LEFT, 0, 14); toasts.set_anchor_and_offset(SIDE_RIGHT, 0, 460); toasts.set_anchor_and_offset(SIDE_TOP, 1, -350); toasts.set_anchor_and_offset(SIDE_BOTTOM, 1, -66)   # above the Command tabs
    toasts.alignment = BoxContainer.ALIGNMENT_END; toasts.mouse_filter = Control.MOUSE_FILTER_IGNORE

func _toast(text: String) -> void:
    var pc = PanelContainer.new(); var sb = StyleBoxFlat.new(); sb.bg_color = Color(UI.PANEL, 0.94); sb.border_color = UI.GOLD; sb.border_width_left = 3
    sb.shadow_color = Color(0, 0, 0, 0.35); sb.shadow_size = 8; sb.corner_radius_top_right = 3; sb.corner_radius_bottom_right = 3
    sb.content_margin_left = 12; sb.content_margin_right = 12; sb.content_margin_top = 7; sb.content_margin_bottom = 7; pc.add_theme_stylebox_override("panel", sb)
    var l = UI.label(text, UI.INK, 14, true); l.custom_minimum_size.x = 420; pc.add_child(l); pc.mouse_filter = Control.MOUSE_FILTER_IGNORE; toasts.add_child(pc)
    while toasts.get_child_count() > 5: toasts.get_child(0).queue_free(); toasts.remove_child(toasts.get_child(0))
